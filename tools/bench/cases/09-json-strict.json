{
  "schema": 2,
  "id": "json-strict",
  "title": "结构化输出（JSON Schema 约束）",
  "kind": "structured",
  "max_tokens": 512,
  "temperature": 0,
  "note": "约束解码路径；与自由文本相比可观察 grammar 对逐 token 时间的影响。",
  "response_format": {
    "type": "json_schema",
    "json_schema": {
      "name": "incident_triage",
      "strict": true,
      "schema": {
        "type": "object",
        "properties": {
          "severity": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]},
          "component": {"type": "string"},
          "likely_cause": {"type": "string"},
          "next_action": {"type": "string"},
          "need_more_data": {"type": "boolean"}
        },
        "required": ["severity", "component", "likely_cause", "next_action", "need_more_data"],
        "additionalProperties": false
      }
    }
  },
  "messages": [
    {
      "role": "user",
      "content": "现象：某推理服务 P99 首 token 从 0.6 秒升到 4.2 秒，同时 GPU/NPU 利用率下降，请求排队数上升。请按给定 schema 输出分诊结论。"
    }
  ]
}
