new file mode 100644
--- /dev/null
+++ b/deepinfer/npu_ops/moe910b.py
@@ -0,0 +1,92 @@
+"""Native ModelSlim MoE consumer for the eager single-node 910B path."""
+from __future__ import annotations
+
+import torch
+import torch.distributed as dist
+from torch import nn
+
+from deepinfer.npu_ops.w8a8 import W8A8Expert, W8A8ExpertParallel, W8A8Linear
+
+
+class ModelSlimMoE(nn.Module):
+    def __init__(self, checkpoint, prefix, cfg, *, group, offload=True):
+        super().__init__()
+        moe = cfg.moe
+        if moe.scoring_func != "sqrtsoftplus" or moe.topk_method != "noaux_tc" or not moe.norm_topk_prob:
+            raise ValueError("910B MoE requires sqrtsoftplus/noaux_tc normalized routing")
+        if moe.get("n_redundant_experts", 0):
+            raise ValueError("910B eager MoE uses fixed contiguous ownership; EPLB replication is unsupported")
+        self.num_experts = moe.n_routed_experts
+        self.topk = moe.num_experts_per_tok
+        self.scaling = moe.routed_scaling_factor
+        device = torch.device("npu", torch.npu.current_device())
+        world, rank = dist.get_world_size(group), dist.get_rank(group)
+        if self.num_experts % world:
+            raise ValueError("Expert count must divide the EP group")
+        gate = checkpoint.tensor(prefix + ".gate.weight")
+        if gate.dtype != torch.bfloat16 or gate.shape != (self.num_experts, cfg.hidden_size):
+            raise ValueError("Expected the unquantized BF16 routing projection")
+        self.register_buffer("gate_weight", gate.to(device), persistent=False)
+        for suffix, name in [("bias", "bias"), ("bias_vl", "image_bias")]:
+            bias = checkpoint.tensor(prefix + ".gate." + suffix)
+            if bias.dtype not in (torch.bfloat16, torch.float32) or bias.shape != (self.num_experts,):
+                raise ValueError("Expected one BF16/FP32 routing bias per logical expert")
+            # ModelSlim preserves text bias as BF16 and image bias as FP32.
+            # Widening BF16 here is exact; neither bias is quantized.
+            self.register_buffer(name, bias.to(device=device, dtype=torch.float32), persistent=False)
+
+        def expert(path):
+            projections = []
+            for part in ["w1", "w2", "w3"]:
+                weight, scale = checkpoint.linear(path + "." + part)
+                linear = W8A8Linear(weight, scale, offload=offload)
+                if not offload:
+                    linear.materialize(device)
+                projections.append(linear)
+            return W8A8Expert(*projections, swiglu_limit=cfg.swiglu_limit)
+
+        local = self.num_experts // world
+        experts = {i: expert(f"{prefix}.experts.{i}") for i in range(rank * local, (rank + 1) * local)}
+        self.routed = W8A8ExpertParallel(experts, num_experts=self.num_experts, group=group)
+        if moe.n_shared_experts != 1:
+            raise ValueError("910B ModelSlim currently requires exactly one shared expert")
+        self.shared = expert(prefix + ".shared_experts")
+
+    @torch.inference_mode()
+    def gate_forward(self, hidden, metadata, out=None):
+        if hidden.dtype != torch.bfloat16 or hidden.ndim != 2:
+            raise ValueError("910B routing expects BF16 [tokens,hidden] activations")
+        for name in ("gate_force_random", "gate_force_random_cp"):
+            mask = getattr(metadata, name, None)
+            enabled = bool(mask.any()) if isinstance(mask, torch.Tensor) else bool(mask)
+            if enabled:
+                raise ValueError("Synthetic random routing is unsupported in this correctness path")
+        # Keep the routing result FP32, including the BF16 input/weight products.
+        logits = torch.nn.functional.linear(hidden.float(), self.gate_weight.float())
+        scores = torch.nn.functional.softplus(logits).sqrt()
+        image_mask = getattr(metadata, "images_seq_mask", None)
+        bias = self.bias if image_mask is None else torch.where(image_mask.reshape(-1, 1), self.image_bias, self.bias)
+        indices = torch.topk(scores + bias, self.topk, dim=-1, sorted=False).indices
+        weights = scores.gather(-1, indices)
+        weights = weights / (weights.sum(-1, keepdim=True) + 1e-20) * self.scaling
+        valid = getattr(metadata, "valid_token_mask", None)
+        if valid is not None:
+            weights = weights.masked_fill(~valid.reshape(-1, 1), 0)
+        if out is not None:
+            out[0].copy_(indices); out[1].copy_(weights)
+            return out
+        return indices, weights
+
+    @torch.inference_mode()
+    def forward(self, hidden, hidden_bf16, metadata):
+        if not isinstance(hidden, torch.Tensor) or hidden.dtype != torch.bfloat16:
+            raise ValueError("910B W8A8 MoE expects BF16 activations before dynamic quantization")
+        if hidden.shape != hidden_bf16.shape or hidden.device != hidden_bf16.device:
+            raise ValueError("Normalized and routing inputs must have matching shapes/devices")
+        indices, weights = self.gate_forward(hidden_bf16, metadata)
+        routed = self.routed(hidden, indices, weights)
+        shared = self.shared(hidden)
+        valid = getattr(metadata, "valid_token_mask", None)
+        if valid is not None:
+            shared = shared.masked_fill(~valid.reshape(-1, 1), 0)
+        return routed + shared
