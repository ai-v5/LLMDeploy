+        raise IndexError("Cache slot outside its physical allocation")
+    if not slots.numel():
+        return
+    load_ops()
+    coordinates = torch.stack((slots.long() // block_size, slots.long() % block_size), dim=-1)
+    coordinates.masked_fill_((slots < 0).unsqueeze(-1), -1)
+    # The custom op consumes explicit strides and skips [-1,-1] padding.
+    torch.ops._C_ascend.npu_scatter_nd_update_sk(cache.squeeze(-2), coordinates, kv.contiguous())
+
+
+def load(cache, segments, output):
+    # Scalar narrow/copy preserves a physical page's address, including a
+    # nonzero storage offset and strides beyond 32-bit byte offsets.
+    for block, begin, end, destination in segments.cpu().tolist():
+        length = end - begin
+        if not 0 <= begin <= end <= cache.shape[1] or not 0 <= destination <= destination + length <= output.shape[0]:
+            raise IndexError("Invalid compact cache-load segment")
+        target = output[destination:destination + length]
+        if block == -1:
+            target.zero_()
+        elif 0 <= block < cache.shape[0]:
+            target.copy_(cache[block, begin:end, 0, :])
+        else:
+            raise IndexError("Cache-load page outside its physical allocation")
+    return output
