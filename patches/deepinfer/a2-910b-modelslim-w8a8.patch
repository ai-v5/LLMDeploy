--- /dev/null
+++ b/deepinfer/npu_ops/transform910b.py
@@ -0,0 +1,19 @@
+"""BF16 row transforms used by the native 910B attention path."""
+import torch
+
+
+def rotary_inplace(x, positions, cos_sin_cache, is_neox, conjugate=False):
+    width=x.shape[-1]
+    if positions.shape != (x.shape[0],) or width % 2 or cos_sin_cache.shape[1] != width:
+        raise ValueError("RoPE dimensions/positions do not match the rotary slice")
+    cache=cos_sin_cache.index_select(0,positions.long())
+    shape=(x.shape[0],)+(1,)*(x.ndim-2)+(width//2,)
+    cos,sin=[part.reshape(shape) for part in cache.chunk(2,-1)]
+    if conjugate:sin=-sin
+    xf=x.float()
+    first,second=xf.chunk(2,-1) if is_neox else (xf[...,0::2],xf[...,1::2])
+    real=first*cos-second*sin
+    imag=second*cos+first*sin
+    result=torch.cat((real,imag),-1) if is_neox else torch.stack((real,imag),-1).flatten(-2)
+    x.copy_(result.to(x.dtype))
+    return x
diff --git a/deepinfer/npu_ops/w8a8.py b/deepinfer/npu_ops/w8a8.py
new file mode 100644
--- /dev/null
+++ b/deepinfer/npu_ops/w8a8.py
@@ -0,0 +1,146 @@
+"""910B W8A8 projections with explicit host or device weight residency.
+
+Uses the same dynamic per-token INT8 / per-output-channel scale contract as
+vLLM Ascend W8A8_DYNAMIC. No FP8 reinterpretation or checkpoint requantization.
+This eager path is not compatible with graph capture while weights are offloaded.
+"""
+from __future__ import annotations
+
+import torch
+from torch import nn
+
+
+class W8A8Linear(nn.Module):
+    def __init__(self, weight: torch.Tensor, scale: torch.Tensor, *, offload: bool) -> None:
+        super().__init__()
+        if weight.dtype != torch.int8 or weight.ndim != 2:
+            raise ValueError("W8A8Linear needs INT8 [out, in] weights")
+        if scale.ndim != 1 or scale.numel() != weight.shape[0]:
+            raise ValueError("W8A8Linear needs one scale per output channel")
+        if weight.device.type != "cpu" or scale.device.type != "cpu":
+            raise ValueError("Construct from CPU checkpoint tensors")
+        self.in_features = weight.shape[1]
+        self.out_features = weight.shape[0]
+        self.offload = offload
+        # Transpose once on the host. Offload transfers this INT8 tensor only.
+        self.register_buffer("weight", weight.t().contiguous(), persistent=False)
+        self.register_buffer("scale", scale.float().contiguous(), persistent=False)
+        self._resident: tuple[torch.Tensor, torch.Tensor] | None = None
+
+    def materialize(self, device: torch.device) -> None:
+        if self.offload:
+            raise ValueError("An offloaded projection must retain CPU weight storage")
+        self.weight = self.weight.to(device)
+        self.scale = self.scale.to(device)
+        self._resident = (self.weight, self.scale)
+
+    @torch.inference_mode()
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        import torch_npu
+
+        if x.device.type != "npu" or x.dtype != torch.bfloat16 or x.shape[-1] != self.in_features:
+            raise ValueError("Expected BF16 NPU activations with the projection input width")
+        if x.numel() == 0:
+            return x.new_empty((*x.shape[:-1], self.out_features))
+        if self._resident is not None:
+            weight, scale = self._resident
+            if weight.device != x.device:
+                raise ValueError("A resident projection cannot change NPU devices")
+        else:
+            if self.offload:
+                weight = self.weight.to(x.device)
+                scale = self.scale.to(x.device)
+            else:
+                self.materialize(x.device)
+                weight, scale = self._resident
+        codes, token_scale = torch_npu.npu_dynamic_quant(x.reshape(-1, self.in_features), dst_type=torch.int8)
+        output = torch_npu.npu_quant_matmul(codes, weight, scale, pertoken_scale=token_scale,
+                                          output_dtype=torch.bfloat16)
+        return output.reshape(*x.shape[:-1], self.out_features)
+
+
+class W8A8Expert(nn.Module):
+    def __init__(self, w1: W8A8Linear, w2: W8A8Linear, w3: W8A8Linear, *, swiglu_limit: float) -> None:
+        super().__init__()
+        if (w1.in_features, w1.out_features) != (w3.in_features, w3.out_features):
+            raise ValueError("Gate/up projection shape mismatch")
+        if (w2.in_features, w2.out_features) != (w1.out_features, w1.in_features):
+            raise ValueError("Down projection shape mismatch")
+        self.w1, self.w2, self.w3 = w1, w2, w3
+        self.swiglu_limit = swiglu_limit
+
+    @torch.inference_mode()
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        import torch_npu
+
+        gate = self.w1(x).clamp(max=self.swiglu_limit)
+        up = self.w3(x).clamp(min=-self.swiglu_limit, max=self.swiglu_limit)
+        hidden = torch_npu.npu_swiglu(torch.cat((gate, up), dim=-1))
+        return self.w2(hidden)
+
+
+class W8A8ExpertParallel(nn.Module):
+    """Eager HCCL dispatch/combine for the single-node 910B path.
+
+    Each rank owns a disjoint contiguous expert range. Activations and routing
+    metadata are gathered; only the owner computes an expert, then results are
+    reduced and sliced back to the requesting rank. Weights are never gathered.
+    Shared experts and the routing gate remain the caller's responsibility.
+    """
+    def __init__(self, experts: dict[int, W8A8Expert], *, num_experts: int, group=None) -> None:
+        super().__init__()
+        import torch.distributed as dist
+
+        self.group = group
+        self.world = dist.get_world_size(group)
+        self.rank = dist.get_rank(group)
+        if num_experts <= 0 or num_experts % self.world:
+            raise ValueError("Expert count must divide the EP group")
+        local = num_experts // self.world
+        if set(experts) != set(range(self.rank * local, (self.rank + 1) * local)):
+            raise ValueError("Expert ownership must exactly cover this rank's contiguous range")
+        self.num_experts = num_experts
+        self.experts = nn.ModuleDict({str(key): value for key, value in experts.items()})
+
+    @torch.inference_mode()
+    def forward(self, x: torch.Tensor, indices: torch.Tensor, scores: torch.Tensor) -> torch.Tensor:
+        import torch.distributed as dist
+
+        if x.ndim != 2 or indices.ndim != 2 or indices.shape != scores.shape or x.shape[0] != indices.shape[0]:
+            raise ValueError("Expected [tokens, hidden] and matching [tokens, topk] routing tensors")
+        local_valid = (indices.dtype == torch.int64 and x.dtype == torch.bfloat16
+                       and indices.device == x.device == scores.device
+                       and bool(torch.isfinite(scores).all())
+                       and bool(((indices >= 0) & (indices < self.num_experts)).all()))
+        valid = torch.tensor([int(local_valid)], device=x.device, dtype=torch.int32)
+        dist.all_reduce(valid, op=dist.ReduceOp.MIN, group=self.group)
+        if not valid.item():
+            raise ValueError("Invalid expert indices, scores, dtypes or devices on an EP rank")
+        count = torch.tensor([x.shape[0]], device=x.device, dtype=torch.int32)
+        counts = [torch.empty_like(count) for _ in range(self.world)]
+        dist.all_gather(counts, count, group=self.group)
+        counts_cpu = [int(value.item()) for value in counts]
+        padded = max(counts_cpu)
+        if padded == 0:
+            return x.clone()
+
+        def gather(value, fill):
+            buffer = value.new_full((padded, *value.shape[1:]), fill)
+            buffer[:value.shape[0]].copy_(value)
+            buffers = [torch.empty_like(buffer) for _ in range(self.world)]
+            dist.all_gather(buffers, buffer, group=self.group)
+            return torch.cat(buffers)
+
+        all_x = gather(x, 0)
+        all_indices = gather(indices, -1)
+        all_scores = gather(scores.float(), 0)
+        output = torch.zeros_like(all_x, dtype=torch.float32)
+        for name, expert in self.experts.items():
+            token_rows, choices = torch.where(all_indices == int(name))
+            if token_rows.numel():
+                value = expert(all_x.index_select(0, token_rows)).float()
+                value.mul_(all_scores[token_rows, choices].unsqueeze(1))
+                output.index_add_(0, token_rows, value)
