@@ -0,0 +1,63 @@
+"""Eager C1/C2 compression with native strided ring-state ownership."""
+import torch
+
+
+def _compress(scores, latents):
+    return (latents*torch.softmax(scores,dim=1)).sum(1).bfloat16()
+
+
+@torch.inference_mode()
+def prefill(score,latent,state,slots,mapping,cu_q,cu_k,cu_c,ratio,mirror=None):
+    qs=cu_q.cpu().tolist();ks=cu_k.cpu().tolist();cs=cu_c.cpu().tolist()
+    slot_ids=slots.cpu().tolist();ring=state.shape[1];dim=score.shape[1]
+    out=torch.zeros((mapping.numel(),dim),dtype=torch.bfloat16,device=score.device)
+    for seq,slot in enumerate(slot_ids):
+        start,end=qs[seq:seq+2];length=end-start
+        if not length:continue
+        if not 0<=slot<state.shape[0]:raise ValueError('Invalid compressor state slot')
+        klen=ks[seq+1]-ks[seq];qstart=klen-length
+        count=klen//ratio-qstart//ratio
+        if count:
+            positions=torch.arange(qstart//ratio*ratio,klen//ratio*ratio,device=score.device,dtype=torch.int64)
+            incoming=(positions-qstart+start).clamp(start,end-1)
+            if mirror is not None:incoming=mirror.index_select(0,incoming).long()
+            old=(positions<qstart).unsqueeze(-1)
+            ring_indices=positions%ring
+            scores=torch.where(old,state[slot,:,0].index_select(0,ring_indices),score.index_select(0,incoming))
+            latents=torch.where(old,state[slot,:,1].index_select(0,ring_indices),latent.index_select(0,incoming))
+            out[cs[seq]:cs[seq]+count].copy_(_compress(scores.reshape(count,ratio,dim),latents.reshape(count,ratio,dim)))
+        recent=torch.arange(max(start,end-ring),end,device=score.device,dtype=torch.int64)
+        ring_indices=(recent-start+qstart)%ring
+        incoming=recent if mirror is None else mirror.index_select(0,recent).long()
+        state[slot,:,0].index_copy_(0,ring_indices,score.index_select(0,incoming))
+        state[slot,:,1].index_copy_(0,ring_indices,latent.index_select(0,incoming))
+    return out
+
+
+@torch.inference_mode()
+def decode(score,latent,state,slots,context_lens,max_seqlen_q,ratio):
+    ring=state.shape[1];dim=score.shape[1]
+    groups={}
+    for row,(slot,length) in enumerate(zip(slots.cpu().tolist(),context_lens.cpu().tolist())):
+        if not 0<=slot<state.shape[0] or length<1:raise ValueError('Invalid compressor decode state/position')
+        groups.setdefault(slot,[]).append((row,length-1))
+    out=torch.zeros((score.shape[0],dim),dtype=torch.bfloat16,device=score.device)
+    for slot,rows in groups.items():
+        if len(rows)>max_seqlen_q or len({pos%ring for _,pos in rows})!=len(rows):
+            raise ValueError('Decode batch overwrites its own compressor ring state')
+        incoming=torch.tensor([row for row,_ in rows],device=score.device,dtype=torch.int64)
+        ring_indices=torch.tensor([pos%ring for _,pos in rows],device=score.device,dtype=torch.int64)
+        state[slot,:,0].index_copy_(0,ring_indices,score.index_select(0,incoming))
+        state[slot,:,1].index_copy_(0,ring_indices,latent.index_select(0,incoming))
+    # All draft-token writes must finish before any window reads. The ring
+    # capacity contract retains the previous token plus the whole draft batch.
+    for slot,rows in groups.items():
+        completed=[(row,pos) for row,pos in rows if pos%ratio==ratio-1]
+        if not completed:continue
+        positions=torch.tensor([[pos-ratio+1+j for j in range(ratio)] for _,pos in completed],device=score.device,dtype=torch.int64)
+        ring_indices=(positions%ring).flatten()
+        scores=state[slot,:,0].index_select(0,ring_indices).reshape(-1,ratio,dim)
+        latents=state[slot,:,1].index_select(0,ring_indices).reshape(-1,ratio,dim)
+        destination=torch.tensor([row for row,_ in completed],device=score.device,dtype=torch.int64)
+        out.index_copy_(0,destination,_compress(scores,latents))
+    return out
