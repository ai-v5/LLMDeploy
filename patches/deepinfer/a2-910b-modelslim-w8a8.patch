--- /dev/null
+++ b/deepinfer/npu_ops/engram910b.py
@@ -0,0 +1,123 @@
+# SPDX-License-Identifier: Apache-2.0
+# Gating formula derived from vllm-project/vllm-ascend,
+# vllm_ascend/models/deepseek_v41/engram/common.py at
+# 5f828ad638ee4f9b12db87f9d5481f29076d37f9.
+# Copyright contributors to the vLLM project.
+"""Host INT8 Engram decoding and the rotated ModelSlim gating contract."""
+from pathlib import Path
+
+import torch
+from safetensors import safe_open
+
+
+def hash_ngrams(token_ids,multipliers,vocab_sizes,offsets,image_token_mask=None):
+    """Use the upstream signed-int64 hash formula on the host table owner.
+
+    Return CPU indices directly to ModelSlimEngram; eager host lookup does not
+    need a round trip through device hash storage or an A5 TileLang kernel.
+    """
+    from tile_kernels.torch.engram import engram_hash_ref
+    return engram_hash_ref(token_ids.cpu(),multipliers.cpu(),vocab_sizes.cpu(),offsets.cpu(),
+                           None if image_token_mask is None else image_token_mask.cpu())
+
+
+def decode_int8_rows(codes: torch.Tensor, scales: torch.Tensor) -> torch.Tensor:
+    if codes.device.type != "cpu" or scales.device.type != "cpu":
+        raise ValueError("Engram table decoding must retain host residency")
+    if codes.dtype != torch.int8 or codes.ndim != 2 or codes.shape[1] % 32:
+        raise ValueError("Expected row-major INT8 Engram rows with group size 32")
+    if scales.shape != (codes.shape[0], codes.shape[1] // 32):
+        raise ValueError("Engram group-scale shape mismatch")
+    if scales.dtype != torch.float8_e8m0fnu:
+        raise ValueError("The checkpoint declares F8_E8M0 Engram scales")
+    bits = scales.view(torch.uint8)
+    if (bits == 255).any():
+        raise ValueError("NaN Engram scale in checkpoint")
+    scale = torch.ldexp(torch.ones_like(bits, dtype=torch.float32), bits.int() - 127)
+    return (codes.float().unflatten(-1, (-1, 32)) * scale.unsqueeze(-1)).flatten(-2).bfloat16()
+
+
+def load_rotation(root: str | Path, hidden_size: int, rotation_config: dict) -> torch.Tensor | None:
+    if not rotation_config:
+        return None
+    expected = {"value_projection_rotated": True, "value_basis": "quarot_global",
+                "key_and_gate_basis": "original", "runtime_delta_rotation": False}
+    if rotation_config != expected:
+        raise ValueError("Unsupported Engram rotation contract")
+    path = Path(root) / 'optional/quarot.safetensors'
+    # A missing declared rotation is incomplete input, never the identity basis.
+    with safe_open(path, framework='pt', device='cpu') as checkpoint:
+        rotation = checkpoint.get_tensor('global_rotation')
+    if hidden_size % 32 or rotation.shape != (hidden_size, hidden_size):
+        raise ValueError("Engram global rotation shape mismatch")
+    block = rotation[:32, :32].contiguous()
+    if not torch.equal(rotation, torch.block_diag(*[block] * (hidden_size // 32))):
+        raise ValueError("Engram gate requires repeated block32 global rotation")
+    return block
+
+
+def engram_gate(hidden, key, value, channel_weight, rotation_block, token_mask, eps):
+    """Original-basis gate; value projection already carries forward rotation."""
+    dim = hidden.shape[-1]
+    original = hidden.float()
+    if rotation_block is not None:
+        original = (original.unflatten(-1, (-1, rotation_block.shape[0])) @ rotation_block.float().T).flatten(-2)
+    key = key.float()
+    rstd = torch.rsqrt(original.square().mean(-1) + eps)
+    rstd *= torch.rsqrt(key.square().mean(-1) + eps)
+    dot = (original * channel_weight.float() * key).sum(-1) * rstd * dim**-0.5
+    magnitude = dot.abs().clamp_min(1e-6).sqrt()
+    gate = torch.sigmoid(torch.where(torch.signbit(dot), -magnitude, magnitude))
+    gate = gate.masked_fill(~token_mask.unsqueeze(-1), 0)
+    return (hidden.float() + gate.unsqueeze(-1) * value.float().unsqueeze(-2)).to(hidden.dtype)
+
+
+class ModelSlimEngram(torch.nn.Module):
+    """Keep tables on disk and fetch only the rows of one native Engram layer."""
+    def __init__(self, checkpoint, prefix, cfg):
+        super().__init__()
+        from deepinfer.model_executor.layers.linear import ReplicatedLinear
+
+        self.checkpoint=checkpoint
+        self.prefix=prefix
+        self.hidden_size=cfg.hidden_size
+        self.hc_mult=cfg.hc_mult
+        self.eps=cfg.rms_norm_eps
+        device=torch.device('npu',torch.npu.current_device())
+        table=checkpoint.headers[prefix+'.embed.weight']
+        scales=checkpoint.headers[prefix+'.embed.scale']
+        self.rows,self.head_dim=table['shape']
+        if table['dtype']!='I8' or self.head_dim!=256 or scales['shape']!=[self.rows,self.head_dim//32]:
+            raise ValueError('Expected ModelSlim INT8/group32 Engram table')
+        self.entries=sum(cfg.engram.n_embed_per_ngram)//self.head_dim
+        weight=checkpoint.tensor(prefix+'.wkv.weight')
+        if weight.dtype!=torch.bfloat16 or weight.shape!=(self.hidden_size*(self.hc_mult+1),self.entries*self.head_dim):
+            raise ValueError('Expected published BF16 postprocessed Engram projection')
+        self.projection=ReplicatedLinear(weight.shape[1],weight.shape[0],weight=torch.nn.Parameter(weight.to(device),requires_grad=False))
+        channel=checkpoint.tensor(prefix+'.q_weight').float()*checkpoint.tensor(prefix+'.k_weight').float()
+        if channel.shape!=(self.hc_mult,self.hidden_size):
+            raise ValueError('Engram gate channel shape mismatch')
+        self.register_buffer('channel',channel.to(device),persistent=False)
+        rotation=load_rotation(checkpoint.root,self.hidden_size,cfg.engram.rotation_config)
+        self.register_buffer('rotation',None if rotation is None else rotation.to(device),persistent=False)
+
+    @torch.inference_mode()
+    def fetch(self, hashes):
+        if hashes.ndim!=2 or hashes.shape[1]!=self.entries or hashes.dtype not in (torch.int32,torch.int64):
+            raise ValueError('Expected [tokens,table_heads] integer Engram hashes')
+        indices=hashes.to(device='cpu',dtype=torch.int64).reshape(-1)
+        if bool(((indices < -1)|(indices >= self.rows)).any()):
+            raise IndexError('Engram hash outside the checkpoint table')
+        codes=self.checkpoint.rows(self.prefix+'.embed.weight',indices.clamp_min(0))
+        scales=self.checkpoint.rows(self.prefix+'.embed.scale',indices.clamp_min(0))
+        values=decode_int8_rows(codes,scales)
+        values.masked_fill_((indices<0).unsqueeze(-1),0)
+        return values.reshape(hashes.shape[0],self.entries*self.head_dim).to(self.channel.device)
+
+    @torch.inference_mode()
+    def forward(self, hidden, embedding, image_mask=None):
+        if hidden.dtype!=torch.bfloat16 or hidden.shape!=(embedding.shape[0],self.hc_mult,self.hidden_size):
+            raise ValueError('Engram hidden-state shape/dtype mismatch')
+        kv=self.projection(embedding).unflatten(-1,(self.hc_mult+1,self.hidden_size))
+        mask=torch.ones(hidden.shape[0],dtype=torch.bool,device=hidden.device) if image_mask is None else ~image_mask
+        return engram_gate(hidden,kv[:,:self.hc_mult],kv[:,self.hc_mult],self.channel,self.rotation,mask,self.eps)
