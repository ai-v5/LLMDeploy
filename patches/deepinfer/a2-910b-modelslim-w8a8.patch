diff --git a/deepinfer/hugging_face/modelslim_loading.py b/deepinfer/hugging_face/modelslim_loading.py
new file mode 100644
--- /dev/null
+++ b/deepinfer/hugging_face/modelslim_loading.py
@@ -0,0 +1,153 @@
+"""Plan native parameter ownership from the published ModelSlim index."""
+from dataclasses import dataclass
+
+import torch
+
+from deepinfer.hugging_face.names import hf_to_model
+from deepinfer.hugging_face.parameters import model_params
+from deepinfer.model_executor.models.v4_modules.moe import FusedExperts
+from deepinfer.model_executor.models.v4_modules.engram_parameters import EngramEmbedding
+
+
+@dataclass
+class ModelSlimLoadPlan:
+    tensors: dict[str,tuple[str,...]]
+    aliases: dict[str,str]
+    moe_modules: dict[str,str]
+    engram_modules: dict[str,str]
+
+
+def plan_parameters(model, checkpoint, cfg):
+    checkpoint.require_complete_coverage()
+    n_layer=cfg.gpt.num_hidden_layers
+    params=model_params(model)
+    moes={};engrams={}
+    for name,module in model.named_modules():
+        if not isinstance(module,(FusedExperts,EngramEmbedding)):
+            continue
+        number=int(name.split('.')[2])
+        prefix=f'layers.{number-1}' if number<=n_layer else f'mtp.{number-n_layer-2}'
+        if isinstance(module,FusedExperts):moes[name]=prefix+'.ffn'
+        else:engrams[name]=prefix+'.engram'
+    owned=tuple(name+'.' for name in [*moes,*engrams])
+    sources={}
+    for name in checkpoint.tensors:
+        if name.endswith(('.weight_scale','.weight_offset','.scale')):
+            continue
+        parts=name.removeprefix('model.').split('.',2)
+        draft_suffix={'embed.weight':'emb.tok_emb.weight','head.weight':'shared_head.head.weight'}
+        if len(parts)==3 and parts[0]=='mtp' and parts[1].isdigit() and parts[2] in draft_suffix:
+            target=f'module.module.{n_layer+2+int(parts[1])}.{draft_suffix[parts[2]]}'
+        else:
+            target=hf_to_model(name,n_layer=n_layer)
+        if target not in params or target.startswith(owned):
+            continue
+        sources.setdefault(target,[]).append(name)
+    aliases={}
+    for target in params:
+        parts=target.split('.',3)
+        if len(parts)!=4 or not parts[2].isdigit() or int(parts[2])<=n_layer+1:
+            continue
+        suffix=parts[3]
+        source={'emb.tok_emb.weight':'module.module.0.emb.tok_emb.weight',
+                'shared_head.head.weight':f'module.module.{n_layer+1}.shared_head.head.weight'}.get(suffix)
+        if target not in sources and source is not None and source in sources:
+            aliases[target]=source
+    missing=sorted(name for name in params if name not in sources and name not in aliases and not name.startswith(owned))
+    if missing:
+        raise ValueError(f'ModelSlim checkpoint misses {len(missing)} native parameter targets: {missing[:12]}')
+    for target,names in sources.items():
+        names.sort()  # w1 precedes w3 in a native fused gate/up projection.
+        headers=[checkpoint.headers[name] for name in names]
+        shape=tuple(headers[0]['shape'])
+        if len(names)>1:
+            if any(tuple(header['shape'][1:])!=shape[1:] for header in headers):
+                raise ValueError(f'Incompatible ModelSlim fused projection: {target}')
+            shape=(sum(header['shape'][0] for header in headers),*shape[1:])
+        if shape!=tuple(params[target].shape):
+            raise ValueError(f'ModelSlim {target}: checkpoint {shape} != native {tuple(params[target].shape)}')
+        if any(header['dtype']=='I8' for header in headers) and any(checkpoint.description.get(name)!='W8A8_DYNAMIC' for name in names):
+            raise ValueError(f'Undeclared INT8 parameter: {target}')
+    return ModelSlimLoadPlan({key:tuple(value) for key,value in sources.items()},aliases,moes,engrams)
+
+
+def materialize_ordinary_parameters(model, checkpoint, plan, *, device):
+    """Load ordinary targets; routed experts and host Engram keep separate owners.
+
+    INT8 projections stay as CPU codes until native ReplicatedLinear takes
+    ownership and transposes/materializes them. No FP8 conversion is involved.
+    """
+    targets=model_params(model)
+    loaded={}
+    for name,names in plan.tensors.items():
+        original=targets[name]
+        quantized=[checkpoint.description.get(source)=='W8A8_DYNAMIC' for source in names]
+        if any(quantized):
+            if not all(quantized):
+                raise ValueError(f'Mixed quantization in fused projection: {name}')
+            projections=[checkpoint.linear(source.removesuffix('.weight')) for source in names]
+            parameter=torch.nn.Parameter(torch.cat([weight for weight,_ in projections]),requires_grad=False)
+            parameter.modelslim_w8a8=True
+            parameter.modelslim_weight_scale=torch.cat([scale for _,scale in projections])
+            parameter.modelslim_offload=False
+        else:
+            values=[checkpoint.tensor(source) for source in names]
+            value=values[0] if len(values)==1 else torch.cat(values)
+            if not value.dtype.is_floating_point:
+                raise ValueError(f'Undeclared ordinary integer parameter: {name}')
+            if name.endswith('.attn_sink_params'):
+                # This ModelSlim checkpoint stores sink logits in BF16; the
+                # native attention contract consumes FP32. Widen exactly,
+                # without claiming to restore any discarded source precision.
+                if original.dtype!=torch.float32 or value.dtype not in (torch.bfloat16,torch.float32):
+                    raise ValueError(f'Unsupported attention sink dtype: {name}')
+                value=value.float()
+            parameter=torch.nn.Parameter(value.to(device),requires_grad=False)
+        if parameter.shape!=original.shape:
+            raise ValueError(f'Materialized shape mismatch: {name}')
+        for key,value in original.__dict__.items():
+            if key not in parameter.__dict__ and key not in ('sf','ue8m0_sf'):
+                setattr(parameter,key,value)
+        owner_name,attribute=name.rsplit('.',1)
+        owner=model.get_submodule(owner_name)
+        if attribute in owner._buffers:
+            owner._buffers[attribute]=parameter.detach()
+        else:
+            setattr(owner,attribute,parameter)
+        loaded[name]=parameter
+    for name,source in plan.aliases.items():
+        original=targets[name]
+        parameter=torch.nn.Parameter(loaded[source].detach(),requires_grad=False)
+        if original.shape!=parameter.shape:
+            raise ValueError(f'ModelSlim tied shape mismatch: {name}')
+        for key,value in original.__dict__.items():
+            setattr(parameter,key,value)
+        owner_name,attribute=name.rsplit('.',1)
+        setattr(model.get_submodule(owner_name),attribute,parameter)
+        loaded[name]=parameter
+    return loaded
+
+
+def materialize_model(model,checkpoint,cfg):
+    """Assign native parameters and the fixed EP/host-table backend owners."""
+    from deepinfer.logger import init_logger
+    from deepinfer.npu_ops.moe910b import ModelSlimMoE
+    from deepinfer.npu_ops.engram910b import ModelSlimEngram
+    from deepinfer.model_executor.parallel_utils.parallel_state import PG
+
+    if PG.context_parallel_group().size()!=1:
+        raise ValueError('ModelSlim 910B eager deployment currently requires CP=1')
+    logger=init_logger(__name__)
+    plan=plan_parameters(model,checkpoint,cfg)
+    materialize_ordinary_parameters(model,checkpoint,plan,device=torch.device('npu',torch.npu.current_device()))
+    from deep_cluster.topology.bind import interleave_memory
+    with interleave_memory():
+        for name,prefix in plan.moe_modules.items():
+            owner=model.get_submodule(name)
+            owner.modelslim_backend=ModelSlimMoE(checkpoint,prefix,owner.cfg,group=owner.ep_group,offload=True)
+            logger.info(f'ModelSlim fixed EP CPU weights loaded: {prefix}')
+    for name,prefix in plan.engram_modules.items():
+        owner=model.get_submodule(name)
+        owner.modelslim_backend=ModelSlimEngram(checkpoint,prefix,cfg.gpt)
+        logger.info(f'ModelSlim host Engram table registered: {prefix}')
+    return plan
diff --git a/deepinfer/hugging_face/modelslim_w8a8.py b/deepinfer/hugging_face/modelslim_w8a8.py
new file mode 100644
--- /dev/null
+++ b/deepinfer/hugging_face/modelslim_w8a8.py
@@ -0,0 +1,133 @@
+"""Read ModelSlim W8A8 tensors without converting integer codes to FP8/FP4.
+
+The index can inspect completed shards while a transfer is in progress. This
+does not admit a model run: callers must separately require complete coverage.
+"""
+from __future__ import annotations
+
+import json
+import struct
+from pathlib import Path
+
+import torch
+from safetensors import safe_open
+
+
+class ModelSlimW8A8Checkpoint:
+    def __init__(self, root: str | Path) -> None:
+        self.root = Path(root)
+        self.description = json.loads((self.root / "quant_model_description.json").read_text())
+        if self.description.get("model_quant_type") != "W8A8_DYNAMIC":
+            raise ValueError("Expected ModelSlim W8A8_DYNAMIC")
+        self.tensors: dict[str, Path] = {}
+        self.headers: dict[str, dict] = {}
+        self.incomplete_shards: list[str] = []
+        index_path = self.root / "quant_model_weights.safetensors.index.json"
+        self.weight_map = json.loads(index_path.read_text())["weight_map"] if index_path.is_file() else None
+        if self.weight_map is not None:
+            for shard in self.weight_map.values():
+                if not isinstance(shard, str) or Path(shard).name != shard:
+                    raise ValueError("ModelSlim index must reference shards inside its checkpoint directory")
+        for path in sorted(self.root.glob("quant_model_weights-*.safetensors")):
+            with path.open("rb") as stream:
+                raw = stream.read(8)
+                if len(raw) != 8:
+                    self.incomplete_shards.append(path.name)
+                    continue
+                size = struct.unpack("<Q", raw)[0]
+                if not 2 <= size <= 64 * 1024 * 1024:
+                    raise ValueError(f"Invalid safetensors header: {path.name}")
+                header_bytes = stream.read(size)
+            if len(header_bytes) != size:
+                self.incomplete_shards.append(path.name)
+                continue
+            header = json.loads(header_bytes)
+            tensors = {k: v for k, v in header.items() if k != "__metadata__"}
+            expected = 8 + size + max(v["data_offsets"][1] for v in tensors.values())
+            if path.stat().st_size != expected:
+                self.incomplete_shards.append(path.name)
+                continue
+            for name, value in tensors.items():
+                # The published index selects postprocessed Engram projections
+                # from engram-extra shards over obsolete copies in base shards.
+                if self.weight_map is not None and self.weight_map.get(name) != path.name:
+                    continue
+                if name in self.tensors:
+                    raise ValueError(f"Duplicate tensor: {name}")
+                self.tensors[name] = path
+                self.headers[name] = value
+
+    def require_complete_coverage(self) -> None:
+        """Require the published index and every tensor it names, not just linears."""
+        if self.weight_map is None:
+            raise ValueError("A full model load requires the published ModelSlim safetensors index")
+        missing = sorted(set(self.weight_map) - set(self.tensors))
+        if self.incomplete_shards or missing:
+            raise ValueError(f"Incomplete ModelSlim index coverage: {len(missing)} missing tensors, "
+                             f"{len(self.incomplete_shards)} partial shards")
+        self.require_complete_linear_coverage()
+
+    def tensor(self, name: str) -> torch.Tensor:
+        if name not in self.tensors:
+            raise FileNotFoundError(f"Tensor not present in completed shards: {name}")
+        with safe_open(self.tensors[name], framework="pt", device="cpu") as handle:
+            # Own the selected tensor only, not a mutable view of a transfer file.
+            return handle.get_tensor(name).clone()
+
+    def linear(self, prefix: str) -> tuple[torch.Tensor, torch.Tensor]:
+        name = prefix + ".weight"
+        if self.description.get(name) != "W8A8_DYNAMIC":
+            raise ValueError(f"Not a W8A8_DYNAMIC projection: {prefix}")
+        weight = self.tensor(name)
+        scale = self.tensor(prefix + ".weight_scale").float().flatten()
+        offset = self.tensor(prefix + ".weight_offset")
+        if weight.dtype != torch.int8 or weight.ndim != 2:
+            raise ValueError(f"Expected 2D INT8 weight: {prefix}")
+        if scale.numel() != weight.shape[0] or offset.numel() != weight.shape[0]:
+            raise ValueError(f"Per-output-channel scale/offset mismatch: {prefix}")
+        if not torch.isfinite(scale).all() or not (scale > 0).all():
+            raise ValueError(f"Nonpositive or nonfinite scale: {prefix}")
+        if not torch.isfinite(offset).all() or torch.count_nonzero(offset).item():
+            raise ValueError(f"Asymmetric offsets require a separate kernel contract: {prefix}")
+        return weight, scale
+
+    def require_complete_linear_coverage(self) -> None:
+        missing = []
+        for name, kind in self.description.items():
+            if kind == "W8A8_DYNAMIC" and name.endswith(".weight"):
+                prefix = name.removesuffix(".weight")
+                missing.extend(key for key in (name, prefix + ".weight_scale", prefix + ".weight_offset")
+                               if key not in self.tensors)
+        if self.incomplete_shards or missing:
+            raise ValueError(f"Incomplete checkpoint: {len(self.incomplete_shards)} partial shards, "
+                             f"{len(missing)} missing W8A8 tensors")
+
+    def linear_parameter(self, prefix: str, *, offload: bool) -> torch.nn.Parameter:
+        """Materialize the parameter contract consumed by native ReplicatedLinear."""
+        weight, scale = self.linear(prefix)
+        parameter = torch.nn.Parameter(weight, requires_grad=False)
+        parameter.modelslim_w8a8 = True
+        parameter.modelslim_weight_scale = scale
+        parameter.modelslim_offload = offload
+        return parameter
+
+    def rows(self, name: str, indices: torch.Tensor) -> torch.Tensor:
+        """Read selected table rows, never materializing the full Engram table."""
+        if name not in self.tensors:
+            raise FileNotFoundError(f"Table not present in completed shards: {name}")
+        if indices.device.type != "cpu" or indices.dtype != torch.int64 or indices.ndim != 1:
+            raise ValueError("Table row indices must be a flat CPU int64 tensor")
+        header = self.headers[name]
+        shape = header["shape"]
+        if len(shape) != 2:
+            raise ValueError("Expected a two-dimensional embedding table")
+        if indices.numel() and (indices.min() < 0 or indices.max() >= shape[0]):
+            raise IndexError("Engram row outside checkpoint table")
+        unique, inverse = torch.unique(indices, sorted=True, return_inverse=True)
+        with safe_open(self.tensors[name], framework="pt", device="cpu") as handle:
+            table = handle.get_slice(name)
+            if unique.numel() == 0:
+                return table[0:0].clone()
+            selected = torch.cat([table[row:row+1] for row in unique.tolist()])
+        return selected.index_select(0, inverse)
+
