+++ b/deepinfer/npu_ops/indexer910b.py
@@ -0,0 +1,100 @@
+"""BF16 indexer logits with bounded scratch and explicit paged addressing."""
+import torch
+
+
+def _positions(length,blocks,block_size):
+    if blocks is None:
+        positions=torch.arange(length,dtype=torch.int64)
+        return positions,positions
+    positions=(blocks.long().unsqueeze(-1)*block_size+torch.arange(block_size)).flatten()
+    valid=(blocks.unsqueeze(-1)>=0).expand(-1,block_size).flatten()&(positions<length)
+    columns=torch.arange(positions.numel(),dtype=torch.int64)
+    return positions[valid],columns[valid]
+
+
+def _scores(q,k,weights):
+    return ((q.float()@k.float().T).relu()*weights.float().unsqueeze(-1)).sum(0).bfloat16()
+
+
+@torch.inference_mode()
+def prefill(q, keys, weights, starts, ends, max_len, blocks=None, block_size=0, valid_mask=None):
+    starts = starts.cpu().tolist()
+    ends = ends.cpu().tolist()
+    candidates = None if blocks is None else blocks.cpu()
+    active = [True] * q.shape[0] if valid_mask is None else valid_mask.cpu().tolist()
+    width = max_len if blocks is None else blocks.shape[1] * block_size
+    output = torch.full((q.shape[0], width), -torch.inf, dtype=torch.bfloat16, device=q.device)
+    for begin in range(0, q.shape[0], 8):
+        end = min(begin + 8, q.shape[0])
+        selections = []
+        for row in range(begin, end):
+            if active[row]:
+                positions, columns = _positions(ends[row] - starts[row], None if candidates is None else candidates[row], block_size)
+                selections.append((positions + starts[row], columns))
+            else:
+                empty = torch.empty(0, dtype=torch.int64)
+                selections.append((empty, empty))
+        maximum = max((positions.numel() for positions, _ in selections), default=0)
+        query = q[begin:end].float()
+        head_weights = weights[begin:end].float().unsqueeze(-1)
+        for offset in range(0, maximum, 4096):
+            count = min(4096, maximum - offset)
+            addresses = torch.zeros(end - begin, count, dtype=torch.int64)
+            counts = []
+            for row, (positions, _) in enumerate(selections):
+                selected = positions[offset:offset + count]
+                counts.append(selected.numel())
+                addresses[row, :selected.numel()] = selected
+            # A ragged N dimension can select another NPU matmul tiling and
+            # change rounding. Batch full 4096-key tiles only; preserve the
+            # original scalar path for every partial tile.
+            weighted = None
+            if count == 4096:
+                selected_keys = keys.index_select(0, addresses.flatten().to(q.device))
+                selected_keys = selected_keys.reshape(end - begin, count, keys.shape[-1]).float()
+                dots = torch.bmm(query, selected_keys.transpose(1, 2))
+                weighted = dots.relu() * head_weights
+            for row, size in enumerate(counts):
+                if not size:
+                    continue
+                # The compact [heads, valid_keys] shape and stride govern the
+                # NPU reduction tree. Preserve both, including partial tiles.
+                if size == 4096:
+                    values = weighted[row].contiguous().sum(0).bfloat16()
+                else:
+                    selected = selections[row][0][offset:offset + size].to(q.device)
+                    selected_keys = keys.index_select(0, selected)
+                    values = _scores(q[begin + row], selected_keys, weights[begin + row])
+                columns = selections[row][1][offset:offset + size].to(q.device)
+                output[begin + row].index_copy_(0, columns, values)
+    return output
+
+
+@torch.inference_mode()
+def decode(q,cache,weights,lengths,tables,max_len,blocks=None,block_size=0,valid_mask=None):
+    if cache.ndim==4:
+        assert cache.shape[-2]==1
+        cache=cache.squeeze(-2)
+    lengths=lengths.cpu().tolist();tables=tables.cpu().tolist()
+    candidates=None if blocks is None else blocks.cpu()
+    valid=[True]*q.shape[0] if valid_mask is None else valid_mask.cpu().tolist()
+    width=max_len if blocks is None else blocks.shape[1]*block_size
+    out=torch.full((q.shape[0],width),-torch.inf,dtype=torch.bfloat16,device=q.device)
+    page_size=cache.shape[1]
+    for row,(length,active) in enumerate(zip(lengths,valid)):
+        if not active:continue
+        positions,columns=_positions(length,None if candidates is None else candidates[row],block_size)
+        # Work page by page: scalar page views retain the 64-bit byte base,
+        # including when the shared physical block stride crosses 2 GiB.
+        page_ids=positions//page_size
+        pages,counts=torch.unique_consecutive(page_ids,return_counts=True)
+        cursor=0
+        for page,count in zip(pages.tolist(),counts.tolist()):
+            selected_columns=slice(cursor,cursor+count);cursor+=count
+            pos=positions[selected_columns]
+            physical=tables[row][page]
+            if not 0<=physical<cache.shape[0]:raise ValueError('Invalid physical index-cache page')
+            keys=cache[physical].index_select(0,(pos%page_size).to(q.device))
+            col=columns[selected_columns].to(q.device)
+            out[row].index_copy_(0,col,_scores(q[row],keys,weights[row]))
+    return out
