@@ -0,0 +1,26 @@
+"""Eager CPU sampling bridge retaining the upstream fixed-point RNG contract."""
+import torch
+from deepinfer.model_executor.sampling_inputs import LogitsTransformInputs,SamplingKernelInputs
+
+
+def fused_sample(logits,sampling_inputs,*,tag='default',is_verify=None,logprobs_out=None,
+                 last_nextn_token_logprobs=None,last_next_n_token_ids=None,mtp_info_read_rows=None):
+    from deepinfer.model_executor.layers.tilelang_ops.fused_sample import fused_sample_ref
+    sample=isinstance(sampling_inputs,SamplingKernelInputs)
+    transform=sampling_inputs.logits if sample else sampling_inputs
+    params=LogitsTransformInputs(transform.temperatures.cpu(),transform.top_ps.cpu(),transform.top_ks.cpu())
+    if sample:
+        params=SamplingKernelInputs(params,sampling_inputs.seq_seeds.cpu(),sampling_inputs.sample_positions.cpu())
+    draft_lp=last_nextn_token_logprobs;draft_ids=last_next_n_token_ids
+    if draft_lp is not None and mtp_info_read_rows is not None:
+        # Transfer only the draft rows used by this batch, never the whole pool.
+        rows=mtp_info_read_rows.long()
+        draft_lp=draft_lp.index_select(0,rows);draft_ids=draft_ids.index_select(0,rows)
+    result=fused_sample_ref(logits.detach().cpu(),params,tag=tag,
+        is_verify=None if is_verify is None else is_verify.cpu(),
+        last_nextn_token_logprobs=None if draft_lp is None else draft_lp.cpu(),
+        last_next_n_token_ids=None if draft_ids is None else draft_ids.cpu())
+    converted=[None if value is None else value.to(logits.device) for value in result]
+    if logprobs_out is not None:
+        logprobs_out.copy_(converted[0]);converted[0]=logprobs_out
+    return tuple(converted)
diff --git a/deepinfer/npu_ops/sparse_attention910b.py b/deepinfer/npu_ops/sparse_attention910b.py
new file mode 100644
--- /dev/null
+++ b/deepinfer/npu_ops/sparse_attention910b.py
@@ -0,0 +1,96 @@
+"""Eager BF16 sparse MLA for native 910B prefill and paged decode.
+
+Only selected KV rows are gathered; temporary storage is bounded by eight
+query tokens, independent of total context length. LSE excludes attention
+sinks and empty rows return +inf, matching the FlashMLA caller contract.
+"""
+from __future__ import annotations
+
+import torch
+
+
+def _gather_rows(cache, indices, dim):
+    """Read selected logical rows through the allocation's contiguous storage.
+
+    Native cache planes are interleaved in each physical block. Flattening a
+    plane with reshape copies every block, including unused ones. Keep byte
+    addressing in INT64 and gather from a zero-copy view of the allocation.
+    """
+    rows = indices.flatten().long()
+    if cache.ndim == 4:
+        page = cache.shape[1]
+        offsets = (rows // page) * cache.stride(0) + (rows % page) * cache.stride(1)
+        aligned = cache.stride(0) % dim == 0 and cache.stride(1) % dim == 0
+    else:
+        offsets = rows * cache.stride(0)
+        aligned = cache.stride(0) % dim == 0
+    offsets = offsets + cache.storage_offset()
+    elements = cache.untyped_storage().nbytes() // cache.element_size()
+    if aligned and cache.storage_offset() % dim == 0:
+        physical = cache.as_strided((elements // dim, dim), (dim, 1), storage_offset=0)
+        return physical.index_select(0, offsets // dim)
+    physical = cache.as_strided((elements,), (1,), storage_offset=0)
+    scalar_offsets = offsets[:, None] + torch.arange(dim, device=cache.device, dtype=torch.int64)
+    return physical.index_select(0, scalar_offsets.flatten()).reshape(-1, dim)
+
+
+@torch.inference_mode()
+def sparse_attention(query, banks, softmax_scale, sink=None, *, strict_decode=False):
+    if query.device.type != "npu" or query.dtype != torch.bfloat16 or query.ndim != 3:
+        raise ValueError("910B MLA expects BF16 [tokens,heads,dim] NPU queries")
+    tokens, heads, dim = query.shape
+    if dim != 512:
+        raise ValueError("910B V4.1 MLA currently requires head_dim=512")
+    if sink is not None and (sink.shape != (heads,) or sink.device != query.device or sink.dtype != torch.float32):
+        raise ValueError("Attention sinks must be FP32 [heads] on the query device")
+    prepared = []
+    for cache, indices, lengths in banks:
+        if cache.dtype != torch.bfloat16 or cache.device != query.device or cache.shape[-2:] != (1, dim):
+            raise ValueError("910B MLA requires explicit BF16 KV storage, not A5 packed FP8/FP4 bytes")
+        if cache.ndim not in (3, 4) or cache.stride(-1) != 1:
+            raise ValueError("910B MLA expects dense token rows in a 3D or paged 4D cache")
+        if indices.ndim != 2 or indices.shape[0] != tokens or indices.dtype not in (torch.int32, torch.int64) or indices.device != query.device:
+            raise ValueError("Sparse indices must be integer [tokens,capacity] on the query device")
+        logical_rows = cache.numel() // dim
+        if lengths is not None:
+            if lengths.shape != (tokens,) or lengths.device != query.device or lengths.dtype not in (torch.int32, torch.int64):
+                raise ValueError("Sparse lengths must be integer [tokens] on the query device")
+            if bool(((lengths < 0) | (lengths > indices.shape[1])).any()):
+                raise ValueError("Sparse length exceeds its index capacity")
+        visible = torch.ones_like(indices, dtype=torch.bool) if lengths is None else torch.arange(indices.shape[1],device=query.device)[None,:] < lengths[:,None]
+        if strict_decode and bool((visible & ((indices < -1) | (indices >= logical_rows))).any()):
+            raise IndexError("Paged decode indices must be -1 or a valid physical token address")
+        valid = visible & (indices >= 0) & (indices < logical_rows)
+        prepared.append((cache, indices, valid))
+    output = torch.empty_like(query)
+    lse = torch.empty((tokens, heads), dtype=torch.float32, device=query.device)
+    if not sum(indices.shape[1] for _, indices, _ in prepared):
+        output.zero_()
+        lse.fill_(float("inf"))
+        return output, lse
+    for start in range(0, tokens, 8):
+        end = min(tokens, start + 8)
+        rows, masks = [], []
+        for cache, indices, valid in prepared:
+            mask = valid[start:end]
+            if cache.numel():
+                selected = indices[start:end].masked_fill(~mask, 0).long()
+                gathered = _gather_rows(cache, selected, dim).reshape(end-start, -1, dim).float()
+                # Zero probability does not suppress NaNs in an unused cache
+                # row: the final weighted sum would still evaluate 0 * NaN.
+                gathered.masked_fill_(~mask.unsqueeze(-1), 0)
+                rows.append(gathered)
+            else:
+                rows.append(query.new_zeros((end-start, indices.shape[1], dim),dtype=torch.float32))
+            masks.append(mask)
+        keys = torch.cat(rows, dim=1)
+        valid = torch.cat(masks, dim=1)
+        scores = torch.bmm(query[start:end].float(), keys.transpose(1, 2)) * softmax_scale
+        scores.masked_fill_(~valid.unsqueeze(1), float("-inf"))
+        raw_lse = scores.logsumexp(-1)
+        denominator = raw_lse if sink is None else torch.logaddexp(raw_lse, sink)
+        denominator = denominator.masked_fill(torch.isneginf(denominator), float("inf"))
+        weights = torch.exp(scores - denominator.unsqueeze(-1))
+        output[start:end] = torch.bmm(weights, keys).bfloat16()
+        lse[start:end] = raw_lse.masked_fill(torch.isneginf(raw_lse), float("inf"))
+    return output, lse
diff --git a/deepinfer/npu_ops/topk910b.py b/deepinfer/npu_ops/topk910b.py
new file mode 100644
--- /dev/null
+++ b/deepinfer/npu_ops/topk910b.py
@@ -0,0 +1,34 @@
+"""Eager top-k retaining indexer masks, output buffers and logical offsets."""
+import torch
+
+
+def topk(input,topk,sorted=False,indices_type=torch.int64,*,end=None,sorted_index=False,
+         output_idx=None,output_idx_offset=None,idx_oob_fill_value=-1,return_value=True):
+    width=input.shape[-1]
+    if topk<0:raise ValueError('topk must be nonnegative')
+    if end is None:
+        lengths=torch.full(input.shape[:-1],width,dtype=torch.int64,device=input.device)
+    else:
+        lengths=end.long().reshape(input.shape[:-1]).clamp(0,width)
+    column=torch.arange(width,device=input.device)
+    values=input.masked_fill(column>=lengths.unsqueeze(-1),-torch.inf)
+    count=min(topk,width)
+    data,index=torch.topk(values,count,dim=-1,sorted=sorted)
+    valid=index<lengths.unsqueeze(-1)
+    if topk>count:
+        pad=(*input.shape[:-1],topk-count)
+        index=torch.cat((index,torch.zeros(pad,dtype=index.dtype,device=index.device)),-1)
+        valid=torch.cat((valid,torch.zeros(pad,dtype=torch.bool,device=index.device)),-1)
+        data=torch.cat((data,torch.full(pad,-torch.inf,dtype=data.dtype,device=data.device)),-1)
+    if sorted_index:
+        _,order=torch.sort(index.masked_fill(~valid,width+1).int(),dim=-1)
+        index=index.gather(-1,order);valid=valid.gather(-1,order);data=data.gather(-1,order)
+    if output_idx_offset is not None:
+        index=index+output_idx_offset.reshape(input.shape[:-1]).unsqueeze(-1)
+    index=index.masked_fill(~valid,idx_oob_fill_value).to(indices_type)
+    data=data.masked_fill(~valid,-torch.inf)
+    if output_idx is not None:
+        if output_idx.shape!=index.shape or output_idx.dtype!=indices_type:
+            raise ValueError('topk output index shape/dtype mismatch')
+        output_idx.copy_(index);index=output_idx
+    return (data if return_value else None),index
diff --git a/deepinfer/npu_ops/transform910b.py b/deepinfer/npu_ops/transform910b.py
