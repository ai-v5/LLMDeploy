new file mode 100644
--- /dev/null
+++ b/deepinfer/npu_ops/mhc910b.py
@@ -0,0 +1,89 @@
+"""910B mHC adapters preserving the native lazy-post tensor contract."""
+from __future__ import annotations
+
+import os
+from functools import lru_cache
+from pathlib import Path
+
+import torch
+
+
+@lru_cache(maxsize=None)
+def _is_910b(index: int | None) -> bool:
+    return "910B" in torch.npu.get_device_name(index)
+
+
+def is_910b_tensor(x: torch.Tensor) -> bool:
+    return x.device.type == "npu" and _is_910b(x.device.index)
+
+
+@lru_cache(maxsize=1)
+def load_ops() -> None:
+    library = os.environ.get("DEEPINFER_910B_OP_LIBRARY")
+    if library:
+        path = Path(library)
+        if not path.is_absolute() or not path.is_file():
+            raise ValueError("DEEPINFER_910B_OP_LIBRARY must name the built 910B library")
+        torch.ops.load_library(str(path))
+    for name in ("npu_hc_pre_v3", "npu_hc_post"):
+        if not hasattr(torch.ops._C_ascend, name):
+            raise RuntimeError(f"910B custom operator {name} is not loaded")
+
+
+def pre(residual, fn, scale, base, previous, *, norm_eps, pre_eps,
+        sinkhorn_eps, post_multiplier, iterations):
+    """Return native [batch,tokens,...] mixes with the original shift semantics."""
+    if residual.shape[-2] != 4 or post_multiplier != 2.0 or pre_eps != sinkhorn_eps:
+        raise ValueError("910B HcPre requires hc_mult=4, post scale=2 and equal mix epsilons")
+    load_ops()
+    outer, hidden = residual.shape[:-2], residual.shape[-1]
+    flat = residual.reshape(-1, 4, hidden)
+    if flat.shape[0] == 0:
+        return (residual.new_empty(*outer, hidden),
+                residual.new_empty(*outer, 4, 1, dtype=torch.float32),
+                residual.new_empty(*outer, 4, 4, dtype=torch.float32),
+                residual.new_empty(*outer, 4, 1, dtype=torch.float32))
+    y, post, comb, current = torch.ops._C_ascend.npu_hc_pre_v3(
+        flat, fn, scale, base,
+        None if previous is None else previous.reshape(-1, 4),
+        hc_mult=4, hc_sinkhorn_iters=iterations, norm_eps=norm_eps, hc_eps=pre_eps)
+    return (y.reshape(*outer, hidden), post.reshape(*outer, 4, 1),
+            comb.reshape(*outer, 4, 4), current.reshape(*outer, 4, 1))
+
+
+def post(x, residual, post_mix, comb):
+    load_ops()
+    if x.numel() == 0:
+        return torch.empty_like(residual)
+    return torch.ops._C_ascend.npu_hc_post(
+        x.contiguous(), residual.contiguous(), post_mix.squeeze(-1).contiguous(), comb.contiguous())
+
+
+def apply_mix(x, mix):
+    # Lazy post keeps a leading batch axis in mix even after hc_post removes
+    # it from the trunk. Match the native kernel's flattened row contract.
+    mix = mix.reshape(*x.shape[:-1], 1)
+    return (x.float() * mix.float()).sum(-2).to(x.dtype)
+
+
+def norm(x, weight, *, residual=None, eps=1e-6, out=None,
+         return_bf16=False, out_scale=1.0):
+    """BF16/FP32 native RMSNorm contract; W8A8 quantizes in each linear consumer."""
+    if x.dtype not in (torch.bfloat16, torch.float32) or weight.shape != (x.shape[-1],):
+        raise ValueError("910B norm expects BF16/FP32 hidden states and a matching weight")
+    if residual is not None:
+        if residual.shape != x.shape or residual.dtype != x.dtype or residual.device != x.device:
+            raise ValueError("RMSNorm residual must exactly match the input")
+        added = x + residual
+    else:
+        added = x
+    xf = added.float()
+    result = (xf * torch.rsqrt(xf.square().mean(-1, keepdim=True) + eps)
+              * weight.float() * out_scale).to(x.dtype)
+    if out is not None:
+        if not isinstance(out, torch.Tensor) or out.shape != x.shape or out.dtype != x.dtype or out.device != x.device:
+            raise ValueError("RMSNorm output must exactly match the input")
+        out.copy_(result)
+        result = out
+    value = (result, result) if return_bf16 else result
+    return (value, added) if residual is not None else value
