--- /dev/null
+++ b/deepinfer/npu_ops/indexer_candidate910b.py
@@ -0,0 +1,48 @@
+"""BF16 candidate-block indexer with device-generated gather addresses.
+
+Full score columns preserve candidate holes and duplicates for the caller's
+top-k and restore operations. Native fused scoring uses32-query tiles with
+bounded scratch; dense prefill and paged decode use their separate paths.
+"""
+import torch
+
+@torch.inference_mode()
+def prefill(q,keys,weights,starts,ends,max_len,blocks=None,block_size=0,valid_mask=None):
+    if blocks is None:raise ValueError('Experiment only supports candidate-block scoring')
+    if block_size not in (8,16):raise ValueError('Expected8 or16 token candidate blocks')
+    width=blocks.shape[1]*block_size
+    output=torch.full((q.shape[0],width),-torch.inf,dtype=torch.bfloat16,device=q.device)
+    if q.shape[0]==0 or width==0:return output
+    starts=starts.to(device=q.device,dtype=torch.int64);ends=ends.to(device=q.device,dtype=torch.int64)
+    active=torch.ones(q.shape[0],dtype=torch.bool,device=q.device) if valid_mask is None else valid_mask.to(device=q.device,dtype=torch.bool)
+    if keys.shape[0]==0:
+        if bool((active&(ends>starts)).any()):raise ValueError('Nonempty logical key range without keys')
+        return output
+    import torch_npu
+    tile=4096
+    within=torch.arange(block_size,device=q.device,dtype=torch.int64)
+    for begin in range(0,q.shape[0],32):
+        stop=min(begin+32,q.shape[0]);batch=stop-begin
+        candidate=blocks[begin:stop].to(device=q.device,dtype=torch.int64)
+        relative=(candidate[:,:,None]*block_size+within).reshape(batch,width)
+        valid=((candidate[:,:,None]>=0).expand(-1,-1,block_size).reshape(batch,width)
+            &(relative<(ends[begin:stop]-starts[begin:stop])[:,None])&active[begin:stop,None])
+        addresses=torch.where(valid,relative+starts[begin:stop,None],0)
+        query=q[begin:stop].unsqueeze(1).contiguous().masked_fill(~active[begin:stop,None,None,None],0)
+        head_weights=weights[begin:stop].unsqueeze(1).contiguous().masked_fill(~active[begin:stop,None,None],0)
+        for offset in range(0,width,tile):
+            count=min(tile,width-offset);mask=valid[:,offset:offset+count]
+            address=addresses[:,offset:offset+count]
+            if count<tile:
+                address=torch.cat((address,torch.zeros((batch,tile-count),dtype=address.dtype,device=q.device)),1)
+                padded_mask=torch.cat((mask,torch.zeros((batch,tile-count),dtype=torch.bool,device=q.device)),1)
+            else:padded_mask=mask
+            selected=keys.index_select(0,address.reshape(-1)).reshape(batch,tile,1,keys.shape[-1])
+            selected.masked_fill_(~padded_mask[:,:,None,None],0)
+            indices,values=torch_npu.npu_lightning_indexer(query,selected,head_weights,
+                layout_query='BSND',layout_key='BSND',sparse_count=tile,sparse_mode=0,return_value=True)
+            indices=indices.reshape(batch,tile).long();values=values.reshape(batch,tile)
+            restored=torch.full((batch,tile+1),-torch.inf,dtype=values.dtype,device=q.device)
+            restored.scatter_(1,indices.masked_fill(indices<0,tile),values)
+            output[begin:stop,offset:offset+count].copy_(restored[:,:count].masked_fill(~mask,-torch.inf))
+    return output
diff --git a/deepinfer/npu_ops/indexer_candidate_decode910b.py b/deepinfer/npu_ops/indexer_candidate_decode910b.py
