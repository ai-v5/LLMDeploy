@@ -0,0 +1,11 @@
+"""KV allocation bound for the colocated API's live sequences plus one prefix."""
+
+
+def kv_block_budget(runtime_max_model_len: int, max_num_seqs: int, block_size: int) -> int:
+    if min(runtime_max_model_len, max_num_seqs, block_size) <= 0:
+        raise ValueError('Positive runtime length, sequence count and block size required')
+    per_sequence = (runtime_max_model_len + block_size - 1) // block_size
+    # One distinct full-length immutable prefix can outlive the live requests.
+    demand = (max_num_seqs + 1) * per_sequence + 1
+    # Preserve the engine's 80% capacity admission margin and even-block alignment.
+    return ((5 * demand + 7) // 8) * 2
