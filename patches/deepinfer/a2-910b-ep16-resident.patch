--- /dev/null
+++ b/deepinfer/npu_ops/indexer_candidate_decode910b.py
@@ -0,0 +1,59 @@
+"""Candidate decode: batch equal-length page runs without changing reductions."""
+import torch
+
+
+def _gather(cache, physical, within, dim):
+    offsets=physical[:,None]*cache.stride(0)+within*cache.stride(1)+cache.storage_offset()
+    elements=cache.untyped_storage().nbytes()//cache.element_size()
+    if cache.stride(0)%dim==0 and cache.stride(1)%dim==0 and cache.storage_offset()%dim==0:
+        storage=cache.as_strided((elements//dim,dim),(dim,1),storage_offset=0)
+        return storage.index_select(0,(offsets//dim).reshape(-1))
+    storage=cache.as_strided((elements,),(1,),storage_offset=0)
+    addresses=offsets.reshape(-1,1)+torch.arange(dim,device=cache.device,dtype=torch.int64)
+    return storage.index_select(0,addresses.reshape(-1)).reshape(-1,dim)
+
+
+@torch.inference_mode()
+def decode(q,cache,weights,lengths,tables,max_len,blocks=None,block_size=0,valid_mask=None):
+    if blocks is None or block_size not in (8,16):raise ValueError('Expected8/16-token candidate blocks')
+    if cache.ndim==4:
+        if cache.shape[-2]!=1:raise ValueError('Expected one KV head')
+        cache=cache.squeeze(-2)
+    tokens,heads,dim=q.shape
+    if cache.ndim!=3 or cache.shape[-1]!=dim or cache.stride(-1)!=1:raise ValueError('Expected paged key rows')
+    if weights.shape!=(tokens,heads) or lengths.shape!=(tokens,) or tables.shape[0]!=tokens or blocks.shape[0]!=tokens:raise ValueError('Metadata shape mismatch')
+    width=blocks.shape[1]*block_size
+    output=torch.full((tokens,width),-torch.inf,dtype=torch.bfloat16,device=q.device)
+    if tokens==0 or width==0:return output
+    sizes=lengths.cpu().tolist();page_tables=tables.cpu().tolist();candidates=blocks.cpu()
+    active=[True]*tokens if valid_mask is None else valid_mask.cpu().tolist()
+    page_size=cache.shape[1];groups={}
+    within=torch.arange(block_size,device='cpu',dtype=torch.int64)
+    for row,(size,enabled) in enumerate(zip(sizes,active)):
+        if not enabled:continue
+        positions=(candidates[row].long()[:,None]*block_size+within).reshape(-1)
+        valid=(candidates[row][:,None]>=0).expand(-1,block_size).reshape(-1)&(positions<size)
+        columns=torch.arange(width,device='cpu',dtype=torch.int64)[valid];positions=positions[valid]
+        pages,counts=torch.unique_consecutive(positions//page_size,return_counts=True)
+        cursor=0
+        for page,count in zip(pages.tolist(),counts.tolist()):
+            physical=page_tables[row][page]
+            if not 0<=physical<cache.shape[0]:raise ValueError('Invalid physical index-cache page')
+            end=cursor+count
+            groups.setdefault(count,[]).append((row,physical,positions[cursor:end]%page_size,columns[cursor:end]))
+            cursor=end
+    for count,runs in groups.items():
+        for start in range(0,len(runs),32):
+            batch=runs[start:start+32]
+            rows=torch.tensor([run[0] for run in batch],device=q.device,dtype=torch.int64)
+            physical=torch.tensor([run[1] for run in batch],device=q.device,dtype=torch.int64)
+            offsets=torch.stack([run[2] for run in batch]).to(q.device)
+            keys=_gather(cache,physical,offsets,dim).reshape(len(batch),count,dim)
+            dots=torch.bmm(q.index_select(0,rows).float(),keys.float().transpose(1,2))
+            dots.relu_().mul_(weights.index_select(0,rows).float().unsqueeze(-1))
+            # Retain each original contiguous[heads,count] reduction shape.
+            values=torch.stack([score.contiguous().sum(0).bfloat16() for score in dots])
+            columns=torch.stack([run[3] for run in batch]).to(q.device)
+            destinations=rows[:,None]*width+columns
+            output.view(-1).index_copy_(0,destinations.reshape(-1),values.reshape(-1))
+    return output
diff --git a/deepinfer/npu_ops/indexer_decode910b.py b/deepinfer/npu_ops/indexer_decode910b.py
new file mode 100644
--- /dev/null
+++ b/deepinfer/npu_ops/indexer_decode910b.py
@@ -0,0 +1,71 @@
+"""Paged dense decode with batched FP32 dots and reference2D head reduction.
+
+Full physical pages are gathered through64-bit storage addresses. Partial
+pages retain scalar projection/reduction shapes. Candidate-block decode
+and all prefill paths remain in their separate operators.
+"""
+import torch
+
+def _gather(cache, physical_pages, page_size, dim):
+    within=torch.arange(page_size,device=cache.device,dtype=torch.int64)
+    offsets=(physical_pages.reshape(-1,1)*cache.stride(0)+within[None,:]*cache.stride(1)+cache.storage_offset())
+    elements=cache.untyped_storage().nbytes()//cache.element_size()
+    if cache.stride(0)%dim==0 and cache.stride(1)%dim==0 and cache.storage_offset()%dim==0:
+        physical=cache.as_strided((elements//dim,dim),(dim,1),storage_offset=0)
+        return physical.index_select(0,(offsets//dim).reshape(-1))
+    physical=cache.as_strided((elements,),(1,),storage_offset=0)
+    scalar=offsets.reshape(-1,1)+torch.arange(dim,device=cache.device,dtype=torch.int64)
+    return physical.index_select(0,scalar.reshape(-1)).reshape(-1,dim)
+
+@torch.inference_mode()
+def decode(q,cache,weights,lengths,tables,max_len,blocks=None,block_size=0,valid_mask=None):
+    if blocks is not None:raise ValueError('Dense decode candidate only')
+    if cache.ndim==4:
+        if cache.shape[-2]!=1:raise ValueError('Expected one KV head')
+        cache=cache.squeeze(-2)
+    tokens,heads,dim=q.shape
+    if cache.ndim!=3 or cache.shape[-1]!=dim or cache.stride(-1)!=1:raise ValueError('Expected paged dense key rows')
+    if weights.shape!=(tokens,heads) or lengths.shape!=(tokens,) or tables.ndim!=2 or tables.shape[0]!=tokens:raise ValueError('Metadata shape mismatch')
+    output=torch.full((tokens,max_len),-torch.inf,dtype=torch.bfloat16,device=q.device)
+    if tokens==0:return output
+    active=torch.ones(tokens,dtype=torch.bool,device=q.device) if valid_mask is None else valid_mask.to(device=q.device,dtype=torch.bool)
+    lengths=lengths.to(device=q.device,dtype=torch.int64);tables=tables.to(device=q.device,dtype=torch.int64)
+    if bool((active&((lengths<0)|(lengths>max_len))).any()):raise ValueError('Invalid key length')
+    page_size=cache.shape[1]
+    # One small metadata transfer per call; never transfer the page table.
+    sizes=torch.where(active,lengths,0).cpu().tolist()
+    maximum=max((size//page_size for size in sizes),default=0)
+    if any((size+page_size-1)//page_size>tables.shape[1] for size in sizes):raise ValueError('Page table too short')
+    needed=torch.arange(tables.shape[1],device=q.device)[None,:] < torch.div(lengths+page_size-1,page_size,rounding_mode='floor')[:,None]
+    needed&=active[:,None]
+    if bool((needed&((tables<0)|(tables>=cache.shape[0]))).any()):raise ValueError('Invalid physical key page')
+    for begin in range(0,tokens,8):
+        stop=min(begin+8,tokens);batch=stop-begin
+        query=q[begin:stop].float().masked_fill(~active[begin:stop,None,None],0)
+        head_weights=weights[begin:stop].float().masked_fill(~active[begin:stop,None],0)
+        for offset in range(0,maximum,32):
+            pages=min(32,maximum-offset)
+            logical=torch.arange(offset,offset+pages,device=q.device,dtype=torch.int64)
+            visible=(logical[None,:] < torch.div(lengths[begin:stop],page_size,rounding_mode='floor')[:,None])&active[begin:stop,None]
+            physical=tables[begin:stop,offset:offset+pages].masked_fill(~visible,0)
+            keys=_gather(cache,physical,page_size,dim).reshape(batch,pages,page_size,dim)
