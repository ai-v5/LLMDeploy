@@ -0,0 +1,65 @@
+"""Fixed-shape NPUGraph for an explicitly pure, tensor-only main-model slice."""
+import torch
+
+
+class FixedTensorGraph:
+    def __init__(self, function, examples, workspace=None):
+        if not examples or any(not isinstance(x,torch.Tensor) or x.device.type!='npu' or not x.numel() for x in examples):
+            raise ValueError('Explicit nonempty NPU tensor inputs are required')
+        if len({x.device for x in examples})!=1:
+            raise ValueError('A graph slice owns exactly one device')
+        self.inputs=tuple(torch.empty_like(x,memory_format=torch.contiguous_format) for x in examples)
+        self.specs=tuple((x.shape,x.dtype,x.device) for x in examples)
+        for static,example in zip(self.inputs,examples):static.copy_(example)
+        self.pool,self.stream=workspace if workspace is not None else (torch.npu.graph_pool_handle(),torch.npu.Stream(device=examples[0].device))
+        self.stream.wait_stream(torch.npu.current_stream())
+        with torch.npu.stream(self.stream):
+            for _ in range(2):function(*self.inputs)
+        self.stream.synchronize()
+        self.graph=torch.npu.NPUGraph()
+        with torch.npu.graph(self.graph,pool=self.pool,stream=self.stream):
+            self.output=function(*self.inputs)
+        torch.npu.current_stream().wait_stream(self.stream)
+        self.replays=0
+
+    @torch.inference_mode()
+    def __call__(self,*inputs):
+        if len(inputs)!=len(self.specs) or any((x.shape,x.dtype,x.device)!=spec for x,spec in zip(inputs,self.specs)):
+            raise ValueError('Graph replay requires the captured shapes, dtypes and device')
+        for static,value in zip(self.inputs,inputs):static.copy_(value)
+        self.graph.replay()
+        self.replays+=1
+        return self.output
+
+
+_MAIN_WORKSPACES={}
+
+
+def graph_workspace(device, q):
+    # Single main forward thread. Each exact-Q path captures and replays its
+    # main layers in order; no pool is shared across different Q buckets.
+    key=(device,q)
+    if key not in _MAIN_WORKSPACES:
+        _MAIN_WORKSPACES[key]=(torch.npu.graph_pool_handle(),torch.npu.Stream(device=device))
+    return _MAIN_WORKSPACES[key]
+
+
+def main_graph_call(owner, name, function, *inputs):
+    # Experimental first slice: exact local decode Q1..6; never pad routing.
+    if not 1 <= inputs[0].shape[0] <= 6:
+        return function(*inputs)
+    key=(name,tuple((tuple(x.shape),x.dtype,x.device) for x in inputs))
+    cache=owner.__dict__.setdefault('_910b_main_graph_cache',{})
+    if key not in cache:
+        cache[key]=FixedTensorGraph(function,inputs,graph_workspace(inputs[0].device,inputs[0].shape[0]))
+    return cache[key](*inputs)
+
+
+def main_graph_stats(model):
+    stats={'graphs':0,'replays':0,'by_slice':{}}
+    for module in model.modules():
+        for key,graph in module.__dict__.get('_910b_main_graph_cache',{}).items():
+            stats['graphs']+=1;stats['replays']+=graph.replays
+            item=stats['by_slice'].setdefault(key[0],{'graphs':0,'replays':0})
+            item['graphs']+=1;item['replays']+=graph.replays
+    return stats
