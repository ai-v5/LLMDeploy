--- /dev/null
+++ b/deepinfer/npu_ops/indexer_paged_prefill_graph910b.py
@@ -0,0 +1,149 @@
+"""Paged gather through top-k in one bounded graph; unvalidated candidate.
+
+The physical KV allocation is an external immutable-address binding, never
+an input cloned by FixedTensorGraph. Layer offsets and compact maps are small
+dynamic inputs. This composes existing ops, not a new fused CANN kernel.
+"""
+from collections import OrderedDict
+import torch
+from deepinfer.npu_ops.indexer_paged_keys910b import PagedKeySource, PagedKeyView, KEY_CAPACITY
+from deepinfer.npu_ops.indexer_dense_prefill_graph910b import DensePrefill
+from deepinfer.npu_ops.shared_candidate_prefill_graph910b import _function as candidate_function
+from deepinfer.npu_ops.main_decode_graph910b import FixedTensorGraph
+from deepinfer.npu_ops.prefill_workspace910b import prefill_workspace, release_prefill_workspace
+
+_DEVICES = {}
+_PROFILE_RELEASES = {}
+MAX_GRAPHS_PER_DEVICE = 2
+
+
+class PagedPrefillGraph:
+    def __init__(self, source, examples, *, plan, chunk_size, max_len, topk_tokens,
+                 block_size, source_block_size, source_topk, workspace):
+        self.binding = source.binding
+        self.physical = source.physical
+        self.specs = tuple((tuple(x.shape), x.dtype, x.device) for x in examples)
+        self.processors = []
+        rows = examples[0].shape[0]
+        if not block_size:
+            for begin in range(0, rows, chunk_size):
+                stop = min(begin + chunk_size, rows)
+                self.processors.append(DensePrefill(plan.chunk(begin, stop), key_capacity=KEY_CAPACITY,
+                    max_len=max_len, topk_tokens=topk_tokens, device=source.device,
+                    source_block_size=source_block_size, source_topk=source_topk))
+        self.gather_rows_per_execution = 0
+
+        def function(q, weights, starts, ends, active, load_rows, geometry, count, *candidate):
+            key_error = torch.zeros((), dtype=torch.bool, device=q.device)
+            keys = PagedKeyView(self.physical, load_rows, geometry, count, key_error)
+            output = torch.empty((rows, topk_tokens), dtype=torch.int32, device=q.device)
+            errors = torch.empty((rows,), dtype=torch.bool, device=q.device)
+            aux = torch.empty((rows,), dtype=torch.int32, device=q.device) if block_size else torch.empty(
+                (rows, source_topk), dtype=torch.int32, device=q.device)
+            for chunk, begin in enumerate(range(0, rows, chunk_size)):
+                stop = min(begin + chunk_size, rows)
+                values = (q[begin:stop], keys, weights[begin:stop], starts[begin:stop],
+                          ends[begin:stop], active[begin:stop])
+                if block_size:
+                    result, error, extra = candidate_function(block_size, topk_tokens, *values,
+                                                              candidate[0][begin:stop], count)
+                else:
+                    result, error, extra = self.processors[chunk](*values, count)
+                output[begin:stop].copy_(result)
+                errors[begin:stop].copy_(error)
+                aux[begin:stop].copy_(extra)
+            errors.logical_or_(key_error)
+            self.gather_rows_per_execution = keys.gathered_rows
+            return output, errors, aux
+
+        self.fixed = FixedTensorGraph(function, examples, workspace)
+
+    def __call__(self, source, examples):
+        if source.binding != self.binding:
+            raise ValueError("Current KV backing differs from captured external binding")
+        if tuple((tuple(x.shape), x.dtype, x.device) for x in examples) != self.specs:
+            raise ValueError("Paged graph input contract changed")
+        # Only q/weights/small metadata are cloned/copied. Never cache or keys.
+        result = self.fixed(*examples)
+        return tuple(value.clone() for value in result)
+
+
+@torch.inference_mode()
+def call(source, q, weights, starts, ends, active, *, plan=None, chunk_size,
+         max_len=0, topk_tokens, blocks=None, block_size=0, source_block_size=0, source_topk=0):
+    if not isinstance(source, PagedKeySource) or q.device.type != "npu":
+        raise ValueError("Explicit paged NPU index-K source required")
+    if q.ndim != 3 or q.shape[1:] != (32, 128) or q.dtype != torch.bfloat16 or not q.shape[0]:
+        raise ValueError("Expected nonempty BF16 32-head128 query")
+    if weights.shape != q.shape[:2] or weights.dtype not in (torch.bfloat16, torch.float32):
+        raise ValueError("Preserve original head weights")
+    if starts.shape != (q.shape[0],) or ends.shape != starts.shape or active.shape != starts.shape:
+        raise ValueError("Query-aligned metadata required")
+    if starts.dtype != torch.int32 or ends.dtype != torch.int32 or active.dtype != torch.bool:
+        raise ValueError("Expected original INT32 ranges and bool mask")
+    if chunk_size <= 0 or bool(blocks is not None) != bool(block_size):
+        raise ValueError("Invalid chunk/candidate configuration")
+    if block_size:
+        if block_size not in (8, 16) or blocks.ndim != 2 or blocks.shape[0] != q.shape[0]:
+            raise ValueError("Expected original aligned candidate rows")
+        if blocks.dtype != torch.int32 or not blocks.shape[1] or blocks.shape[1] % 8:
+            raise ValueError("Expected nonempty aligned INT32 candidate blocks")
+        if source_block_size or source_topk:
+            raise ValueError("Candidate consumer cannot also be a source producer")
+    elif plan is None or len(plan.starts) != q.shape[0]:
+        raise ValueError("Dense/source requires exact CPU query plan")
+    examples = (q, weights, starts, ends, active, source.load.rows, source.geometry, source.load.count)
+    if blocks is not None:
+        examples += (blocks,)
+    if any(value.device != q.device for value in examples) or source.device != q.device:
+        raise ValueError("All graph inputs and external KV must be on one device")
+    state = _DEVICES.setdefault(q.device, {"graphs": OrderedDict(), "captures": 0, "replays": 0,
+        "evictions": 0, "logical_selected_rows": 0})
+    key = (source.binding, plan, chunk_size, max_len, topk_tokens, block_size, source_block_size,
+           source_topk, tuple((tuple(x.shape), x.dtype, x.device) for x in examples))
+    graph = state["graphs"].get(key)
+    if graph is None:
+        if len(state["graphs"]) >= MAX_GRAPHS_PER_DEVICE:
+            state["graphs"].popitem(last=False)
+            state["evictions"] += 1
+        graph = PagedPrefillGraph(source, examples, plan=plan, chunk_size=chunk_size, max_len=max_len,
+            topk_tokens=topk_tokens, block_size=block_size, source_block_size=source_block_size,
+            source_topk=source_topk, workspace=prefill_workspace(q.device))
+        state["graphs"][key] = graph
+        state["captures"] += 1
+    state["graphs"].move_to_end(key)
+    result = graph(source, examples)
+    state["replays"] += 1
+    state["logical_selected_rows"] += graph.gather_rows_per_execution
+    return result
+
+
+def release_profile_bindings():
+    """Drop captures retaining temporary profile KV before capacity accounting.
+
+    This is a startup boundary, never a token-step operation. Synchronize before
+    releasing graphs whose external cache allocation is about to leave scope.
+    Neither allocator peaks nor the original KV budget formula are reset.
+    """
+    device = torch.device('npu', torch.npu.current_device())
+    state = _DEVICES.get(device)
+    if state is None:
+        return
+    torch.npu.synchronize()
+    summary = _PROFILE_RELEASES.setdefault(device, {'events': 0, 'graphs_dropped': 0})
+    summary['events'] += 1
+    summary['graphs_dropped'] += len(state['graphs'])
+    state['graphs'].clear()
+    del _DEVICES[device]
+    release_prefill_workspace(device)
+
+
+def stats(device):
+    released = dict(_PROFILE_RELEASES.get(device, {'events': 0, 'graphs_dropped': 0}))
+    state = _DEVICES.get(device)
+    if state is None:
+        return {"graphs": 0, "captures": 0, "replays": 0, "evictions": 0, 'profile_releases': released}
+    return {key: state[key] for key in ("captures", "replays", "evictions", "logical_selected_rows")} | {
+        "graphs": len(state["graphs"]), "persistent_compact_key_arena_bytes": 0,
+        'profile_releases': released,
+        "scope": "Task-local source candidate; selected rows are static capture accounting, not a trace. External KV views alias existing storage. Graph pool scratch/fullpeak/performance not validated."}
diff --git a/deepinfer/npu_ops/indexer_prefill_graph910b.py b/deepinfer/npu_ops/indexer_prefill_graph910b.py
