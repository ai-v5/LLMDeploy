--- /dev/null
+++ b/deepinfer/npu_ops/indexer_prefill_graph910b.py
@@ -0,0 +1,212 @@
+"""Experimental actual-model dense/source/candidate prefill graph adapter.
+
+Task-local opt-in; strict components passed, actual model admission pending.
+Before recipe promotion enable the validated path or remove candidate/flag.
+Empty/out-of-bound/CP>1 dense metadata retains the original working path.
+Capture/replay exceptions propagate; no fallback after partial execution.
+"""
+import os
+import torch
+from deepinfer.npu_ops.shared_candidate_prefill_graph910b import call, stats, KEY_CAPACITY
+from deepinfer.npu_ops.shared_dense_prefill_graph910b import call as dense_call, stats as dense_stats
+from deepinfer.npu_ops.indexer_dense_plan910b import prepare_cpu_views
+
+_STATS={'calls':0,'chunks':0,'metadata_checks':0,'fallbacks':{},'owners':set(),
+        'dense_calls':0,'dense_chunks':0,'source_calls':0,'host_plan_prepares':0,
+        'dense_owners':set(),'views':{}}
+
+
+def enabled():
+    return os.environ.get('DEEPINFER_910B_INDEXER_PREFILL_GRAPH')=='1'
+
+
+def paged_enabled():
+    return enabled() and os.environ.get('DEEPINFER_910B_INDEXER_PAGED_GRAPH') == '1'
+
+
+def prepare_host_metadata(metadata, cp_size):
+    if not enabled() or not metadata.is_prompt or cp_size != 1:
+        return None
+    plans=prepare_cpu_views(metadata)
+    if paged_enabled():
+        from deepinfer.npu_ops.indexer_paged_keys910b import prepare_cpu_loads
+        plans['_paged_load'] = prepare_cpu_loads(metadata)
+    _STATS['host_plan_prepares']+=1
+    return plans
+
+
+def attach_host_metadata(metadata, plans):
+    # recursive_fn reconstructs dataclass fields and drops dynamic attributes.
+    # Attach explicitly after transfer, while retaining CPU-only immutable plans.
+    metadata._910b_prefill_host_plans=plans
+    metadata._910b_prefill_plan_view='base'
+    if plans is not None and '_paged_load' in plans:
+        from deepinfer.npu_ops.indexer_paged_keys910b import transfer_loads
+        metadata._910b_paged_loads = transfer_loads(plans['_paged_load'], metadata.positions.device)
+
+
+def maybe_paged_source(cache, metadata, ratio):
+    if not paged_enabled():
+        return None
+    loads = getattr(metadata, '_910b_paged_loads', {})
+    if ratio not in loads:
+        return None  # Empty/out-of-capacity/CP>1 stays on the existing path.
+    from deepinfer.npu_ops.indexer_paged_keys910b import PagedKeySource
+    source = PagedKeySource(cache, loads[ratio])
+    if source.shape[0] != metadata.total_k_compressed[ratio]:
+        raise ValueError('Paged load plan no longer matches logical key count')
+    return source
+
+
+def begin_forward(metadata):
+    metadata._910b_indexer_prefill_error=None
+    if enabled() and metadata.is_prompt:
+        metadata._910b_indexer_prefill_error=torch.zeros((),dtype=torch.bool,device=metadata.positions.device)
+
+
+def end_forward(metadata):
+    error=getattr(metadata,'_910b_indexer_prefill_error',None)
+    if error is not None:
+        _STATS['metadata_checks']+=1
+        if bool(error.item()):
+            raise ValueError('910B prefill graph rejected invalid plan or logical key range')
+
+
+def _fallback(reason):
+    counts=_STATS['fallbacks'];counts[reason]=counts.get(reason,0)+1
+    return None
+
+
+def maybe_prefill(owner,q,keys,weights,metadata,runtime):
+    if not enabled():return None
+    from deepinfer.npu_ops.indexer_paged_keys910b import PagedKeySource
+    if isinstance(keys, PagedKeySource):
+        return maybe_paged_prefill(owner,q,keys,weights,metadata,runtime)
+    if owner.use_candidate_topk:
+        return maybe_candidate(owner,q,keys,weights,metadata,runtime)
+    return maybe_dense(owner,q,keys,weights,metadata,runtime)
+
+
+def maybe_paged_prefill(owner, q, keys, weights, metadata, runtime):
+    from deepinfer.npu_ops.indexer_paged_prefill_graph910b import call as paged_call
+    if not paged_enabled() or not metadata.is_prompt or not q.shape[0]:
+        raise ValueError('Paged source must be consumed by the matching nonempty prefill graph')
+    gate = getattr(metadata, '_910b_indexer_prefill_error', None)
+    if gate is None:
+        raise RuntimeError('Missing paged prefill error gate')
+    valid = getattr(metadata, 'valid_token_mask', None)
+    active = torch.ones(q.shape[0], dtype=torch.bool, device=q.device) if valid is None else valid.to(torch.bool)
+    starts, ends = metadata.ks[owner.ratio_key], metadata.ke[owner.ratio_key]
+    common = dict(chunk_size=owner.compute_chunk_size, topk_tokens=owner.topk_tokens)
+    if owner.use_candidate_topk:
+        if runtime is None or runtime.block_candidate_idxs is None:
+            raise ValueError('Missing paged candidate producer')
+        before = runtime.candidate_block_size_before_compress
+        if before % owner.kv_compress_ratio:
+            raise ValueError('Unaligned paged candidate compression')
+        blocks = runtime.block_candidate_idxs
+        if blocks.shape[1] != runtime.candidate_topk_block:
+            raise ValueError('Paged candidate width changed')
+        result, error, compact = paged_call(keys, q, weights, starts, ends, active,
+            blocks=blocks, block_size=before // owner.kv_compress_ratio, **common)
+        runtime.candidate_mqa_lens = compact
+    else:
+        plans = getattr(metadata, '_910b_prefill_host_plans', None)
+        view = getattr(metadata, '_910b_prefill_plan_view', None)
+        if plans is None or view not in plans or owner.ratio_key not in plans[view]:
+            raise ValueError('Missing explicit paged dense metadata view')
+        source = owner.is_candidate_topk_source
+        source_topk = owner.candidate_topk_cfg.topk_block if source else 0
+        if source and (runtime is None or runtime.block_candidate_idxs is None
+                       or runtime.block_candidate_idxs.shape != (q.shape[0], source_topk)):
+            raise ValueError('Paged source block output layout changed')
+        result, error, block_output = paged_call(keys, q, weights, starts, ends, active,
+            plan=plans[view][owner.ratio_key], max_len=owner.max_kv_len,
+            source_block_size=owner.candidate_topk_cfg.block_size if source else 0,
+            source_topk=source_topk, **common)
+        if source:
+            runtime.block_candidate_idxs.copy_(block_output)
+    gate.logical_or_(error.any())
+    _STATS['paged_calls'] = _STATS.get('paged_calls', 0) + 1
+    return result
+
+
+def maybe_candidate(owner,q,keys,weights,metadata,runtime):
+    if not enabled():return None
+    if not metadata.is_prompt or not owner.use_candidate_topk:return _fallback('not_candidate_prefill')
+    if not q.shape[0] or not keys.shape[0]:return _fallback('empty_shape')
+    if keys.shape[0]>KEY_CAPACITY:return _fallback('key_capacity')
+    if runtime is None or runtime.block_candidate_idxs is None:raise ValueError('Missing candidate producer')
+    blocks=runtime.block_candidate_idxs
+    if blocks.shape[1]!=runtime.candidate_topk_block:raise ValueError('Candidate width changed')
+    before=runtime.candidate_block_size_before_compress
+    if before%owner.kv_compress_ratio:raise ValueError('Unaligned candidate block size')
+    bs=before//owner.kv_compress_ratio
+    if bs not in (8,16):return _fallback('block_size')
+    gate=getattr(metadata,'_910b_indexer_prefill_error',None)
+    if gate is None:raise RuntimeError('ModelRunner must initialize prefill graph metadata gate')
+    valid=getattr(metadata,'valid_token_mask',None)
+    active=torch.ones(q.shape[0],dtype=torch.bool,device=q.device) if valid is None else valid.to(torch.bool)
+    starts,ends=metadata.ks[owner.ratio_key],metadata.ke[owner.ratio_key]
+    output=torch.empty((q.shape[0],owner.topk_tokens),dtype=torch.int32,device=q.device)
+    compact=torch.empty((q.shape[0],),dtype=torch.int32,device=q.device)
+    for begin in range(0,q.shape[0],owner.compute_chunk_size):
+        stop=min(begin+owner.compute_chunk_size,q.shape[0])
+        result,error,lens=call((q[begin:stop],keys,weights[begin:stop],starts[begin:stop],ends[begin:stop],
+                                active[begin:stop],blocks[begin:stop]),block_size=bs,topk_tokens=owner.topk_tokens)
+        output[begin:stop].copy_(result);compact[begin:stop].copy_(lens)
+        gate.logical_or_(error.any())
+        _STATS['chunks']+=1
+    runtime.candidate_mqa_lens=compact
+    _STATS['calls']+=1;_STATS['owners'].add(owner.layer_idx)
+    return output
+
+
+def maybe_dense(owner,q,keys,weights,metadata,runtime):
+    if not metadata.is_prompt or owner.use_candidate_topk:return _fallback('not_dense_prefill')
+    if not q.shape[0] or not keys.shape[0]:return _fallback('dense_empty_shape')
+    if keys.shape[0]>KEY_CAPACITY:return _fallback('dense_key_capacity')
+    plans=getattr(metadata,'_910b_prefill_host_plans',None)
+    if plans is None:return _fallback('dense_missing_cpu_plan')
+    view=getattr(metadata,'_910b_prefill_plan_view',None)
+    if view not in plans or owner.ratio_key not in plans[view]:
+        raise ValueError('Missing explicit dense metadata view/ratio')
+    plan=plans[view][owner.ratio_key]
+    if len(plan.starts)!=q.shape[0]:raise ValueError('Dense CPU plan is not query-aligned')
+    gate=getattr(metadata,'_910b_indexer_prefill_error',None)
+    if gate is None:raise RuntimeError('ModelRunner must initialize prefill graph metadata gate')
+    valid=getattr(metadata,'valid_token_mask',None)
+    active=torch.ones(q.shape[0],dtype=torch.bool,device=q.device) if valid is None else valid.to(torch.bool)
+    starts,ends=metadata.ks[owner.ratio_key],metadata.ke[owner.ratio_key]
+    source=owner.is_candidate_topk_source
+    bs=owner.candidate_topk_cfg.block_size if source else 0
+    source_topk=owner.candidate_topk_cfg.topk_block if source else 0
+    if source:
+        if runtime is None or runtime.block_candidate_idxs is None:raise ValueError('Missing source block output')
+        if runtime.block_candidate_idxs.shape!=(q.shape[0],source_topk):raise ValueError('Source block output layout changed')
+    output=torch.empty((q.shape[0],owner.topk_tokens),dtype=torch.int32,device=q.device)
+    for begin in range(0,q.shape[0],owner.compute_chunk_size):
+        stop=min(begin+owner.compute_chunk_size,q.shape[0])
+        result,error,blocks=dense_call((q[begin:stop],keys,weights[begin:stop],starts[begin:stop],ends[begin:stop],active[begin:stop]),
+            plan=plan.chunk(begin,stop),max_len=owner.max_kv_len,topk_tokens=owner.topk_tokens,
+            source_block_size=bs,source_topk=source_topk)
+        output[begin:stop].copy_(result)
+        if source:runtime.block_candidate_idxs[begin:stop].copy_(blocks)
+        gate.logical_or_(error.any())
+        _STATS['dense_chunks']+=1
+    _STATS['dense_calls']+=1;_STATS['dense_owners'].add(owner.layer_idx)
+    _STATS['views'][view]=_STATS['views'].get(view,0)+1
+    if source:_STATS['source_calls']+=1
+    return output
+
+
+def prefill_graph_stats():
+    device=torch.device('npu',torch.npu.current_device())
+    from deepinfer.npu_ops.indexer_paged_prefill_graph910b import stats as paged_stats
+    names=['calls','chunks','metadata_checks','dense_calls','dense_chunks','source_calls','host_plan_prepares']
+    return {name:_STATS[name] for name in names} | {
+        'fallbacks':dict(_STATS['fallbacks']),'owner_layers':sorted(_STATS['owners']),
+        'dense_owner_layers':sorted(_STATS['dense_owners']),'dense_views':dict(_STATS['views']),
+        'shared_input':stats(device),'shared_dense_input':dense_stats(device),
+        'paged_calls':_STATS.get('paged_calls',0),'paged_input':paged_stats(device),
+        'scope':'Actual-model adapter pending admission; component graphs passed only. Not full pagedload/indexer,mainwholegraph,target performance/fullHBM saving or quality.'}
