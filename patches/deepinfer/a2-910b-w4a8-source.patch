--- /dev/null
+++ b/deepinfer/npu_ops/indexer_device_schedule910b.py
@@ -0,0 +1,151 @@
+"""Device-only candidate run scheduling; isolated integration candidate.
+
+No score arithmetic, top-k, or model path is replaced by this module yet.
+Shapes depend only on tensor/layout metadata, never device tensor values.
+Run IDs follow the reference's unique_consecutive over *valid* candidates,
+including holes, duplicate blocks and arbitrary candidate order.
+"""
+from dataclasses import dataclass
+from typing import NamedTuple
+import torch
+
+
+@dataclass(frozen=True)
+class PagedLayout:
+    pages: int
+    page_size: int
+    dim: int
+    page_stride: int
+    row_stride: int
+    storage_offset: int
+    storage_elements: int
+
+    @classmethod
+    def from_tensor(cls, cache):
+        if cache.ndim == 4:
+            if cache.shape[-2] != 1:
+                raise ValueError("Expected a single index-K head")
+            cache = cache.squeeze(-2)
+        if cache.ndim != 3 or cache.stride(-1) != 1:
+            raise ValueError("Expected paged contiguous key rows")
+        return cls(*cache.shape, cache.stride(0), cache.stride(1),
+                   cache.storage_offset(), cache.untyped_storage().nbytes() // cache.element_size())
+
+
+class RunSchedule(NamedTuple):
+    run_count: torch.Tensor
+    run_lengths: torch.Tensor
+    run_packed_starts: torch.Tensor
+    run_logical_pages: torch.Tensor
+    run_physical_pages: torch.Tensor
+    token_runs: torch.Tensor
+    token_offsets_in_run: torch.Tensor
+    token_storage_offsets: torch.Tensor
+    token_valid: torch.Tensor
+    metadata_error: torch.Tensor
+
+
+def candidate_runs(blocks, lengths, tables, layout, block_size, active=None):
+    """Return fixed-capacity run descriptors and original-column addresses.
+
+    The last run slot is private to invalid columns. Consumers MUST reject
+    metadata_error before loading cache rows (a future device kernel can guard
+    that row); this candidate never dereferences cache itself. Every real run
+    may exceed page_size because repeated blocks are retained, not deduplicated.
+    All storage offsets are INT64 *elements*, including a view's storage_offset.
+    """
+    if blocks.ndim != 2 or tables.ndim != 2:
+        raise ValueError("Expected 2D candidates and page tables")
+    rows, capacity = blocks.shape
+    if lengths.shape != (rows,) or tables.shape[0] != rows:
+        raise ValueError("Metadata row mismatch")
+    if any(t.dtype not in (torch.int32, torch.int64) for t in (blocks, lengths, tables)):
+        raise ValueError("Expected integer routing metadata")
+    if any(t.device != blocks.device for t in (lengths, tables)):
+        raise ValueError("Metadata devices must match")
+    if block_size not in (8, 16) or layout.page_size % block_size:
+        raise ValueError("Candidate blocks must fit whole cache pages")
+    if layout.dim <= 0 or layout.page_stride <= 0 or layout.row_stride <= 0:
+        raise ValueError("Expected positive layout strides")
+    if layout.pages <= 0 or layout.storage_offset < 0 or layout.storage_elements <= 0:
+        raise ValueError("Expected nonempty paged storage")
+    if active is None:
+        active = torch.ones((rows,), dtype=torch.bool, device=blocks.device)
+    elif active.shape != (rows,):
+        raise ValueError("Active mask row mismatch")
+    elif active.device != blocks.device:
+        raise ValueError("Active mask device mismatch")
+    active = active.to(dtype=torch.bool)
+    candidates = blocks.to(dtype=torch.int64)
+    lengths = lengths.to(dtype=torch.int64)
+    tables = tables.to(dtype=torch.int64)
+    first = candidates * block_size
+    counts = (lengths[:, None] - first).clamp(0, block_size)
+    counts = counts.masked_fill((candidates < 0) | ~active[:, None], 0)
+    visible = counts > 0
+    logical = torch.div(first, layout.page_size, rounding_mode="floor")
+
+    # The private table slot makes masked/OOB gathers harmless, also for width0.
+    table_width = tables.shape[1]
+    in_table = (logical >= 0) & (logical < table_width)
+    padded_table = torch.cat((tables, torch.zeros((rows, 1), dtype=torch.int64, device=tables.device)), 1)
+    physical = padded_table.gather(1, logical.masked_fill(~in_table, table_width))
+    in_cache = (physical >= 0) & (physical < layout.pages)
+    metadata_error = active & (lengths < 0)
+    metadata_error = metadata_error | (visible & (~in_table | ~in_cache)).any(1)
+
+    slots = torch.arange(capacity, dtype=torch.int64, device=blocks.device)[None, :].expand(rows, -1)
+    if capacity:
+        # Prefix predecessor skips arbitrary holes without host compaction.
+        last_valid = torch.cummax(torch.where(visible, slots + 1, 0), dim=1).values
+        previous = torch.cat((torch.zeros((rows, 1), dtype=torch.int64, device=blocks.device), last_valid[:, :-1]), 1)
+        previous_page = logical.gather(1, (previous - 1).clamp_min(0))
+        starts = visible & ((previous == 0) | (previous_page != logical))
+    else:
+        starts = visible
+    run_count = starts.sum(1, dtype=torch.int64)
+    run_ids = (starts.to(torch.int64).cumsum(1) - 1).masked_fill(~visible, capacity)
+    packed_starts = counts.cumsum(1) - counts
+    shape = (rows, capacity + 1)
+
+    def accumulate(values):
+        target = torch.zeros(shape, dtype=torch.int64, device=blocks.device)
+        return target.scatter_add_(1, run_ids, values)
+
+    run_lengths = accumulate(counts)
+    run_starts = accumulate(packed_starts.masked_fill(~starts, 0))
+    run_pages = accumulate(logical.masked_fill(~starts, 0))
+    safe_physical = physical.masked_fill(~in_cache | ~in_table, 0)
+    run_physical = accumulate(safe_physical.masked_fill(~starts, 0))
+    within = torch.arange(block_size, dtype=torch.int64, device=blocks.device)[None, None, :]
+    token_valid = (within < counts[:, :, None]).reshape(rows, capacity * block_size)
+    token_runs = run_ids[:, :, None].expand(-1, -1, block_size).reshape(rows, capacity * block_size)
+    token_runs = token_runs.masked_fill(~token_valid, capacity)
+    token_ordinal = token_valid.to(torch.int64).cumsum(1) - 1
+    token_offsets = token_ordinal - run_starts.gather(1, token_runs)
+    token_offsets = token_offsets.masked_fill(~token_valid, 0)
+    logical_within = first.remainder(layout.page_size)[:, :, None] + within
+    storage_offsets = (safe_physical[:, :, None] * layout.page_stride
+                       + logical_within * layout.row_stride + layout.storage_offset)
+    address_valid = ((storage_offsets >= 0)
+                     & (storage_offsets + layout.dim <= layout.storage_elements)).reshape(rows, capacity * block_size)
+    metadata_error = metadata_error | (token_valid & ~address_valid).any(1)
+    storage_offsets = storage_offsets.reshape(rows, capacity * block_size).masked_fill(~token_valid, 0)
+    return RunSchedule(run_count, run_lengths, run_starts, run_pages, run_physical,
+                       token_runs, token_offsets, storage_offsets, token_valid, metadata_error)
+
+
+def dense_runs(lengths, tables, layout, max_tokens, active=None):
+    """Use the same device schedule for dense keys with a host-known bound.
+
+    max_tokens must come from the current forward's authoritative CPU metadata,
+    not a per-layer device read. Width is rounded to8 only for descriptors;
+    scoring/top-k must retain their original configured output domain.
+    """
+    if max_tokens < 0:
+        raise ValueError("Negative dense key bound")
+    blocks = torch.arange((max_tokens + 7) // 8, dtype=torch.int64, device=lengths.device)
+    blocks = blocks[None, :].expand(lengths.shape[0], -1)
+    schedule = candidate_runs(blocks, lengths, tables, layout, 8, active)
+    enabled = torch.ones_like(lengths, dtype=torch.bool) if active is None else active.to(torch.bool)
+    return schedule._replace(metadata_error=schedule.metadata_error | (enabled & (lengths > max_tokens)))
diff --git a/deepinfer/npu_ops/indexer_headsum_graph910b.py b/deepinfer/npu_ops/indexer_headsum_graph910b.py
