diff --git a/deepinfer/npu_ops/candidate_block_prefix910b.py b/deepinfer/npu_ops/candidate_block_prefix910b.py
new file mode 100644
--- /dev/null
+++ b/deepinfer/npu_ops/candidate_block_prefix910b.py
@@ -0,0 +1,42 @@
+"""Unadmitted prefix-reduction candidate retaining the full block-score domain.
+
+The exact host plan supplies max_valid_length before capture. A device error
+must be checked by the caller before consuming any result. No model wiring
+or memory-benefit claim accompanies this source-only candidate.
+"""
+import torch
+
+
+def candidate_block_max_prefix_scratch(logits, valid_lens, block_size, *, max_valid_length):
+    if logits.ndim != 2 or logits.dtype != torch.bfloat16 or logits.stride(1) != 1:
+        raise ValueError("Expected original BF16 row logits")
+    rows, width = logits.shape
+    if width <= 0 or block_size not in (8, 16):
+        raise ValueError("Expected positive width and original block size")
+    if not isinstance(max_valid_length, int) or not 0 <= max_valid_length <= width:
+        raise ValueError("Expected an explicit valid host-plan prefix bound")
+    if valid_lens.shape != (rows,) or valid_lens.dtype != torch.int32:
+        raise ValueError("Expected original INT32 row lengths")
+    if not valid_lens.is_contiguous() or valid_lens.device != logits.device:
+        raise ValueError("Expected contiguous colocated lengths")
+    error = (valid_lens < 0) | (valid_lens > max_valid_length)
+    lengths = valid_lens.masked_fill(error, 0)
+    blocks = (width + block_size - 1) // block_size
+    alignment = 1024 // logits.element_size()
+    stride = (blocks + alignment - 1) // alignment * alignment
+    output = torch.full((rows, stride), -torch.inf, dtype=logits.dtype, device=logits.device)
+    complete = max_valid_length // block_size
+    if complete:
+        # Only this input view is shortened; output/source-topk width remains
+        # identical. Any partial final valid block is overwritten with +inf.
+        view = logits[:, :complete * block_size].view(rows, complete, block_size)
+        output[:, :complete].copy_(view.amax(dim=-1))
+    output.clamp_max_(torch.finfo(torch.bfloat16).max)
+    valid_blocks = torch.div(lengths + block_size - 1, block_size, rounding_mode="floor").clamp_max(blocks)
+    columns = torch.arange(stride, device=logits.device)
+    output.masked_fill_(columns.unsqueeze(0) >= valid_blocks.unsqueeze(1), -torch.inf)
+    last = (valid_blocks - 1).clamp_min(0).unsqueeze(1).to(torch.int64)
+    last_scores = output.gather(1, last)
+    last_scores = torch.where(valid_blocks.unsqueeze(1) > 0, torch.full_like(last_scores, torch.inf), last_scores)
+    output.scatter_(1, last, last_scores)
+    return output, valid_blocks, error
diff --git a/deepinfer/npu_ops/compress_prepared910b.py b/deepinfer/npu_ops/compress_prepared910b.py
new file mode 100644
--- /dev/null
+++ b/deepinfer/npu_ops/compress_prepared910b.py
@@ -0,0 +1,141 @@
+"""Task-local prepared C2 decode candidate; not wired into a model.
+
+Host metadata validation and grouping must run before capture/replay. Device
+descriptors preserve each original group's compression batch shape and row
+order. All group writes precede every window read. No value is read back from
+NPU by execute(). Actual strided-state, numerical and graph gates are pending.
+"""
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class Group:
+    slot: int
+    incoming: tuple
+    write_rings: tuple
+    read_rings: tuple
+    destinations: tuple
+
+
+@dataclass(frozen=True)
+class Plan:
+    rows: int
+    slots: int
+    ring: int
+    ratio: int
+    max_seqlen_q: int
+    groups: tuple
+
+    @property
+    def shape_key(self):
+        # Values, including slot IDs and wraparound addresses, are copied into
+        # fixed device descriptors before replay. Group sizes determine shapes.
+        return (self.rows,self.slots,self.ring,self.ratio,self.max_seqlen_q,
+                tuple((len(g.incoming),len(g.destinations)) for g in self.groups))
+
+
+def prepare_host(slots, context_lens, *, state_slots, ring, max_seqlen_q, ratio):
+    if type(slots) not in (list,tuple) or type(context_lens) not in (list,tuple):
+        raise TypeError("Prepare from scheduler host values, never device tensors")
+    if len(slots)!=len(context_lens) or any(type(v) is not int for v in (*slots,*context_lens)):
+        raise ValueError("Expected row-aligned integer slot and context metadata")
+    if min(state_slots,ring,max_seqlen_q)<=0 or ratio!=2:
+        raise ValueError("Only positive C2 decode geometry is targeted")
+    if ring < ratio+max_seqlen_q-1:
+        raise ValueError("State ring cannot hold one window and the full draft batch")
+    groups={}
+    for row,(slot,length) in enumerate(zip(slots,context_lens)):
+        if not 0<=slot<state_slots or length<1:
+            raise ValueError("Invalid compressor decode state/position")
+        groups.setdefault(slot,[]).append((row,length-1))
+    prepared=[]
+    for slot,rows in groups.items():
+        if len(rows)>max_seqlen_q or len({pos%ring for _,pos in rows})!=len(rows):
+            raise ValueError("Decode batch overwrites its own compressor ring state")
+        completed=[(row,pos) for row,pos in rows if pos%ratio==ratio-1]
+        prepared.append(Group(slot,tuple(row for row,_ in rows),tuple(pos%ring for _,pos in rows),
+            tuple((pos-ratio+1+j)%ring for _,pos in completed for j in range(ratio)),
+            tuple(row for row,_ in completed)))
+    return Plan(len(slots),state_slots,ring,ratio,max_seqlen_q,tuple(prepared))
+
+
+def materialize(plan, device):
+    """Allocate descriptor examples outside capture, never inside execute()."""
+    import torch
+    device=torch.device(device)
+    if device.type!="npu" or device.index is None:
+        raise ValueError("An explicit owning NPU device is required")
+    return tuple(torch.tensor(values,dtype=torch.int64,device=device)
+        for g in plan.groups for values in ((g.slot,),g.incoming,g.write_rings,g.read_rings,g.destinations))
+
+
+def execute(score, latent, state, plan, *descriptors):
+    """Tensor-only core; caller must validate host metadata before every use.
+
+The same shape_key permits changed descriptor values, not skipped validation.
+State is a persistent external strided tensor, not a copied graph input.
+"""
+    import torch
+    from deepinfer.npu_ops.compress910b import _compress
+    if score.ndim!=2 or latent.shape!=score.shape or state.shape!=(plan.slots,plan.ring,2,score.shape[1]):
+        raise ValueError("Prepared decode tensor geometry changed")
+    if score.shape[0]!=plan.rows or any(t.dtype!=torch.float32 for t in (score,latent,state)):
+        raise ValueError("Preserve FP32 score/latent/state and exact row count")
+    if score.device.type!="npu" or any(t.device!=score.device for t in (latent,state,*descriptors)):
+        raise ValueError("Prepared decode belongs to one NPU")
+    if len(descriptors)!=5*len(plan.groups):
+        raise ValueError("Descriptor group count changed")
+    for g,offset in zip(plan.groups,range(0,len(descriptors),5)):
+        expected=(1,len(g.incoming),len(g.incoming),plan.ratio*len(g.destinations),len(g.destinations))
+        if any(t.dtype!=torch.int64 or t.shape!=(size,) for t,size in zip(descriptors[offset:offset+5],expected)):
+            raise ValueError("Prepared descriptor shape or dtype changed")
+    out=torch.zeros((plan.rows,score.shape[1]),dtype=torch.bfloat16,device=score.device)
+    for offset in range(0,len(descriptors),5):
+        slot,incoming,writes,_,_=descriptors[offset:offset+5]
+        selected=state.index_select(0,slot)
+        selected[0,:,0].index_copy_(0,writes,score.index_select(0,incoming))
+        selected[0,:,1].index_copy_(0,writes,latent.index_select(0,incoming))
+        state.index_copy_(0,slot,selected)
+    # Do not interleave a group's reads with the write loop above.
+    for g,offset in zip(plan.groups,range(0,len(descriptors),5)):
+        if not g.destinations:
+            continue
+        slot,_,_,reads,destinations=descriptors[offset:offset+5]
+        selected=state.index_select(0,slot)
+        scores=selected[0,:,0].index_select(0,reads).reshape(-1,plan.ratio,score.shape[1])
+        latents=selected[0,:,1].index_select(0,reads).reshape(-1,plan.ratio,score.shape[1])
+        out.index_copy_(0,destinations,_compress(scores,latents))
+    return out
+
+
+def prepare_host_metadata(metadata, *, state_slots, ring, max_seqlen_q):
+    """Read scheduler-produced CPU values once before transfer or capture."""
+    import torch
+    if metadata.is_prompt:
+        raise ValueError("C2 prepared metadata is decode-only")
+    slots, lengths = metadata.state_block_idx, metadata.context_lens
+    for value in (slots, lengths):
+        if not isinstance(value, torch.Tensor) or value.device.type != "cpu" or value.dtype != torch.int32 or value.ndim != 1:
+            raise ValueError("C2 plan requires original CPU INT32 decode metadata")
+    if slots.shape != lengths.shape or slots.shape[0] != metadata.positions.shape[0]:
+        raise ValueError("C2 metadata rows do not match the forward")
+    return prepare_host(slots.tolist(), lengths.tolist(), state_slots=state_slots,
+                        ring=ring, max_seqlen_q=max_seqlen_q, ratio=2)
+
+
+def attach_host_metadata(metadata, plan):
+    """Attach after recursive tensor transfer, which drops dynamic attributes."""
+    if metadata.is_prompt or metadata.positions.shape[0] != plan.rows:
+        raise ValueError("C2 prepared metadata attached to a different forward")
+    descriptors = materialize(plan, metadata.positions.device)
+    metadata._910b_c2_plan = plan
+    metadata._910b_c2_descriptors = descriptors
+
+
+def decode_prepared(score, latent, state, metadata):
+    """Prepared main-model consumer; no host metadata access in the layer."""
+    plan = getattr(metadata, "_910b_c2_plan", None)
+    descriptors = getattr(metadata, "_910b_c2_descriptors", None)
+    if plan is None or descriptors is None or metadata.is_prompt:
+        raise ValueError("C2 decode requires a prepared forward plan")
+    return execute(score, latent, state, plan, *descriptors)
