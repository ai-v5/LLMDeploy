+"""Task-local EP16 integration candidate; model acceptance is still pending.
+
+Decode uses actual MC2. Prefill uses activation AllGather and device expert
+grouping with bounded MLP/combine scratch. No expert weights are transferred.
+"""
+from dataclasses import dataclass
+import os
+
+import torch
+import torch.distributed as dist
+from torch import nn
+
+from deepinfer.npu_ops.grouped_w8a8_910b import ResidentGroupedW8A8
+from deepinfer.npu_ops.grouped_w4a8_910b import ResidentGroupedW4A8
+from deepinfer.npu_ops.mc2_dispatch910b import MC2Dispatcher910B
+from deepinfer.npu_ops.moe_grouping910b import group_local, combine_local
+
+
+@dataclass(frozen=True)
+class TransportPlan:
+    group: object
+    capacity: int
+    mc2: bool
+    mc2_graph: bool = False
+    whole_main: bool = False
+
+
+_PLAN = None
+
+
+def begin_epoch(group, local_tokens, is_prompt, *, preparation_error=False):
+    """One small consensus per main/draft forward, outside layer hot paths.
+
+    Every EP rank must enter this function in the same model epoch. Its result
+    prevents mixed MC2/AllGather selection when ranks have different work.
+    """
+    global _PLAN
+    if dist.get_world_size(group) != 16:
+        raise ValueError('The integration candidate owns exactly EP16')
+    graph_option = os.environ.get('DEEPINFER_910B_MOE_DECODE_GRAPH', '0')
+    enabled = int(graph_option == '1')
+    whole_option = os.environ.get('DEEPINFER_910B_MAIN_WHOLE_GRAPH', '0')
+    whole = int(whole_option == '1')
+    # Agree once per model epoch, never once per expert/layer. Mixed capture
+    # and eager ranks would issue different numbers of MC2 collectives.
+    state = torch.tensor([int(is_prompt), local_tokens, enabled, 1 - enabled,
+                          int(graph_option not in ('0', '1')), whole, 1 - whole,
+                          int(whole_option not in ('0', '1')), int(preparation_error)], dtype=torch.int64,
+                         device=torch.device('npu', torch.npu.current_device()))
+    dist.all_reduce(state, op=dist.ReduceOp.MAX, group=group)
+    from deepinfer.utils import allow_cuda_sync
+    with allow_cuda_sync():
+        prompt, maximum, any_graph, any_eager, invalid, any_whole, any_plain, invalid_whole, invalid_host = state.cpu().tolist()
+    if invalid or any_graph + any_eager != 1 or invalid_whole or any_whole + any_plain != 1 or invalid_host:
+        _PLAN = None
+        raise RuntimeError('All EP ranks must agree on the valid MoE decode graph option')
+    if any_whole and not prompt and maximum > 12:
+        _PLAN = None
+        raise RuntimeError('Whole-main epoch exceeds the exact Q1..12 decode contract')
+    _PLAN = TransportPlan(group, max(1, maximum), not prompt and maximum <= 12, bool(any_graph), not prompt and bool(any_whole))
+
+
+class GroupedExpertParallel(nn.Module):
+    def __init__(self, checkpoint, prefix, cfg, *, group, mc2_group):
+        super().__init__()
+        self.group = group
+        self.world, self.rank = dist.get_world_size(group), dist.get_rank(group)
+        self.num_experts = cfg.moe.n_routed_experts
+        self.topk = cfg.moe.num_experts_per_tok
+        if self.world != 16:
+            raise ValueError('Only the validated EP16 ownership is admitted')
+        self.local_experts = self.num_experts // self.world
+        self.start = self.rank * self.local_experts
+        kind = checkpoint.description.get(f'{prefix}.experts.{self.start}.w1.weight')
+        if kind == 'W4A8_DYNAMIC':
+            resident = ResidentGroupedW4A8
+        elif kind == 'W8A8_DYNAMIC':
+            resident = ResidentGroupedW8A8
+        else:
+            raise ValueError('Unsupported owning routed-expert quantization')
+        self.mlp = resident(
+            checkpoint, prefix, range(self.start, self.start + self.local_experts),
+            hidden_size=cfg.hidden_size, intermediate_size=cfg.moe.moe_intermediate_size,
+            swiglu_limit=cfg.swiglu_limit,
+            device=torch.device('npu', torch.npu.current_device()))
+        self.dispatcher = MC2Dispatcher910B(mc2_group, num_experts=self.num_experts,
+                                           topk=self.topk)
+        self.mc2_calls = self.prefill_calls = self.mc2_graph_calls = 0
+
+    @torch.inference_mode()
+    def forward(self, hidden, ids, scores):
+        import torch_npu
+
+        plan = _PLAN
+        if plan is None or plan.group is not self.group:
+            raise RuntimeError('Main/draft forward must establish its EP transport epoch')
+        if hidden.shape[0] > plan.capacity:
+            raise RuntimeError('Local token count exceeds the agreed EP capacity')
+        if plan.mc2:
+            from deepinfer.npu_ops.whole_main_context910b import active
+            if active():
+                # The whole graph owns this stream/pool and the padding nodes.
+                # Fixed capacity12 and true-prefix mask preserve expert counts.
+                prepared = self.dispatcher.prepare_inputs(hidden, ids, scores)
+                result = self._mc2_prepared(*(value.contiguous().clone() for value in prepared))[:hidden.shape[0]]
+                self.mc2_calls += 1
+                return result
+            if plan.mc2_graph:
+                from deepinfer.npu_ops.moe_decode_graph910b import moe_decode_graph_call
+                prepared = self.dispatcher.prepare_inputs(hidden, ids, scores)
+                result = moe_decode_graph_call(self, self._mc2_prepared, *prepared)
+                self.mc2_graph_calls += 1
+                # The shared graph pool may reuse its output for the next MoE.
+                # Retain only real token rows, outside capture, before reuse.
+                result = result[:hidden.shape[0]].clone()
+            else:
+                expanded, counts, metadata = self.dispatcher.dispatch(hidden, ids, scores)
+                codes, scales = torch_npu.npu_dynamic_quant(expanded, dst_type=torch.int8)
+                del expanded
+                result = self.dispatcher.combine(self.mlp(codes, scales, counts), metadata)
+            self.mc2_calls += 1
+            return result
+
+        n, capacity = hidden.shape[0], plan.capacity
+        # Add one routing-only sentinel expert outside every real owner range.
+        # Padding must not increase real expert M, which controls dequant order.
+        def gather(value, fill):
+            padded = value.new_full((capacity, *value.shape[1:]), fill)
+            padded[:n].copy_(value)
+            output = value.new_empty((self.world * capacity, *value.shape[1:]))
+            dist.all_gather_into_tensor(output, padded, group=self.group)
+            return output
+        all_hidden = gather(hidden, 0)
+        all_ids = gather(ids, self.num_experts)
+        all_scores = gather(scores, 0)
+        partial = self._prefill_gathered(all_hidden, all_ids, all_scores)
+        del all_hidden
+        dist.all_reduce(partial, group=self.group)
+        self.prefill_calls += 1
+        return partial[self.rank * capacity:self.rank * capacity + n].bfloat16()
+
+    def _prefill_gathered(self, all_hidden, all_ids, all_scores):
+        # The owned gate emits [0,num_experts) IDs; gather padding uses exactly
+        # num_experts. Count the full epoch once on device, including zero-weight
+        # real routes, so splitting tokens cannot change projection dequant order.
+        histogram = torch.zeros(self.num_experts + 1, device=all_ids.device, dtype=torch.int64)
+        flat_ids = all_ids.reshape(-1).long()
+        histogram.scatter_add_(0, flat_ids, torch.ones_like(flat_ids))
+        arithmetic_counts = histogram[self.start:self.start + self.local_experts]
+        partial = all_hidden.new_empty(all_hidden.shape, dtype=torch.float32)
+        for begin in range(0, all_hidden.shape[0], 512):
+            stop = min(begin + 512, all_hidden.shape[0])
+            ids = all_ids[begin:stop]
+            codes, scales, counts, rows = group_local(
+                all_hidden[begin:stop], ids, num_experts=self.num_experts + 1,
+                expert_start=self.start, expert_end=self.start + self.local_experts)
+            grouped = self.mlp(codes, scales, counts, arithmetic_counts=arithmetic_counts)
+            del codes, scales
+            partial[begin:stop].copy_(combine_local(grouped, rows, counts, ids, all_scores[begin:stop]))
+            del grouped
+        return partial
+
+    def _mc2_prepared(self, hidden, ids, scores, active_mask):
+        import torch_npu
+
+        expanded, counts, metadata = self.dispatcher.dispatch_prepared(hidden, ids, scores, active_mask)
+        codes, scales = torch_npu.npu_dynamic_quant(expanded, dst_type=torch.int8)
+        del expanded
+        return self.dispatcher.combine(self.mlp(codes, scales, counts), metadata)
+
+    def resident_tensors(self):
+        return self.mlp.resident_tensors()
