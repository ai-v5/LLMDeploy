--- /dev/null
+++ b/deepinfer/npu_ops/indexer_packed_scores910b.py
@@ -0,0 +1,93 @@
+"""Unadmitted task-local consumer of native paged preparation and weighted sums.
+
+The working model is unchanged. This candidate retains original FP32 grouped
+dot/query arithmetic and BF16 selection; it requires pipeline device gates.
+"""
+from typing import NamedTuple
+import torch
+
+
+class NativePackedInputs(NamedTuple):
+    keys: torch.Tensor
+    query_matrices: torch.Tensor
+    group_lengths: torch.Tensor
+    columns: torch.Tensor
+    valid: torch.Tensor
+    metadata_error: torch.Tensor
+    lookup: torch.Tensor
+    meta: torch.Tensor
+    row_ends: torch.Tensor
+    restore: torch.Tensor
+
+
+class RunScores(NamedTuple):
+    fp32: torch.Tensor
+    bf16: torch.Tensor
+    metadata_error: torch.Tensor
+
+
+def prepare(q, cache, blocks, lengths, tables, block_size, run_capacity, packed_capacity, active):
+    """Private Q1..6 INT32 ABI. Load both native functions before capture."""
+    if q.ndim != 3 or q.shape[1:] != (32, 128) or q.dtype != torch.bfloat16:
+        raise ValueError('Expected original BF16 query[Q,32,128]')
+    if q.device != cache.device or q.shape[0] != blocks.shape[0]:
+        raise ValueError('Query/cache/metadata rows and device must match')
+    keys, counts, columns, offsets, lookup, errors, meta, restore = torch.ops.deepinfer_indexer_prepare_rows_r1264.run(
+        cache, blocks, lengths, tables, active, block_size, run_capacity, packed_capacity)
+    # Keep the original FP32 query conversion, layout and zero sentinel group.
+    rows, heads, dim = q.shape
+    query = q.float().masked_fill(errors[:, None, None], 0)
+    matrices = query[:, None].expand(-1, run_capacity, -1, -1).reshape(rows * run_capacity, heads, dim)
+    matrices = matrices.transpose(1, 2).contiguous()
+    matrices = torch.cat((matrices, torch.zeros((1, dim, heads), dtype=torch.float32, device=q.device)), 0)
+    valid = torch.arange(packed_capacity, device=q.device) < meta[0]
+    row_ends = counts[:-1].reshape(rows, run_capacity).sum(1, dtype=torch.int32)
+    return NativePackedInputs(keys, matrices, counts, columns, valid, errors, lookup, meta, row_ends, restore)
+
+
+def grouped_dots(prepared):
+    import torch_npu
+    return torch_npu.npu_grouped_matmul([prepared.keys], [prepared.query_matrices],
+        group_list=prepared.group_lengths, group_type=0, group_list_type=1,
+        split_item=2, act_type=0, output_dtype=torch.float32)[0].masked_fill(~prepared.valid[:, None], 0)
+
+
+def reduce_runs(dots, weights, prepared, candidate_width):
+    """Consume the direct native map and propagate selector errors by row.
+
+    Existing FP32 GMM/head reductions and BF16-before-topk semantics remain.
+    This candidate still needs new device and actual full pipeline gates.
+    """
+    from deepinfer.npu_ops.indexer_weighted_gather_runtime910b import require_ready
+    require_ready()
+    rows = prepared.metadata_error.shape[0]
+    groups = prepared.group_lengths.shape[0] - 1
+    if groups <= 0 or groups % rows or prepared.lookup.shape != (groups, 128):
+        raise ValueError('Expected fixed native group lookup[G,128]')
+    if dots.ndim != 2 or dots.dtype != torch.float32 or dots.shape != (prepared.columns.shape[0], 32):
+        raise ValueError('Expected original packed FP32 dots[P,32]')
+    if weights.dtype != torch.float32 or weights.shape != (rows, 32) or weights.device != dots.device:
+        raise ValueError('Expected original FP32 query weights[Q,32]')
+    if candidate_width <= 0 or candidate_width % 8 or prepared.restore.shape != (rows, candidate_width):
+        raise ValueError('Expected original private8/16-token candidate domain and native restore')
+    runs = groups // rows
+    lengths = prepared.group_lengths[:-1].reshape(rows, runs)
+    error = prepared.metadata_error | (lengths > 128).any(1) | (lengths < 0).any(1)
+    native, errors128 = torch.ops.deepinfer_weighted_gather_r664.sum128(
+        dots, weights, prepared.columns, prepared.lookup, candidate_width)
+    one, errors1 = torch.ops.deepinfer_weighted_gather_r664.sum1(
+        dots, weights, prepared.columns, prepared.lookup, candidate_width)
+    kernel_error = errors128[:, 0].reshape(rows, runs * 16).bool().any(1)
+    kernel_error = kernel_error | errors1[:, 0].reshape(rows, runs).bool().any(1)
+    error = error | kernel_error
+    # Keep the original singleton/128-wide reduction choice and FP32 values.
+    # The selector uses the native direct map, avoiding both integer scatters.
+    scores, bf16, selector_flags = torch.ops.deepinfer_indexer_prepare_rows_r1264.select_scores(
+        native, one, prepared.group_lengths, prepared.restore, error)
+    selector_error = selector_flags[:, :, 0].bool().any(1)
+    error = error | selector_error
+    # Selector flags are part of the actual consumer contract: reject the
+    # complete affected row before top-k/source propagation, preserving others.
+    scores = scores.masked_fill(selector_error[:, None], -torch.inf)
+    bf16 = bf16.masked_fill(selector_error[:, None], -torch.inf)
+    return RunScores(scores, bf16, error)
diff --git a/deepinfer/npu_ops/indexer_paged_keys910b.py b/deepinfer/npu_ops/indexer_paged_keys910b.py
new file mode 100644
--- /dev/null
+++ b/deepinfer/npu_ops/indexer_paged_keys910b.py
@@ -0,0 +1,147 @@
+"""Task-local paged index-K descriptors; no numeric/NPU admission yet.
+
+Prepare immutable load maps from original CPU metadata once per forward.
+Scorers gather only their selected rows from a zero-copy allocation view.
+No whole-cache clone, compact-K materialization, or persistent key arena.
+"""
+from dataclasses import dataclass
+
+KEY_CAPACITY = 32768
+
+
+@dataclass(frozen=True)
+class LoadPlan:
+    segments: tuple
+    count: int
+
+    def __post_init__(self):
+        if type(self.segments) is not tuple or type(self.count) is not int:
+            raise TypeError("Immutable segments and integer logical K required")
+        if not 0 < self.count <= KEY_CAPACITY:
+            raise ValueError("Only nonempty bounded prefill loads are targeted")
+        covered = bytearray(self.count)
+        for segment in self.segments:
+            if type(segment) is not tuple or len(segment) != 4 or any(type(x) is not int for x in segment):
+                raise TypeError("Expected immutable integer block/begin/end/destination")
+            block, begin, end, dest = segment
+            if block < -1 or begin < 0 or end < begin or dest < 0 or dest + end - begin > self.count:
+                raise IndexError("Invalid compact load segment")
+            for row in range(dest, dest + end - begin):
+                if covered[row]:
+                    raise ValueError("Overlapping compact load destinations")
+                covered[row] = 1
+        if not all(covered):
+            raise ValueError("Paged indexer requires complete compact-K coverage")
+
+    def rows(self):
+        rows = [(-1, 0)] * KEY_CAPACITY
+        for block, begin, end, dest in self.segments:
+            rows[dest:dest + end - begin] = [(block, row) for row in range(begin, end)]
+        return rows
+
+    def validate_layout(self, blocks, page):
+        for block, begin, end, _ in self.segments:
+            if end > page or block >= blocks:
+                raise IndexError("Cache-load page or row outside physical allocation")
+
+
+def prepare_cpu_loads(metadata):
+    import torch
+    loads, counts = metadata.load_segments_ca, metadata.total_k_compressed
+    if loads is None or counts is None:
+        return {}
+    result = {}
+    for ratio, segments in loads.items():
+        count = counts[ratio]
+        if not 0 < count <= KEY_CAPACITY:
+            continue
+        if segments.device.type != "cpu":
+            raise ValueError("Prepare paged maps before metadata device transfer")
+        if segments.dtype != torch.int32 or segments.ndim != 2 or segments.shape[1] != 4:
+            raise ValueError("Expected original INT32 compact load segments")
+        result[ratio] = LoadPlan(tuple(tuple(row) for row in segments.tolist()), count)
+    return result
+
+
+@dataclass(frozen=True)
+class DeviceLoad:
+    host: LoadPlan
+    rows: object
+    count: object
+
+
+def transfer_loads(plans, device):
+    import torch
+    return {ratio: DeviceLoad(plan, torch.tensor(plan.rows(), dtype=torch.int64, device=device),
+                             torch.tensor(plan.count, dtype=torch.int32, device=device))
+            for ratio, plan in plans.items()}
+
+
+_GEOMETRY = {}
+
+
+class PagedKeySource:
+    def __init__(self, cache, load):
+        import torch
+        if cache.dtype != torch.bfloat16 or cache.ndim != 4 or tuple(cache.shape[2:]) != (1, 128):
+            raise ValueError("Only original BF16 single-head128 index cache is targeted")
+        if cache.device != load.rows.device or cache.device != load.count.device:
+            raise ValueError("Paged descriptor and cache device differ")
+        if cache.stride(-1) != 1 or cache.stride(0) <= 0 or cache.stride(1) <= 0:
+            raise ValueError("Expected positive strided cache rows with contiguous head")
+        if any(value % 128 for value in (cache.stride(0), cache.stride(1), cache.storage_offset())):
+            raise ValueError("Physical cache rows must align to original head128")
+        storage = cache.untyped_storage()
+        elements = storage.nbytes() // cache.element_size()
+        if elements % 128 or elements < 128:
+            raise ValueError("Cache allocation must contain complete physical rows")
+        load.host.validate_layout(cache.shape[0], cache.shape[1])
+        self.binding = (cache.device, cache.dtype, storage.data_ptr(), storage.nbytes())
+        self.physical = cache.as_strided((elements // 128, 128), (128, 1), storage_offset=0)
+        geometry = (cache.shape[0], cache.shape[1], cache.stride(0) // 128,
+                    cache.stride(1) // 128, cache.storage_offset() // 128)
+        last = geometry[4] + (geometry[0] - 1) * geometry[2] + (geometry[1] - 1) * geometry[3]
+        if not geometry[0] or not geometry[1] or not 0 <= last < self.physical.shape[0]:
+            raise IndexError("Strided index cache exceeds backing allocation")
+        key = (self.binding, geometry)
+        if key not in _GEOMETRY:
+            if len(_GEOMETRY) >= 256:
+                raise RuntimeError("Unexpected paged geometry growth; no unbounded metadata cache")
+            _GEOMETRY[key] = torch.tensor(geometry, dtype=torch.int64, device=cache.device)
+        self.geometry = _GEOMETRY[key]
+        self.load = load
+        self.shape = (load.host.count, 128)
+        self.device, self.dtype = cache.device, cache.dtype
+
+
+class PagedKeyView:
+    """Tensor-like read-only interface used only while constructing graph ops."""
+    def __init__(self, physical, rows, geometry, count, error):
+        self.physical, self.rows, self.geometry, self.count, self.error = physical, rows, geometry, count, error
+        self.shape, self.dtype, self.device = (KEY_CAPACITY, 128), physical.dtype, physical.device
+        self.ndim = 2
+        self.gathered_rows = 0
+
+    def index_select(self, dim, logical):
+        import torch
+        if dim != 0 or logical.ndim != 1:
+            raise ValueError("Only row index_select is supported")
+        # The physical view and geometry originate from PagedKeySource's
+        # host validation. The native operation validates each logical/map/
+        # physical address on device before reading any KV row.
+        logical = logical.to(torch.int64).contiguous()
+        result, flags = torch.ops.deepinfer_prefill_gather_r827.gather(
+            self.physical, self.rows, self.geometry, self.count, logical)
+        self.error.logical_or_(flags[:, 0].bool().any())
+        self.gathered_rows += logical.numel()
+        return result
+
+    def __getitem__(self, selected):
+        import torch
+        if not isinstance(selected, slice) or selected.step not in (None, 1):
+            raise ValueError("Only contiguous logical slices are supported")
+        start = 0 if selected.start is None else selected.start
+        stop = KEY_CAPACITY if selected.stop is None else selected.stop
+        if not 0 <= start <= stop <= KEY_CAPACITY:
+            raise IndexError("Logical index-K slice outside bounded domain")
+        return self.index_select(0, torch.arange(start, stop, dtype=torch.int64, device=self.device))
diff --git a/deepinfer/npu_ops/indexer_paged_prefill_graph910b.py b/deepinfer/npu_ops/indexer_paged_prefill_graph910b.py
