+++ b/deepinfer/npu_ops/whole_main_graph910b.py
@@ -0,0 +1,228 @@
+"""Experimental whole main forward, exact local one/two-sequence Q1..12 and EP16 only.
+
+Task-local opt-in until numerical, collective, model and memory gates pass.
+No eager fallback after a capture/replay failure. All ranks recapture their
+current local key together when any rank misses; retained outputs are cloned.
+This captures the main forward including DFlash main-cache updates, not the
+sampler or draft-model forward. It is not yet admitted or a speedup claim.
+"""
+from collections import defaultdict
+from dataclasses import fields,is_dataclass
+
+import torch
+import torch.distributed as dist
+
+from deepinfer.npu_ops.whole_main_context910b import tensor_body
+
+POSITION_BOUND=17418
+MAX_KEYS=24
+
+
+def tensor_spec(value):
+    return (tuple(value.shape),tuple(value.stride()),str(value.dtype),str(value.device))
+
+
+def tree_spec(value):
+    """Only declared metadata fields participate; derived attributes are outputs."""
+    if isinstance(value,torch.Tensor):return ('tensor',tensor_spec(value))
+    if is_dataclass(value):
+        return ('metadata',type(value).__module__,type(value).__qualname__,tuple((f.name,tree_spec(getattr(value,f.name))) for f in fields(value)))
+    if isinstance(value,dict):
+        return ('dict',tuple((key,tree_spec(item)) for key,item in sorted(value.items(),key=lambda row:repr(row[0]))))
+    if isinstance(value,(list,tuple)):
+        return (type(value).__name__,tuple(tree_spec(item) for item in value))
+    if value is None or type(value) in (bool,int,float,str):return ('scalar',type(value).__name__,value)
+    raise TypeError('Unsupported whole-main metadata leaf: '+type(value).__name__)
+
+
+def tensor_paths(value,path=()):
+    if isinstance(value,torch.Tensor):return [(path,value)]
+    result=[]
+    if is_dataclass(value):items=((f.name,getattr(value,f.name)) for f in fields(value))
+    elif isinstance(value,dict):items=value.items()
+    elif isinstance(value,(tuple,list)):items=enumerate(value)
+    else:return result
+    for key,item in items:result.extend(tensor_paths(item,path+(key,)))
+    return result
+
+
+def at_path(value,path):
+    for key in path:value=getattr(value,key) if is_dataclass(value) else value[key]
+    return value
+
+
+def clone_tree(value):
+    if isinstance(value,torch.Tensor):return value.clone()
+    if isinstance(value,defaultdict):return defaultdict(value.default_factory,{k:clone_tree(v) for k,v in value.items()})
+    if isinstance(value,dict):return {k:clone_tree(v) for k,v in value.items()}
+    if isinstance(value,list):return [clone_tree(v) for v in value]
+    if isinstance(value,tuple):return tuple(clone_tree(v) for v in value)
+    if value is None or type(value) in (bool,int,float,str):return value
+    raise TypeError('Unsupported whole-main derived metadata output')
+
+
+def cache_signature(caches):
+    result=[]
+    for layer,cache in enumerate(caches.cache_list):
+        for f in fields(cache):
+            value=getattr(cache,f.name)
+            if isinstance(value,torch.Tensor):
+                result.append((layer,f.name,value.data_ptr(),value.storage_offset(),tensor_spec(value)))
+    return (id(caches),tuple(result))
+
+
+def prepare_engram(model,metadata):
+    """Same published host hash/table decoding, before metadata transfer/capture."""
+    inner=model.model
+    runtime=inner.engram_runtime
+    if runtime is None:return {}
+    if not runtime._modelslim or metadata.is_prompt or metadata.ngram_token_ids.device.type!='cpu':
+        raise ValueError('Whole-main Engram preparation requires CP1 ModelSlim CPU decode metadata')
+    constants=getattr(inner,'_910b_whole_hash_constants',None)
+    if constants is None:
+        constants=tuple(x.detach().cpu() for x in (inner.ngram_multipliers,inner.ngram_vocab_sizes,inner.ngram_offsets))
+        inner._910b_whole_hash_constants=constants
+    from deepinfer.npu_ops.engram910b import hash_ngrams
+    hashes=hash_ngrams(metadata.ngram_token_ids,*constants,getattr(metadata,'images_seq_mask',None))
+    # Resolve the original deferred hooks here; projection and gating stay in
+    # the main tensor body. Only small decoded rows move to the owning NPU.
+    return {layer:hook() for layer,hook in runtime.fetch(hashes).items()}
+
+
+def prepared_engram_hooks(metadata):
+    values=getattr(metadata,'_910b_whole_engram',None)
+    if values is None:raise RuntimeError('Whole-main forward is missing prepared Engram rows')
+    return {layer:(lambda value=value:value) for layer,value in values.items()}
+
+
+def local_key(metadata):
+    if getattr(metadata,'_910b_whole_host_error',None) is not None:
+        raise ValueError('Whole-main host preparation failed')
+    rows=metadata.positions.shape[0]
+    if metadata.is_prompt or metadata.num_reqs not in (1,2) or not metadata.num_reqs<=rows<=6*metadata.num_reqs:
+        raise ValueError('Whole-main candidate admits one/two local sequences, each Q1..6')
+    plan=getattr(metadata,'_910b_c2_plan',None)
+    if (plan is None or len(plan.groups)!=metadata.num_reqs or plan.rows!=rows
+            or len({group.slot for group in plan.groups})!=len(plan.groups)
+            or any(not 1<=len(group.incoming)<=6 for group in plan.groups)
+            or sum(len(group.incoming) for group in plan.groups)!=rows):
+        raise ValueError('Whole-main decode needs one validated C2 group per local sequence')
+    bound=getattr(metadata,'_910b_indexer_position_bound',None)
+    if bound is None or bound>POSITION_BOUND:
+        raise ValueError('Whole-main position bound exceeds the admitted indexer shape')
+    for name in metadata.get_clean_list():
+        if getattr(metadata,name) is not None:
+            raise ValueError('Whole-main inputs must precede derived attention metadata')
+    embeddings=getattr(metadata,'_910b_whole_engram',None)
+    if embeddings is None:raise ValueError('Whole-main inputs lack explicit Engram preparation')
+    for _,value in tensor_paths(metadata):
+        if value.device.type!='npu' or str(value.device)!=str(metadata.positions.device):
+            raise ValueError('Whole-main metadata must stay on its owning NPU')
+    for value in embeddings.values():
+        if value.device.type!='npu' or str(value.device)!=str(metadata.positions.device) or value.dtype!=torch.bfloat16 or value.shape[0]!=plan.rows:
+            raise ValueError('Whole-main Engram input layout changed')
+    for name in ('gate_force_random','gate_force_random_cp'):
+        value=getattr(metadata,name,None)
