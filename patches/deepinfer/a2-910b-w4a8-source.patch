@@ -0,0 +1,67 @@
+"""Task-local pre-load of pinned raw-dot/ReLU/weight/gather/reduction kernels, before model/graph execution."""
+import hashlib
+import os
+from pathlib import Path
+import torch
+
+_ARTIFACTS = {
+    'gather_bridge.so': '17d4323fff773ffdc6932cb13b7b9bc9bdb948e3e165553ddf42d459f1582e40',
+    'gather128.o': 'dc12d0f3eede101dfd251f4fcc0c457fd439a63079cb2858b358b6ee5c2d4c32',
+    'gather1.o': '3a0885d42b99adba3193475dddca219b83cdd73711fc14ef1844a83474642e2b',
+}
+_NATIVE_PREPARE_ARTIFACTS = {'deepinfer_indexer_prepare_rows_r1264.so': '4d8d31c4b460ae9af860ef54a4386132981f89170793d03916db6997a7d9278b', 'indexer_schedule_rows_r1264.o': '474da886ebd1c12085a60a893c7a66eed41d489090619334759b6c6710cb6c2d', 'indexer_gather_r722.o': 'c5f18858d0516ceece3ac1bfe0eda0c16a26e61df66b1999ba0879d864c3a70c', 'indexer_select_r760.o': '695a61fbe38d3a9dfab46ec3d495a3c3f4dcd8670c0a62cf3d585ca1685d8ef5'}
+_PREFILL_GATHER_ARTIFACTS = {'prefill_gather_bridge.so': 'edecd4cc090a7ad6347385415c55e76fa41c175e949317ab76ac8003c643ce7a', 'prefill_gather.o': '40dd95dea83fac75e660f6370141f186619cca13053239ea22aeaeb684290302'}
+_READY = set()
+_PYTHON_INVOCATIONS = 0
+
+
+def prepare_runtime():
+    # The known consumer has one ModelRunner loader thread per rank.
+    decode_enabled = os.environ.get('DEEPINFER_910B_INDEXER_DECODE_GRAPH') == '1'
+    paged_prefill_enabled = (os.environ.get('DEEPINFER_910B_INDEXER_PREFILL_GRAPH') == '1'
+                            and os.environ.get('DEEPINFER_910B_INDEXER_PAGED_GRAPH') == '1')
+    if not decode_enabled and not paged_prefill_enabled:
+        return
+    device = torch.npu.current_device()
+    if device in _READY:
+        return
+    directory = Path(__file__).resolve().parent / '_weighted_gather910b'
+    for name, digest in _ARTIFACTS.items():
+        if hashlib.sha256((directory / name).read_bytes()).hexdigest() != digest:
+            raise RuntimeError('Pinned indexer gather artifact changed: ' + name)
+    torch.ops.load_library(str(directory / 'gather_bridge.so'))
+    torch.ops.deepinfer_weighted_gather_r664.prepare(str(directory / 'gather128.o'), device)
+    torch.ops.deepinfer_weighted_gather_r664.prepare1(str(directory / 'gather1.o'), device)
+    # ModelRunner.load_model calls this before get_model or any graph capture.
+    # Keep the existing weighted kernels and preload all new native handles.
+    native_directory = Path(__file__).resolve().parent / '_native_prepare910b'
+    for name, digest in _NATIVE_PREPARE_ARTIFACTS.items():
+        if hashlib.sha256((native_directory / name).read_bytes()).hexdigest() != digest:
+            raise RuntimeError('Pinned indexer native preparation artifact changed: ' + name)
+    torch.ops.load_library(str(native_directory / 'deepinfer_indexer_prepare_rows_r1264.so'))
+    torch.ops.deepinfer_indexer_prepare_rows_r1264.prepare_schedule(str(native_directory / 'indexer_schedule_rows_r1264.o'), device)
+    torch.ops.deepinfer_indexer_prepare_rows_r1264.prepare_gather(str(native_directory / 'indexer_gather_r722.o'), device)
+    torch.ops.deepinfer_indexer_prepare_rows_r1264.prepare_select(str(native_directory / 'indexer_select_r760.o'), device)
+    prefill_directory = Path(__file__).resolve().parent / '_native_prefill_gather910b'
+    for name, digest in _PREFILL_GATHER_ARTIFACTS.items():
+        if hashlib.sha256((prefill_directory / name).read_bytes()).hexdigest() != digest:
+            raise RuntimeError('Pinned indexer prefill gather artifact changed: ' + name)
+    torch.ops.load_library(str(prefill_directory / 'prefill_gather_bridge.so'))
+    torch.ops.deepinfer_prefill_gather_r827.prepare(str(prefill_directory / 'prefill_gather.o'), device)
+    _READY.add(device)
+
+
+def require_ready():
+    global _PYTHON_INVOCATIONS
+    if torch.npu.current_device() not in _READY:
+        raise RuntimeError('Prepare indexer gather runtime in ModelRunner.load_model before capture')
+    # These are Python warmup/capture calls, never a count of device graph replays.
+    _PYTHON_INVOCATIONS += 1
+
+
+def runtime_stats():
+    return {'prepared_devices': sorted(_READY), 'artifacts': dict(_ARTIFACTS),
+            'python_invocations': _PYTHON_INVOCATIONS,
+            'native_prepare_artifacts': dict(_NATIVE_PREPARE_ARTIFACTS),
+            'prefill_gather_artifacts': dict(_PREFILL_GATHER_ARTIFACTS),
+            'scope': 'Pinned load identity/Python warmup-capture only, not device execution or replay proof'}
