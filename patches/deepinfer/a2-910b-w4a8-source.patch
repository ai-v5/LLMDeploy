+++ b/deepinfer/npu_ops/indexer_dense_scores910b.py
@@ -0,0 +1,33 @@
+"""Isolated dense decode score candidate, preserving the full output domain.
+
+max_tokens is an authoritative host-known per-forward bound, not a device
+read. No model consumer imports this yet. It reuses the admitted finite
+<=128 native run reducer; dense physical page runs cannot exceed128.
+"""
+import torch
+from deepinfer.npu_ops.indexer_packed_scores910b import prepare, grouped_dots
+from deepinfer.npu_ops.indexer_run_reduce910b import RunScores, reduce_runs
+
+
+def dense_scores(q,cache,weights,lengths,tables,active,max_tokens,score_width):
+    if not 0 <= max_tokens <= score_width or score_width <= 0:
+        raise ValueError('Dense bound must fit original configured score width')
+    # Model cache pages contain64 or128 compressed tokens.
+    if cache.ndim not in (3,4) or cache.shape[1] not in (64,128):
+        raise ValueError('This candidate admits64/128-token cache pages only')
+    rows=q.shape[0]
+    blocks=torch.arange(max(1,(max_tokens+7)//8),device=q.device,dtype=torch.int32)[None,:].expand(rows,-1).contiguous()
+    enabled=active.to(torch.bool)
+    invalid=enabled & ((lengths<0)|(lengths>max_tokens)|(lengths>score_width))
+    # Disable invalid rows before prepare can select any cache address.
+    prepared=prepare(q,cache,blocks,lengths,tables,8,max(1,(max_tokens+cache.shape[1]-1)//cache.shape[1]),
+                     rows*max_tokens+13,enabled & ~invalid)
+    prepared=prepared._replace(metadata_error=prepared.metadata_error|invalid)
+    width=blocks.shape[1]*8
+    result=reduce_runs(grouped_dots(prepared),weights,prepared,width)
+    if width < score_width:
+        padding=torch.full((rows,score_width-width),-torch.inf,device=q.device,dtype=torch.float32)
+        scores=torch.cat((result.fp32,padding),1)
+    else:
+        scores=result.fp32[:,:score_width]
+    return RunScores(scores,scores.bfloat16(),result.metadata_error)
diff --git a/deepinfer/npu_ops/indexer_device_schedule910b.py b/deepinfer/npu_ops/indexer_device_schedule910b.py
