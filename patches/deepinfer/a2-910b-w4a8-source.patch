+++ b/deepinfer/npu_ops/indexer_headsum_graph910b.py
@@ -0,0 +1,54 @@
+"""Task-local BS1 experiment: graph the unchanged per-page FP32 reduction.
+
+One forward thread owns these graphs. Outputs are borrowed: the decode caller
+must consume them on its current stream before the next call. No KV address,
+length, routing metadata, matmul, or top-k operation is captured here.
+"""
+import os
+import torch
+
+_ENABLED = os.environ.get("DEEPINFER_910B_INDEXER_HEADSUM_GRAPH") == "1"
+_MAX_GRAPHS = 32
+_GRAPHS = {}
+_WORKSPACES = {}
+_HITS = _MISSES = _FALLBACKS = 0
+
+
+def reference_head_sum(scores):
+    # Keep the reference contiguous [heads, columns] shape for every sum.
+    return torch.stack([score.contiguous().sum(0).bfloat16() for score in scores])
+
+
+@torch.inference_mode()
+def exact_head_sum(scores):
+    global _HITS, _MISSES, _FALLBACKS
+    if not (_ENABLED and scores.device.type == "npu" and scores.dtype == torch.float32
+            and scores.ndim == 3 and scores.is_contiguous() and scores.numel()
+            and scores.shape[0] <= 192 and scores.shape[1] <= 128 and scores.shape[2] <= 128):
+        _FALLBACKS += 1
+        return reference_head_sum(scores)
+    key = (scores.device, tuple(scores.shape))
+    graph = _GRAPHS.get(key)
+    if graph is None:
+        # Never evict a graph while device work may still reference its storage.
+        if sum(device == scores.device for device, shape in _GRAPHS) >= _MAX_GRAPHS:
+            _FALLBACKS += 1
+            return reference_head_sum(scores)
+        from deepinfer.npu_ops.main_decode_graph910b import FixedTensorGraph
+        if scores.device not in _WORKSPACES:
+            _WORKSPACES[scores.device] = (torch.npu.graph_pool_handle(), torch.npu.Stream(device=scores.device))
+        graph = FixedTensorGraph(reference_head_sum, (scores,), _WORKSPACES[scores.device])
+        _GRAPHS[key] = graph
+        _MISSES += 1
+    else:
+        _HITS += 1
+    return graph(scores)
+
+
+def head_sum_graph_stats():
+    return {"enabled": _ENABLED, "graphs": len(_GRAPHS), "limit_per_device": _MAX_GRAPHS,
+            "hits": _HITS, "misses": _MISSES, "fallbacks": _FALLBACKS,
+            "replays": sum(graph.replays for graph in _GRAPHS.values()),
+            "static_input_bytes": sum(value.numel() * value.element_size()
+                                      for graph in _GRAPHS.values() for value in graph.inputs),
+            "scope": "Pure per-page reduction only, borrowed output, not full indexer/model graph or measured speedup"}
diff --git a/deepinfer/npu_ops/indexer_packed_scores910b.py b/deepinfer/npu_ops/indexer_packed_scores910b.py
