+"""Tensor-only candidate prefill consumer, pending component/model admission.
+
+Retains the installed native full-tile scorer and original BF16 top-k/restore.
+Python loops in the unchanged scorer run at capture, not replay. This is a
+graph composition candidate, not a new fused CANN kernel or dense admission.
+"""
+import torch
+from deepinfer.npu_ops.indexer_candidate910b import prefill
+from deepinfer.npu_ops.topk910b import topk
+from deepinfer.model_executor.layers.tilelang_ops.candidate_blocks import (
+    get_candidate_compact_lens, restore_candidate_indices_inplace,
+)
+
+
+@torch.inference_mode()
+def execute(q, keys, weights, starts, ends, active, blocks, *, block_size, topk_tokens):
+    if q.ndim != 3 or keys.ndim != 2 or q.shape[-1] != keys.shape[-1]:
+        raise ValueError('Expected query[Q,H,D] and compact loaded keys[K,D]')
+    if not q.shape[0] or not keys.shape[0]:
+        raise ValueError('Empty queries/physical keys stay on the existing path')
+    if q.dtype != torch.bfloat16 or keys.dtype != torch.bfloat16:
+        raise ValueError('Preserve BF16 indexer inputs')
+    if block_size not in (8, 16) or blocks.dtype != torch.int32 or blocks.shape[1] % 8:
+        raise ValueError('Expected original aligned INT32 candidate layout')
+    if topk_tokens % 8 or topk_tokens < 8:
+        raise ValueError('Restore requires aligned output rows')
+    # Reject malformed active ranges on device, without an unsafe gather or
+    # CPU read inside capture. The caller checks the returned error outside it.
+    error = active & ((starts < 0) | (ends < starts) | (ends > keys.shape[0]))
+    enabled = active & ~error
+    safe_starts = starts.masked_fill(~enabled, 0)
+    safe_ends = ends.masked_fill(~enabled, 0)
+    lengths = (safe_ends - safe_starts).to(torch.int32)
+    compact_lens = get_candidate_compact_lens(blocks, lengths, block_size)
+    scores = prefill(q, keys, weights, safe_starts, safe_ends, keys.shape[0], blocks, block_size, enabled)
+    indices = topk(scores, topk_tokens, sorted=False, end=compact_lens,
+                   indices_type=torch.int32, sorted_index=True,
+                   idx_oob_fill_value=-1, return_value=False, inplace=True)[1]
+    restore_candidate_indices_inplace(indices, blocks, block_size, safe_starts)
+    return indices, error, compact_lens
