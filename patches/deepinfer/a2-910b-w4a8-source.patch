@@ -0,0 +1,55 @@
+"""Eager top-k retaining indexer masks, output buffers and logical offsets."""
+import torch
+
+
+def topk(input,topk,sorted=False,indices_type=torch.int64,*,end=None,sorted_index=False,
+         output_idx=None,output_idx_offset=None,idx_oob_fill_value=-1,return_value=True,inplace=False):
+    width=input.shape[-1]
+    if topk<0:raise ValueError('topk must be nonnegative')
+    if end is None:
+        lengths=torch.full(input.shape[:-1],width,dtype=torch.int64,device=input.device)
+    else:
+        lengths=end.long().reshape(input.shape[:-1]).clamp(0,width)
+    column=torch.arange(width,device=input.device)
+    # Only callers that own and consume their score scratch may opt into mutation.
+    if inplace and input.ndim == 2 and input.shape[0] > 32 and width > 32768:
+        # Keep the complete ranking domain and exact original element mask.
+        # Tensor operations remain in the captured graph; scratch is row-bounded.
+        values = input
+        for begin in range(0, input.shape[0], 32):
+            stop = min(begin + 32, input.shape[0])
+            mask = column >= lengths[begin:stop].unsqueeze(-1)
+            values[begin:stop].masked_fill_(mask, -torch.inf)
+            del mask
+    else:
+        mask=column>=lengths.unsqueeze(-1)
+        values=input.masked_fill_(mask,-torch.inf) if inplace else input.masked_fill(mask,-torch.inf)
+        del mask
+    count=min(topk,width)
+    if inplace and input.ndim==2 and input.shape[0]>32 and width>32768:
+        # Test smaller native row batches while keeping the full ranking domain.
+        pieces=[torch.topk(values[begin:begin+32],count,dim=-1,sorted=sorted)
+                for begin in range(0,input.shape[0],32)]
+        data=torch.cat([piece[0] for piece in pieces],dim=0)
+        index=torch.cat([piece[1] for piece in pieces],dim=0)
+        del pieces
+    else:
+        data,index=torch.topk(values,count,dim=-1,sorted=sorted)
+    valid=index<lengths.unsqueeze(-1)
+    if topk>count:
+        pad=(*input.shape[:-1],topk-count)
+        index=torch.cat((index,torch.zeros(pad,dtype=index.dtype,device=index.device)),-1)
+        valid=torch.cat((valid,torch.zeros(pad,dtype=torch.bool,device=index.device)),-1)
+        data=torch.cat((data,torch.full(pad,-torch.inf,dtype=data.dtype,device=data.device)),-1)
+    if sorted_index:
+        _,order=torch.sort(index.masked_fill(~valid,width+1).int(),dim=-1)
+        index=index.gather(-1,order);valid=valid.gather(-1,order);data=data.gather(-1,order)
+    if output_idx_offset is not None:
+        index=index+output_idx_offset.reshape(input.shape[:-1]).unsqueeze(-1)
+    index=index.masked_fill(~valid,idx_oob_fill_value).to(indices_type)
+    data=data.masked_fill(~valid,-torch.inf)
+    if output_idx is not None:
+        if output_idx.shape!=index.shape or output_idx.dtype!=indices_type:
+            raise ValueError('topk output index shape/dtype mismatch')
+        output_idx.copy_(index);index=output_idx
+    return (data if return_value else None),index
