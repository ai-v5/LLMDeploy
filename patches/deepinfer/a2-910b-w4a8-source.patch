diff --git a/deepinfer/hugging_face/modelslim_w4a8.py b/deepinfer/hugging_face/modelslim_w4a8.py
new file mode 100644
--- /dev/null
+++ b/deepinfer/hugging_face/modelslim_w4a8.py
@@ -0,0 +1,120 @@
+"""Read the mixed Ascend W4A8 product without changing its quantized tensors.
+
+The config declares W4A8, while the exporter's global description can still say
+W8A8. Individual descriptors are authoritative for each projection. Full-model
+coverage remains a separate mandatory gate; completed shards allow component
+diagnostics while the remaining download continues.
+"""
+from __future__ import annotations
+
+import json
+import struct
+from pathlib import Path, PurePosixPath
+
+import torch
+
+from deepinfer.hugging_face.modelslim_w8a8 import ModelSlimW8A8Checkpoint
+
+
+def _validate_engram_headers(text, headers):
+    layers = text.get('engram_layer_ids', [])
+    rows = text.get('engram_num_embeddings', [])
+    if len(layers) != len(rows) or text.get('engram_head_dim') != 256:
+        raise ValueError('Unsupported W4 product Engram table geometry')
+    for layer, count in zip(layers, rows):
+        prefix = f'layers.{layer}.engram.embed'
+        weight, scale = headers.get(prefix+'.weight', {}), headers.get(prefix+'.scale', {})
+        if weight.get('dtype') != 'I8' or weight.get('shape') != [count, 256]:
+            raise ValueError('Expected indexed W4 product INT8 Engram table')
+        if scale.get('dtype') != 'F32' or scale.get('shape') != [count, 8]:
+            raise ValueError('Expected original FP32/group32 W4 Engram scales')
+
+
+class ModelSlimW4A8Checkpoint(ModelSlimW8A8Checkpoint):
+    def __init__(self, root: str | Path) -> None:
+        self.root=Path(root)
+        config=json.loads((self.root/'config.json').read_text())
+        quant=config.get('quantization_config',{})
+        if quant.get('quant_method')!='ascend' or quant.get('model_quant_type')!='W4A8_DYNAMIC':
+            raise ValueError('Expected the Ascend W4A8 product config')
+        self.description=json.loads((self.root/'quant_model_description.json').read_text())
+        if not any(kind=='W4A8_DYNAMIC' and name.endswith('.weight') for name,kind in self.description.items()):
+            raise ValueError('The W4 product must declare actual W4 tensors')
+        self.weight_map=json.loads((self.root/'quant_model_weights.safetensors.index.json').read_text())['weight_map']
+        if not isinstance(self.weight_map,dict) or not self.weight_map:
+            raise ValueError('Expected a nonempty published weight index')
+        self.tensors={};self.headers={};self.incomplete_shards=[]
+        for shard in sorted(set(self.weight_map.values())):
+            if not isinstance(shard,str):raise ValueError('Invalid shard name')
+            relative=PurePosixPath(shard)
+            if relative.is_absolute() or '..' in relative.parts or '\\' in shard:
+                raise ValueError('Checkpoint index must use relative product paths')
+            path=self.root.joinpath(*relative.parts)
+            if not path.is_file():
+                self.incomplete_shards.append(shard)
+                continue
+            with path.open('rb') as stream:
+                raw=stream.read(8)
+                if len(raw)!=8:
+                    self.incomplete_shards.append(shard);continue
+                size=struct.unpack('<Q',raw)[0]
+                if not 2<=size<=64*1024*1024:raise ValueError('Invalid safetensors header')
+                raw=stream.read(size)
+            if len(raw)!=size:
+                self.incomplete_shards.append(shard);continue
+            header={k:v for k,v in json.loads(raw).items() if k!='__metadata__'}
+            if not header or path.stat().st_size!=8+size+max(v['data_offsets'][1] for v in header.values()):
+                self.incomplete_shards.append(shard);continue
+            for name,value in header.items():
+                if self.weight_map.get(name)!=shard:continue
+                if name in self.tensors:raise ValueError('Duplicate indexed tensor: '+name)
+                self.tensors[name]=path;self.headers[name]=value
+
+    def require_complete_coverage(self) -> None:
+        super().require_complete_coverage()
+        config = json.loads((self.root/'config.json').read_text())
+        _validate_engram_headers(config['text_config'], self.headers)
+
+    def projection_kind(self,prefix: str) -> str:
+        return self.description.get(prefix+'.weight','FLOAT')
+
+    def linear(self,prefix: str):
+        # Mixed ordinary/shared/MTP W8 projections retain the existing backend,
+        # with an explicit original-FP32 scale contract for this product.
+        for suffix in ('.weight_scale','.weight_offset'):
+            if self.headers.get(prefix+suffix,{}).get('dtype')!='F32':
+                raise ValueError('Expected original FP32 W8 scale/offset')
+        return super().linear(prefix)
+
+    def linear_w4(self,prefix: str):
+        suffixes=('weight','weight_scale','weight_offset','scale_bias')
+        for suffix in suffixes:
+            if self.description.get(prefix+'.'+suffix)!='W4A8_DYNAMIC':
+                raise ValueError('Missing W4 descriptor: '+prefix+'.'+suffix)
+        packed,scale,offset,bias=(self.tensor(prefix+'.'+suffix) for suffix in suffixes)
+        if packed.dtype!=torch.int8 or packed.ndim!=2:
+            raise ValueError('Expected packed INT8 [N/2,K] weight storage')
+        outputs=2*packed.shape[0]
+        if outputs%8 or packed.shape[1]<=0:
+            raise ValueError('Packed W4 projection dimensions changed')
+        if any(value.dtype!=torch.float32 for value in (scale,offset,bias)):
+            raise ValueError('W4 scale/offset/bias must retain original FP32')
+        if scale.shape!=(outputs,1) or offset.shape!=(outputs,1):
+            raise ValueError('W4 per-output scale/offset shape mismatch')
+        if bias.ndim!=2 or bias.shape[0]!=outputs or bias.shape[1] not in (1,16):
+            raise ValueError('Expected original W4 scale_bias partitions')
+        if not torch.isfinite(scale).all() or not (scale>0).all():
+            raise ValueError('Invalid W4 scale')
+        if not torch.isfinite(bias).all() or not torch.isfinite(offset).all() or offset.count_nonzero():
+            raise ValueError('Only the actual finite symmetric W4 product is supported')
+        return packed,scale.reshape(-1).contiguous(),bias
+
+    def require_complete_linear_coverage(self) -> None:
+        missing=[]
+        for name,kind in self.description.items():
+            if name.endswith('.weight') and kind in ('W8A8_DYNAMIC','W4A8_DYNAMIC'):
+                prefix=name.removesuffix('.weight')
+                suffixes=('weight','weight_scale','weight_offset','scale_bias') if kind=='W4A8_DYNAMIC' else ('weight','weight_scale','weight_offset')
+                missing.extend(prefix+'.'+suffix for suffix in suffixes if prefix+'.'+suffix not in self.tensors)
+        if self.incomplete_shards or missing:
+            raise ValueError(f'Incomplete W4 product: {len(self.incomplete_shards)} shards, {len(missing)} linear tensors')
