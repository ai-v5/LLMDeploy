+
+
+def agree(group,values,device):
+    """CPU synchronization belongs to the epoch boundary, never the tensor body."""
+    state=torch.tensor(values,dtype=torch.int64,device=device)
+    dist.all_reduce(state,op=dist.ReduceOp.MAX,group=group)
+    from deepinfer.utils import allow_cuda_sync
+    with allow_cuda_sync():return state.cpu().tolist()
+
+
+class CapturedMain:
+    def __init__(self,owner,metadata):
+        self.owner=owner
+        self.input_spec=tree_spec(metadata)
+        self.metadata=metadata.recursive_fn(lambda value:value.clone())
+        self.bindings=[(path,at_path(self.metadata,path)) for path,_ in tensor_paths(metadata)]
+        self.metadata._910b_c2_plan=metadata._910b_c2_plan
+        self.metadata._910b_c2_descriptors=tuple(x.clone() for x in metadata._910b_c2_descriptors)
+        self.metadata._910b_whole_engram={k:v.clone() for k,v in metadata._910b_whole_engram.items()}
+        self.metadata._910b_indexer_position_bound=POSITION_BOUND
+        self.metadata._910b_indexer_error=owner.error
+        self.clean_names=tuple(metadata.get_clean_list())
+        self.graph=None;self.output=None;self.replays=0
+
+    def copy_inputs(self,metadata):
+        if tree_spec(metadata)!=self.input_spec:raise ValueError('Whole-main input schema changed')
+        if metadata._910b_c2_plan.shape_key!=self.metadata._910b_c2_plan.shape_key:
+            raise ValueError('Whole-main C2 compression batch geometry changed')
+        for path,destination in self.bindings:destination.copy_(at_path(metadata,path))
+        for destination,value in zip(self.metadata._910b_c2_descriptors,metadata._910b_c2_descriptors):destination.copy_(value)
+        for layer,destination in self.metadata._910b_whole_engram.items():destination.copy_(metadata._910b_whole_engram[layer])
+
+    def body(self):
+        # Warmup must not hide metadata expansion nodes from the capture.
+        for name in self.clean_names:setattr(self.metadata,name,None)
+        self.owner.error.zero_()
+        with tensor_body(self.owner.error):
+            return self.owner.model(kv_caches=self.owner.caches,input_metadata=self.metadata)
+
+    def capture(self):
+        stream=self.owner.stream
+        stream.wait_stream(torch.npu.current_stream())
+        for _ in range(2):
+            with torch.npu.stream(stream):self.body()
+            stream.synchronize()
+            self.owner.check_error()
+        self.graph=torch.npu.NPUGraph()
+        with torch.npu.graph(self.graph,pool=self.owner.pool,stream=stream):self.output=self.body()
+        torch.npu.current_stream().wait_stream(stream)
+
+    def replay(self,metadata):
+        self.copy_inputs(metadata)
+        self.graph.replay();self.replays+=1
+        self.owner.check_error()
+        # Sampler/DFlash consumers retain their own metadata/output snapshots;
+        # another key or owner can immediately reuse the whole-main pool.
+        for name in self.clean_names:setattr(metadata,name,clone_tree(getattr(self.metadata,name)))
+        metadata._910b_indexer_error=self.owner.error
+        return type(self.output)(hidden_states=self.output.hidden_states.clone())
+
+
+class WholeMainRunner:
+    def __init__(self,model,caches,group,device):
+        self.model,self.caches,self.group=model,caches,group
+        self.cache_identity=cache_signature(caches)
+        self.error=torch.zeros((),dtype=torch.bool,device=device)
+        self.pool=torch.npu.graph_pool_handle();self.stream=torch.npu.Stream(device=device)
+        self.graphs={};self.captures=0;self.recaptures=0;self.replays=0
+
+    def check_error(self):
+        flag=self.error.to(torch.int64)
+        dist.all_reduce(flag,op=dist.ReduceOp.MAX,group=self.group)
+        from deepinfer.utils import allow_cuda_sync
+        with allow_cuda_sync():invalid=bool(flag.item())
+        if invalid:raise ValueError('Whole-main graph rejected metadata on at least one EP rank')
+
+    @torch.inference_mode()
+    def __call__(self,metadata,caches):
+        error=None;key=None
+        try:
+            key=local_key(metadata)
+            if cache_signature(caches)!=self.cache_identity:raise ValueError('Current external KV/state storage changed')
+            if key not in self.graphs and len(self.graphs)>=MAX_KEYS:raise ValueError('Whole-main shape cache limit reached')
+        except (TypeError,ValueError,AttributeError) as exception:error=exception
+        invalid,miss=agree(self.group,[int(error is not None),int(key not in self.graphs)],self.error.device)
+        if invalid:raise ValueError('Whole-main epoch admission failed on an EP rank') from error
+        if miss:
+            # Every rank performs exactly 2 warmups + 1 capture. Even an existing
+            # local key is recaptured when another rank misses; no mixed phases.
+            graph=CapturedMain(self,metadata)
+            graph.capture()
+            self.recaptures+=int(key in self.graphs)
+            self.graphs[key]=graph;self.captures+=1
+        result=self.graphs[key].replay(metadata)
+        self.replays+=1
+        return result
+
+    def stats(self):
+        return {'graphs':len(self.graphs),'captures':self.captures,'recaptures':self.recaptures,'replays':self.replays,
+                'scope':'Experimental main-forward graph,not sampler/draft;not admitted or measured performance'}
