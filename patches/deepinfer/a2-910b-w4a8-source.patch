+"""Task-local bounded dense/source graph inputs; untested model candidate.
+
+Share at most two graph entries per device across layer owners. The cache
+key includes the exact host plan and full logits width, not loaded-K length
+or owner. Graph pools may retain scratch beyond reachable entry storage;
+bounded key arenas are not a claim about total reserved HBM or savings.
+"""
+from collections import OrderedDict
+import torch
+from deepinfer.npu_ops.main_decode_graph910b import FixedTensorGraph
+from deepinfer.npu_ops.prefill_workspace910b import prefill_workspace
+from deepinfer.npu_ops.indexer_dense_prefill_graph910b import DensePrefill
+
+KEY_CAPACITY = 32768
+MAX_GRAPHS_PER_DEVICE = 2
+_DEVICES = {}
+
+
+class SharedDenseGraph:
+    def __init__(self, inputs, plan, max_len, topk_tokens, source_block_size, source_topk, workspace):
+        q, keys, weights, starts, ends, active = inputs
+        remaining = (q, weights, starts, ends, active)
+        self.specs = tuple((tuple(value.shape), value.dtype, value.device) for value in remaining)
+        self.key_spec = (keys.shape[1], keys.dtype, keys.device)
+        arena = keys.new_zeros((KEY_CAPACITY, keys.shape[1]))
+        arena[:keys.shape[0]].copy_(keys)
+        count = torch.full((), keys.shape[0], dtype=torch.int32, device=keys.device)
+        # Retain every pre-capture constant for the entire graph lifetime.
+        self.processor = DensePrefill(plan, key_capacity=KEY_CAPACITY, max_len=max_len,
+            topk_tokens=topk_tokens, device=q.device, source_block_size=source_block_size, source_topk=source_topk)
+        self.fixed = FixedTensorGraph(self.processor, (q,arena,weights,starts,ends,active,count), workspace)
+        self.replays = 0
+
+    @torch.inference_mode()
+    def __call__(self, *inputs):
+        q, keys, weights, starts, ends, active = inputs
+        remaining = (q, weights, starts, ends, active)
+        if tuple((tuple(value.shape), value.dtype, value.device) for value in remaining) != self.specs:
+            raise ValueError("Dense graph non-key input contract changed")
+        if keys.ndim != 2 or (keys.shape[1],keys.dtype,keys.device) != self.key_spec or not 0 < keys.shape[0] <= KEY_CAPACITY:
+            raise ValueError("Dense loaded-key prefix exceeds bounded arena")
+        static = self.fixed.inputs
+        static[0].copy_(q)
+        static[1][:keys.shape[0]].copy_(keys)
+        for target,value in zip(static[2:6],remaining[1:]):
+            target.copy_(value)
+        static[6].fill_(keys.shape[0])
+        self.fixed.graph.replay()
+        self.replays += 1
+        # Required before a later owner/cache entry reuses the shared pool.
+        return tuple(value.clone() for value in self.fixed.output)
+
+
+@torch.inference_mode()
+def call(inputs, *, plan, max_len, topk_tokens, source_block_size=0, source_topk=0):
+    q, keys, weights, starts, ends, active = inputs
+    if q.device.type != "npu" or q.ndim != 3 or q.shape[1:] != (32,128):
+        raise ValueError("Only the actual 32-head model NPU layout is targeted")
