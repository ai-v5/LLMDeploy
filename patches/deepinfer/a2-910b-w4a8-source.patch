+        "persistent_key_arena_bytes":sum(graph.fixed.inputs[1].numel()*graph.fixed.inputs[1].element_size()
+                                          for graph in state["graphs"].values()),
+        "scope":"Reachable storage and call-copy instrumentation only; excludes constructors/warmup/other transfers and retained graph-pool scratch. No model/fullpeak/HBM saving admission."}
