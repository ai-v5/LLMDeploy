+"""Task-local tensor-body scope; never silently discard deferred validation."""
+from contextlib import contextmanager
+
+_GATE = None
+
+
+def active():
+    return _GATE is not None
+
+
+def reject_if(condition):
+    """Accumulate a device predicate; the whole runner checks it collectively."""
+    if _GATE is None:
+        raise RuntimeError('Deferred validation requires an owning whole-main scope')
+    _GATE.logical_or_(condition.any())
+
+
+@contextmanager
+def tensor_body(gate):
+    global _GATE
+    if _GATE is not None:
+        raise RuntimeError('Nested whole-main tensor body is unsupported')
+    _GATE = gate
+    try:
+        yield
+    finally:
+        _GATE = None
diff --git a/deepinfer/npu_ops/whole_main_graph910b.py b/deepinfer/npu_ops/whole_main_graph910b.py
