--- /dev/null
+++ b/deepinfer/npu_ops/indexer_dense_prefill_graph910b.py
@@ -0,0 +1,121 @@
+"""Exact-shape dense/source prefill graph candidate, not model admitted.
+
+Keep native complete tiles for uniform starts, original FP32 bmm complete
+tiles for nonuniform starts, original compact partial matmul/reduction, and
+the full BF16 top-k domain. Device metadata must match the frozen host plan.
+Constants are allocated before capture; replay performs no host range reads.
+This composes existing operations; it is not a new fused CANN kernel.
+"""
+import torch
+from deepinfer.npu_ops.indexer910b import _scores
+from deepinfer.npu_ops.topk_owned_dense_rows910b import topk
+from deepinfer.npu_ops.candidate_block_prefix910b import candidate_block_max_prefix_scratch
+
+
+class DensePrefill:
+    def __init__(self, plan, *, key_capacity, max_len, topk_tokens, device,
+                 source_block_size=0, source_topk=0):
+        if key_capacity <= 0 or key_capacity > 32768 or max_len <= 0:
+            raise ValueError("Only bounded original prefill shapes are targeted")
+        if topk_tokens <= 0 or topk_tokens % 8:
+            raise ValueError("Expected original aligned token top-k")
+        if bool(source_block_size) != bool(source_topk):
+            raise ValueError("Incomplete source block configuration")
+        if source_block_size and (source_block_size <= 0 or source_topk <= 0
+                                 or source_topk > (max_len + source_block_size - 1) // source_block_size):
+            raise ValueError("Invalid source block top-k")
+        if any(active and (end > key_capacity or end - start > max_len)
+               for start, end, active in zip(plan.starts, plan.ends, plan.active)):
+            raise ValueError("Plan exceeds physical storage or full logits domain")
+        self.plan, self.key_capacity = plan, key_capacity
+        self.max_len, self.topk_tokens = max_len, topk_tokens
+        self.source_block_size, self.source_topk = source_block_size, source_topk
+        self.max_valid_length = max(plan.lengths, default=0)
+        self.expected_starts = torch.tensor(plan.starts, dtype=torch.int32, device=device)
+        self.expected_ends = torch.tensor(plan.ends, dtype=torch.int32, device=device)
+        self.expected_active = torch.tensor(plan.active, dtype=torch.bool, device=device)
+        self.tiles = []
+        rows = len(plan.starts)
+        step = 32 if plan.uniform_starts else 8
+        for begin in range(0, rows, step):
+            stop = min(begin + step, rows)
+            lengths = plan.lengths[begin:stop]
+            for offset in range(0, max(lengths, default=0), 4096):
+                count = min(4096, max(lengths) - offset)
+                counts = tuple(max(0, min(4096, length - offset)) for length in lengths)
+                complete = torch.tensor([value == 4096 for value in counts], dtype=torch.bool, device=device)
+                addresses = None
+                if not plan.uniform_starts and count == 4096:
+                    host_addresses = [[plan.starts[begin + row] + offset + column if column < size else 0
+                                       for column in range(count)] for row, size in enumerate(counts)]
+                    addresses = torch.tensor(host_addresses, dtype=torch.int64, device=device)
+                partial = []
+                for row, size in enumerate(counts):
+                    if 0 < size < 4096:
+                        selected = None if plan.uniform_starts else torch.arange(
+                            plan.starts[begin + row] + offset, plan.starts[begin + row] + offset + size,
+                            dtype=torch.int64, device=device)
+                        partial.append((row, size, selected))
+                self.tiles.append((begin, stop, offset, count, counts, complete, addresses, tuple(partial)))
+
+    def scores(self, q, keys, weights):
+        import torch_npu
+        output = torch.full((q.shape[0], self.max_len), -torch.inf, dtype=torch.bfloat16, device=q.device)
+        for begin, stop, offset, count, counts, complete, addresses, partial in self.tiles:
+            if self.plan.uniform_starts:
+                base = self.plan.starts[0]
+                if 4096 in counts:
+                    query = torch.where(complete[:, None, None], q[begin:stop], 0)
+                    head_weights = torch.where(complete[:, None], weights[begin:stop], 0)
+                    index, values = torch_npu.npu_lightning_indexer(
+                        query[None], keys[base + offset:base + offset + 4096][None, :, None], head_weights[None],
+                        layout_query="BSND", layout_key="BSND", sparse_count=4096, sparse_mode=0, return_value=True)
+                    index, values = index.reshape(stop - begin, 4096), values.reshape(stop - begin, 4096)
+                    values = torch.empty_like(values).scatter_(1, index.long(), values)
+                    output[begin:stop, offset:offset + 4096].copy_(values.masked_fill(~complete[:, None], -torch.inf))
+                for row, size, _ in partial:
+                    selected = keys[base + offset:base + offset + size].contiguous()
+                    output[begin + row, offset:offset + size] = _scores(q[begin + row], selected, weights[begin + row])
+            else:
+                weighted = None
+                if count == 4096:
+                    selected = keys.index_select(0, addresses.flatten())
+                    selected = selected.reshape(stop - begin, count, keys.shape[-1]).float()
+                    weighted = torch.bmm(q[begin:stop].float(), selected.transpose(1, 2)).relu() * weights[begin:stop].float().unsqueeze(-1)
+                for row, size in enumerate(counts):
+                    if size == 4096:
+                        output[begin + row, offset:offset + size] = weighted[row].contiguous().sum(0).bfloat16()
+                for row, size, addresses_partial in partial:
+                    selected = keys.index_select(0, addresses_partial)
+                    output[begin + row, offset:offset + size] = _scores(q[begin + row], selected, weights[begin + row])
+        return output
+
+    @torch.inference_mode()
+    def __call__(self, q, keys, weights, starts, ends, active, logical_key_count):
+        rows = len(self.plan.starts)
+        if q.shape != (rows, 32, 128) or keys.shape != (self.key_capacity, 128) or weights.shape != (rows, 32):
+            raise ValueError("Exact actual-model tensor layout required")
+        if q.dtype != torch.bfloat16 or keys.dtype != torch.bfloat16:
+            raise ValueError("Preserve BF16 indexer inputs")
+        if starts.shape != (rows,) or ends.shape != (rows,) or active.shape != (rows,) or logical_key_count.numel() != 1:
+            raise ValueError("Query-aligned metadata and scalar logical K required")
+        error = ((starts != self.expected_starts) | (ends != self.expected_ends)
+                 | (active != self.expected_active)
+                 | (active & ((starts < 0) | (ends < starts) | (ends > logical_key_count)))
+                 | (logical_key_count < 0) | (logical_key_count > self.key_capacity))
+        lengths = (ends - starts).to(torch.int32).masked_fill(~active, 0)
+        scores = self.scores(q, keys, weights)
+        if self.source_topk:
+            block_scores, valid_blocks, source_error = candidate_block_max_prefix_scratch(
+                scores, lengths, self.source_block_size, max_valid_length=self.max_valid_length)
+            error.logical_or_(source_error)
+            blocks = topk(block_scores, self.source_topk, sorted=False, end=valid_blocks,
+                          indices_type=torch.int32, sorted_index=True, idx_oob_fill_value=-1, return_value=False)[1]
+            blocks.masked_fill_(error[:, None], -1)
+        else:
+            blocks = torch.empty((rows, 0), dtype=torch.int32, device=q.device)
+        indices = topk(scores, self.topk_tokens, sorted=False, end=lengths,
+                       indices_type=torch.int32, sorted_index=True, output_idx_offset=starts,
+                       idx_oob_fill_value=-1, return_value=False, inplace=True)[1]
+        indices.masked_fill_(error[:, None], -1)
+        return indices, error, blocks
diff --git a/deepinfer/npu_ops/indexer_dense_scores910b.py b/deepinfer/npu_ops/indexer_dense_scores910b.py
