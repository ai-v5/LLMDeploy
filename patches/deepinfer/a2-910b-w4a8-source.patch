+"""Unpromoted task-local resident grouped expert candidate for 910B.
+
+Load the final merged gate/up and down storage directly, one CPU projection
+at a time. No per-expert NPU projection storage or full-model conversion copy.
+Raw grouped arithmetic has separate unmerged-shape evidence; this merged-N,
+unified-quant and capacity-tail candidate still needs its own actual gates.
+"""
+from __future__ import annotations
+
+import torch
+from torch import nn
+
+
+class ResidentGroupedW8A8(nn.Module):
+    def __init__(self, checkpoint, prefix, expert_ids, *, hidden_size,
+                 intermediate_size, swiglu_limit, device):
+        super().__init__()
+        self.expert_ids = tuple(expert_ids)
+        if not self.expert_ids or self.expert_ids != tuple(range(self.expert_ids[0], self.expert_ids[0] + len(self.expert_ids))):
+            raise ValueError('Grouped experts need contiguous owner IDs')
+        if (hidden_size, intermediate_size) != (5120, 2304) or swiglu_limit <= 0:
+            raise ValueError('Only the pinned 5120/2304 projection arithmetic contract is admitted')
+        self.hidden_size = hidden_size
+        self.intermediate_size = intermediate_size
+        self.swiglu_limit = swiglu_limit
+        self.offload = False
+        device = torch.device(device)
+        if device.type != 'npu':
+            raise ValueError('Expert storage must be resident NPU HBM')
+        count = len(self.expert_ids)
+        self.register_buffer('w13', torch.empty((count, hidden_size, 2 * intermediate_size), dtype=torch.int8, device=device), persistent=False)
+        self.register_buffer('w2', torch.empty((count, intermediate_size, hidden_size), dtype=torch.int8, device=device), persistent=False)
+        self.register_buffer('scale13_fp32', torch.empty((count, 2 * intermediate_size), dtype=torch.float32, device=device), persistent=False)
+        self.register_buffer('scale2_fp32', torch.empty((count, hidden_size), dtype=torch.float32, device=device), persistent=False)
+        # Only the checkpoint's CPU projection and its bounded transfer temporaries
+        # coexist with the final resident buffers. No W8A8Linear expert is built.
+        with torch.inference_mode():
+            for index, expert_id in enumerate(self.expert_ids):
+                for part in ('w1', 'w3', 'w2'):
+                    weight, scale = checkpoint.linear(f'{prefix}.experts.{expert_id}.{part}')
+                    if part == 'w2':
+                        expected_shape = (hidden_size, intermediate_size)
+                        destination = self.w2[index]
+                        canonical_scale = self.scale2_fp32[index]
+                    else:
+                        expected_shape = (intermediate_size, hidden_size)
+                        begin = 0 if part == 'w1' else intermediate_size
+                        destination = self.w13[index, :, begin:begin + intermediate_size]
+                        canonical_scale = self.scale13_fp32[index, begin:begin + intermediate_size]
+                    if weight.shape != expected_shape or scale.shape != (expected_shape[0],):
+                        raise ValueError('Checkpoint expert projection dimensions changed')
+                    destination.copy_(weight.t())
+                    canonical_scale.copy_(scale)
+                    del weight, scale
+        self.loaded_storage = tuple((name, value.data_ptr(), value.numel() * value.element_size()) for name, value in self.named_buffers())
+
+    def resident_tensors(self):
+        return tuple(self.named_buffers())
+
+    def _dequantize(self, accumulator, channel_scales, token_scales, counts, *, gate_up, arithmetic_counts=None):
+        # This rule belongs to the pinned reference's original individual
+        # projection dimensions, even when w1/w3 share a wider integer GMM.
+        positions = torch.arange(accumulator.shape[0], device=accumulator.device, dtype=torch.int64)
+        active = positions < counts.sum()
+        owners = torch.bucketize(positions, counts.cumsum(0), right=True).clamp_max(len(self.expert_ids) - 1)
+        expert_rows = (counts if arithmetic_counts is None else arithmetic_counts).index_select(0, owners)
+        scale_first = ((expert_rows <= 169) | (expert_rows == 171) | (expert_rows == 191) | (expert_rows == 192)) if gate_up else expert_rows <= 161
+        scales = channel_scales.index_select(0, owners)
+        safe_token_scales = token_scales.masked_fill(~active, 0)
+        accumulator.masked_fill_(~active[:, None], 0)
+        weight_first = accumulator.float().mul_(scales).mul_(safe_token_scales[:, None])
+        product_first = accumulator.float() * (scales * safe_token_scales[:, None])
+        return torch.where(scale_first[:, None], product_first, weight_first).bfloat16().masked_fill_(~active[:, None], 0)
+
+    @torch.inference_mode()
+    def forward(self, codes, token_scale, counts, *, arithmetic_counts=None):
+        if arithmetic_counts is None:
+            arithmetic_counts = counts
+        elif (arithmetic_counts.shape != counts.shape or arithmetic_counts.dtype != torch.int64
+              or arithmetic_counts.device != counts.device):
+            raise ValueError('Arithmetic expert counts must match the owner count tensor')
+        if codes.shape[0] <= 1024:
+            return self._chunk(codes, token_scale, counts, arithmetic_counts)
+        output = codes.new_empty((codes.shape[0], self.hidden_size), dtype=torch.bfloat16)
+        ends = counts.cumsum(0)
+        starts = ends - counts
+        for begin in range(0, codes.shape[0], 1024):
+            stop = min(begin + 1024, codes.shape[0])
+            local_counts = (ends.clamp(max=stop) - starts.clamp(min=begin)).clamp(min=0)
+            output[begin:stop].copy_(self._chunk(codes[begin:stop], token_scale[begin:stop], local_counts, arithmetic_counts))
+        return output
+
+    def _chunk(self, codes, token_scale, counts, arithmetic_counts):
+        import torch_npu
+        if codes.ndim != 2 or codes.shape[1] != self.hidden_size or codes.dtype != torch.int8:
+            raise ValueError('Expected grouped INT8 [capacity, hidden] activations')
+        if token_scale.shape != (codes.shape[0],) or token_scale.dtype != torch.float32:
+            raise ValueError('Expected one FP32 input scale per capacity row')
+        if counts.shape != (len(self.expert_ids),) or counts.dtype != torch.int64:
+            raise ValueError('Expected device-side INT64 expert counts')
+        if any(value.device != self.w13.device for value in (codes, token_scale, counts)):
+            raise ValueError('Grouped tensors must stay on the owning NPU')
+        if codes.shape[0] == 0:
+            return codes.new_empty((0, self.hidden_size), dtype=torch.bfloat16)
+        # MC2 returns a fixed capacity. Kernels only own sum(counts) sorted rows;
+        # sanitize the unused tail before activation quantization and on output.
+        gate_up_int32 = torch_npu.npu_grouped_matmul([codes], [self.w13], group_list=counts, group_type=0, group_list_type=1, split_item=2, act_type=0, output_dtype=torch.int32)[0]
+        gate_up = self._dequantize(gate_up_int32, self.scale13_fp32, token_scale, counts, gate_up=True, arithmetic_counts=arithmetic_counts)
+        del gate_up_int32
+        gate, up = gate_up.split(self.intermediate_size, dim=-1)
+        hidden = torch_npu.npu_swiglu(torch.cat((gate.clamp(max=self.swiglu_limit), up.clamp(min=-self.swiglu_limit, max=self.swiglu_limit)), dim=-1))
+        down_codes, down_scales = torch_npu.npu_dynamic_quant(hidden, dst_type=torch.int8)
+        output_int32 = torch_npu.npu_grouped_matmul([down_codes], [self.w2], group_list=counts, group_type=0, group_list_type=1, split_item=2, act_type=0, output_dtype=torch.int32)[0]
+        return self._dequantize(output_int32, self.scale2_fp32, down_scales, counts, gate_up=False, arithmetic_counts=arithmetic_counts)
