+"""Bounded shared input storage candidate; not component/model admitted.
+
+One graph cache per device serves all candidate indexer owners. The bounded
+key arena receives only the live loaded-key prefix; graphs never hold an
+owner's loaded key tensor. Outputs are cloned before another owner can replay
+the shared pool. These storage/lifetime claims still require actual testing.
+"""
+from collections import OrderedDict
+import torch
+from deepinfer.npu_ops.main_decode_graph910b import FixedTensorGraph
+from deepinfer.npu_ops.prefill_workspace910b import prefill_workspace
+from deepinfer.npu_ops.indexer_candidate_prefill_graph910b import execute
+
+KEY_CAPACITY = 32768
+MAX_GRAPHS_PER_DEVICE = 2
+_DEVICES = {}
+
+
+def _function(block_size, topk_tokens, q, key_arena, weights, starts, ends, active, blocks, key_count):
+    invalid = active & ((starts < 0) | (ends < starts) | (ends > key_count))
+    indices, error, compact_lens = execute(q,key_arena,weights,starts,ends,active & ~invalid,blocks,
+                                         block_size=block_size,topk_tokens=topk_tokens)
+    return indices, error | invalid, compact_lens
+
+
+class SharedCandidateGraph:
+    def __init__(self, inputs, block_size, topk_tokens, workspace):
+        q,keys,weights,starts,ends,active,blocks = inputs
+        self.specs = tuple((tuple(value.shape),value.dtype,value.device) for value in (q,weights,starts,ends,active,blocks))
+        self.key_spec = (keys.shape[1],keys.dtype,keys.device)
+        # Constructor-only temporary; FixedTensorGraph takes the lasting copy.
+        # All layers reuse this graph rather than allocating one per owner.
+        arena = keys.new_zeros((KEY_CAPACITY,keys.shape[1]))
+        arena[:keys.shape[0]].copy_(keys)
+        count = torch.full((),keys.shape[0],dtype=torch.int32,device=keys.device)
+        examples = (q,arena,weights,starts,ends,active,blocks,count)
+        def function(*values): return _function(block_size,topk_tokens,*values)
+        self.fixed = FixedTensorGraph(function,examples,workspace)
+        self.replays = 0
+
+    @torch.inference_mode()
+    def __call__(self, *inputs):
+        q,keys,weights,starts,ends,active,blocks = inputs
+        remaining = (q,weights,starts,ends,active,blocks)
+        if tuple((tuple(value.shape),value.dtype,value.device) for value in remaining) != self.specs:
+            raise ValueError('Shared candidate graph non-key inputs changed shape/dtype/device')
+        if keys.ndim != 2 or (keys.shape[1],keys.dtype,keys.device) != self.key_spec or not 0 < keys.shape[0] <= KEY_CAPACITY:
+            raise ValueError('Loaded key prefix is outside the bounded graph input contract')
+        static = self.fixed.inputs
+        static[0].copy_(q)
+        static[1][:keys.shape[0]].copy_(keys)
+        for target,value in zip(static[2:7],remaining[1:]): target.copy_(value)
+        static[7].fill_(keys.shape[0])
+        self.fixed.graph.replay()
+        self.replays += 1
+        # The same graph/pool is reused by later owners in one forward thread.
+        return tuple(value.clone() for value in self.fixed.output)
+
+
+@torch.inference_mode()
+def call(inputs, *, block_size, topk_tokens):
+    q,keys,weights,starts,ends,active,blocks = inputs
+    if q.device.type != 'npu' or not 0 < keys.shape[0] <= KEY_CAPACITY:
+        raise ValueError('This task-local candidate is restricted to bounded NPU prefill')
+    if keys.ndim != 2 or keys.shape[-1] != 128 or q.ndim != 3 or q.shape[1:] != (32,128):
+        raise ValueError('Only the actual32-head/BF16 model indexer layout is targeted')
+    device = q.device
+    state = _DEVICES.get(device)
+    if state is None:
+        state = {'graphs':OrderedDict(),'workspace':prefill_workspace(device),
+                 'captures':0,'replays':0,'evictions':0,'key_copy_bytes':0}
+        _DEVICES[device] = state
+    key = (block_size,topk_tokens,(keys.shape[1],keys.dtype,keys.device),
+           tuple((tuple(value.shape),value.dtype,value.device) for value in (q,weights,starts,ends,active,blocks)))
+    graph = state['graphs'].get(key)
+    if graph is None:
+        if len(state['graphs']) >= MAX_GRAPHS_PER_DEVICE:
+            state['graphs'].popitem(last=False)
+            state['evictions'] += 1
+        graph = SharedCandidateGraph(inputs,block_size,topk_tokens,state['workspace'])
+        state['graphs'][key] = graph
+        state['captures'] += 1
+    state['graphs'].move_to_end(key)
+    result = graph(*inputs)
+    state['replays'] += 1
+    state['key_copy_bytes'] += keys.numel()*keys.element_size()
+    return result
+
+
+def stats(device):
+    state = _DEVICES.get(device)
+    if state is None: return {'graphs':0,'captures':0,'replays':0,'evictions':0,'key_copy_bytes':0}
+    return {name:state[name] for name in ['captures','replays','evictions','key_copy_bytes']} | {
+        'graphs':len(state['graphs']),
+        'persistent_key_arena_bytes':sum(graph.fixed.inputs[1].numel()*graph.fixed.inputs[1].element_size()
+                                         for graph in state['graphs'].values()),
+        'scope':'Task-local source candidate; no actual shared-storage/lifetime/model/memory/performance admission.'}
