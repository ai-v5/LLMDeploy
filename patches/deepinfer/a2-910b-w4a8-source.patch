+    if state is None:
+        state = {"graphs":OrderedDict(),"workspace":prefill_workspace(q.device),
+                 "captures":0,"replays":0,"evictions":0,"key_copy_bytes":0}
+        _DEVICES[q.device] = state
+    key = (plan,max_len,topk_tokens,source_block_size,source_topk,(keys.shape[1],keys.dtype,keys.device),
+           tuple((tuple(value.shape),value.dtype,value.device) for value in (q,weights,starts,ends,active)))
+    graph = state["graphs"].get(key)
+    if graph is None:
+        if len(state["graphs"]) >= MAX_GRAPHS_PER_DEVICE:
+            state["graphs"].popitem(last=False)
+            state["evictions"] += 1
+        graph = SharedDenseGraph(inputs,plan,max_len,topk_tokens,source_block_size,source_topk,state["workspace"])
+        state["graphs"][key] = graph
+        state["captures"] += 1
+    state["graphs"].move_to_end(key)
+    result = graph(*inputs)
+    state["replays"] += 1
+    state["key_copy_bytes"] += keys.numel()*keys.element_size()
+    return result
+
+
+def stats(device):
+    state = _DEVICES.get(device)
+    if state is None:
+        return {"graphs":0,"captures":0,"replays":0,"evictions":0,"key_copy_bytes":0,
+                "source_prefix_graphs":0,"source_prefix_bounds":[]}
+    constants = 0
+    for graph in state["graphs"].values():
