diff --git a/deepinfer/npu_ops/moe_decode_graph910b.py b/deepinfer/npu_ops/moe_decode_graph910b.py
new file mode 100644
--- /dev/null
+++ b/deepinfer/npu_ops/moe_decode_graph910b.py
@@ -0,0 +1,35 @@
+"""Experimental fixed-capacity MoE graph, not a whole-model graph.
+
+Task-local opt-in: enable only after exact EP16 component/model/memory gates.
+Before recipe promotion, either enable the validated path or remove the opt-in
+and candidate. No eager fallback after capture failure: ranks must not diverge.
+The model executes one forward thread. All MoE owners share one private pool
+per device; the caller clones real output rows before the next owner reuses it.
+"""
+from deepinfer.npu_ops.main_decode_graph910b import FixedTensorGraph
+
+_WORKSPACES = {}
+
+
+def moe_decode_graph_call(owner, function, *inputs):
+    import torch
+
+    # Dispatch, expert counts and communication metadata remain device data;
+    # no local-token shape chooses a different capture ordinal on each rank.
+    if len(inputs) != 4 or inputs[0].shape != (12, 5120):
+        raise ValueError('MoE graph requires the four fixed capacity12 tensors')
+    device = inputs[0].device
+    if device not in _WORKSPACES:
+        _WORKSPACES[device] = (torch.npu.graph_pool_handle(), torch.npu.Stream(device=device))
+    graph = owner.__dict__.get('_910b_moe_decode_graph')
+    if graph is None:
+        graph = FixedTensorGraph(function, inputs, _WORKSPACES[device])
+        owner.__dict__['_910b_moe_decode_graph'] = graph
+    return graph(*inputs)
+
+
+def moe_decode_graph_stats(model):
+    graphs = [module.__dict__.get('_910b_moe_decode_graph') for module in model.modules()]
+    graphs = [graph for graph in graphs if graph is not None]
+    return {'graphs': len(graphs), 'replays': sum(graph.replays for graph in graphs),
+            'scope': 'Fixed capacity12 native MC2 plus resident grouped MLP only; not main whole graph or measured speedup'}
diff --git a/deepinfer/npu_ops/moe_grouping910b.py b/deepinfer/npu_ops/moe_grouping910b.py
new file mode 100644
--- /dev/null
+++ b/deepinfer/npu_ops/moe_grouping910b.py
@@ -0,0 +1,76 @@
+"""Device-side local expert sorting/quantization and ordered FP32 combine.
+
+Local grouping is also useful after an activation AllGather. MC2 dispatch is a
+separate transport and supplies its own grouped rows/counts to the resident MLP.
+"""
+import torch
+
+
+@torch.inference_mode()
+def group_local(hidden, expert_ids, *, num_experts, expert_start, expert_end):
+    import torch_npu
+    if hidden.ndim != 2 or hidden.dtype != torch.bfloat16 or hidden.device.type != 'npu':
+        raise ValueError('Expected BF16 NPU [tokens, hidden] activations')
+    if expert_ids.ndim != 2 or expert_ids.shape[0] != hidden.shape[0] or expert_ids.device != hidden.device:
+        raise ValueError('Expected colocated [tokens, topk] routing IDs')
+    if expert_ids.dtype not in (torch.int32, torch.int64):
+        raise ValueError('Expert IDs must be integer tensors')
+    if not 0 <= expert_start < expert_end <= num_experts or expert_ids.shape[1] <= 0:
+        raise ValueError('Invalid fixed expert ownership or topk')
+    if hidden.shape[0] == 0:
+        return (hidden.new_empty((0, hidden.shape[1]), dtype=torch.int8),
+                hidden.new_empty((0,), dtype=torch.float32),
+                torch.zeros(expert_end - expert_start, device=hidden.device, dtype=torch.int64),
+                expert_ids.new_empty((0,), dtype=torch.int32))
+    token_codes, token_scales = torch_npu.npu_dynamic_quant(hidden, dst_type=torch.int8)
+    codes, rows, counts, _ = torch_npu.npu_moe_init_routing_v2(
+        token_codes, expert_ids.to(torch.int32), active_num=expert_ids.numel(),
+        expert_num=num_experts, expert_tokens_num_type=1,
+        expert_tokens_num_flag=True, active_expert_range=[expert_start, expert_end],
+        quant_mode=-1, row_idx_type=1)
+    counts = counts.to(torch.int64)
+    active = torch.arange(codes.shape[0], device=hidden.device) < counts.sum()
+    safe_rows = rows.masked_fill(~active, 0)
+    token_rows = torch.div(safe_rows.long(), expert_ids.shape[1], rounding_mode="floor")
+    scales = token_scales.index_select(0, token_rows).masked_fill(~active, 0)
+    codes.masked_fill_(~active[:, None], 0)
+    return codes, scales, counts, safe_rows
+
+
+@torch.inference_mode()
+def combine_local(grouped_output, route_ids, counts, expert_ids, scores):
+    if expert_ids.ndim != 2 or scores.shape != expert_ids.shape or scores.dtype != torch.float32:
+        raise ValueError('Expected original expert IDs and FP32 routing weights')
+    tokens, topk = expert_ids.shape
+    if grouped_output.ndim != 2 or grouped_output.dtype != torch.bfloat16 or route_ids.shape != (grouped_output.shape[0],):
+        raise ValueError('Expected capacity-sized grouped BF16 outputs and route IDs')
+    if len({x.device for x in (grouped_output, route_ids, counts, expert_ids, scores)}) != 1:
+        raise ValueError('Combine tensors must stay on the owning device')
+    if tokens == 0:
+        return grouped_output.new_zeros((0, grouped_output.shape[1]), dtype=torch.float32)
+    capacity, hidden = grouped_output.shape
+    result = grouped_output.new_zeros((tokens, hidden), dtype=torch.float32)
+    if capacity == 0:
+        return result
+    active = torch.arange(capacity, device=grouped_output.device) < counts.sum()
+    # Padding uses a private sentinel, so no inactive writer can erase route0.
+    sentinel = tokens * topk
+    safe_ids = route_ids.long().masked_fill(~active, sentinel)
+    source_rows = torch.arange(capacity, device=grouped_output.device, dtype=torch.int64)
+    inverse = torch.zeros(sentinel + 1, device=grouped_output.device, dtype=torch.int64)
+    present = torch.zeros(sentinel + 1, device=grouped_output.device, dtype=torch.bool)
+    inverse.scatter_(0, safe_ids, source_rows)
+    present.scatter_(0, safe_ids, active)
+    # Bound activation scratch by token chunks; never build [T*K,H] FP32.
+    for begin in range(0, tokens, 256):
+        stop = min(tokens, begin + 256)
+        flat = torch.arange(begin * topk, stop * topk, device=grouped_output.device)
+        selected = grouped_output.index_select(0, inverse.index_select(0, flat))
+        selected.masked_fill_(~present.index_select(0, flat)[:, None], 0)
+        selected = selected.reshape(stop - begin, topk, hidden)
+        order = torch.argsort(expert_ids[begin:stop].float(), dim=-1, stable=True)
+        ordered = selected.gather(1, order[:, :, None].expand(-1, -1, hidden))
+        weights = scores[begin:stop].gather(1, order)
+        for choice in range(topk):
+            result[begin:stop].add_(ordered[:, choice].float() * weights[:, choice, None])
+    return result
