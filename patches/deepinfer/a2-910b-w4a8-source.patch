+++ b/deepinfer/npu_ops/prefill_workspace910b.py
@@ -0,0 +1,30 @@
+"""One pool and stream for serial dense/source/candidate prefill graphs.
+
+Task-local candidate. Callers must clone every returned graph output before
+another owner reuses the pool. Decode and MoE keep their own workspaces.
+No arithmetic, graph cache, key arena or metadata contract changes here.
+"""
+import torch
+
+_WORKSPACES = {}
+
+
+def prefill_workspace(device):
+    if device.type != "npu" or device.index is None:
+        raise ValueError("An explicit owning NPU device is required")
+    workspace = _WORKSPACES.get(device)
+    if workspace is None:
+        workspace = (torch.npu.graph_pool_handle(), torch.npu.Stream(device=device))
+        _WORKSPACES[device] = workspace
+    return workspace
+
+
+def release_prefill_workspace(device):
+    """Retire the shared pool token after synchronized profile graph release.
+
+    A token alone does not keep an allocator pool live. After the last graph
+    releases it, a later capture must obtain a fresh token even when old graph
+    outputs still keep allocations alive. Existing graph owners remain valid.
+    The caller must synchronize and release its profile captures first.
+    """
+    return _WORKSPACES.pop(device, None) is not None
