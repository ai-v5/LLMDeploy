+"""Resident packed-INT4 grouped expert FFN for the pinned 910B W4 product.
+
+The native ModelSlim selector chooses this implementation for W4 routed
+experts. Integer codes never expand to persistent INT8 NPU weights. Native
+MSD rounding belongs to CANN; W8 INT32 dequantization rules do not apply here.
+"""
+from __future__ import annotations
+
+import torch
+from torch import nn
+
+
+class ResidentGroupedW4A8(nn.Module):
+    def __init__(self,checkpoint,prefix,expert_ids,*,hidden_size,intermediate_size,swiglu_limit,device):
+        super().__init__()
+        self.expert_ids=tuple(expert_ids)
+        if not self.expert_ids or self.expert_ids!=tuple(range(self.expert_ids[0],self.expert_ids[0]+len(self.expert_ids))):
+            raise ValueError('Grouped experts need contiguous owner IDs')
+        if (hidden_size,intermediate_size)!=(5120,2304) or swiglu_limit<=0:
+            raise ValueError('Only the pinned 5120/2304 W4 expert contract is supported')
+        self.hidden_size=hidden_size;self.intermediate_size=intermediate_size;self.swiglu_limit=swiglu_limit
+        self.offload=False;device=torch.device(device)
+        if device.type!='npu':raise ValueError('Packed experts must reside in owning NPU HBM')
+        count=len(self.expert_ids)
+        shapes={'w13':((count,hidden_size,2*intermediate_size//8),torch.int32),
+                'w2':((count,intermediate_size,hidden_size//8),torch.int32),
+                'scale13_fp32':((count,2*intermediate_size),torch.float32),
+                'scale2_fp32':((count,hidden_size),torch.float32),
+                'scale13_encoded':((count,1,2*intermediate_size),torch.int64),
+                'scale2_encoded':((count,1,hidden_size),torch.int64),
+                'bias13':((count,2*intermediate_size),torch.float32),
+                'bias2':((count,hidden_size),torch.float32)}
+        for name,(shape,dtype) in shapes.items():
+            self.register_buffer(name,torch.empty(shape,dtype=dtype,device=device),persistent=False)
+        with torch.inference_mode():
+            for index,expert_id in enumerate(self.expert_ids):
+                for part in ('w1','w3','w2'):
+                    packed,scale,bias=checkpoint.linear_w4(f'{prefix}.experts.{expert_id}.{part}')
+                    outputs,inputs=(hidden_size,intermediate_size) if part=='w2' else (intermediate_size,hidden_size)
+                    if packed.shape!=(outputs//2,inputs) or scale.shape!=(outputs,) or bias.shape!=(outputs,16 if part=='w2' else 1):
+                        raise ValueError('Actual packed W4 expert geometry changed')
+                    # Four packed bytes become one INT32, still eight INT4 codes.
+                    prepared=packed.t().contiguous().view(torch.int32)
+                    encoded=scale.view(torch.int32).to(torch.int64).bitwise_and_(0xffffffff)
+                    if part=='w2':
+                        self.w2[index].copy_(prepared);self.scale2_fp32[index].copy_(scale)
+                        self.scale2_encoded[index,0].copy_(encoded)
+                        # Same FP32 transpose/contiguous/sum axes as upstream TP1.
+                        parts=bias.unsqueeze(0).to(device)
+                        reduced=parts.transpose(1,2).contiguous().sum(dim=1).squeeze(0)
+                        self.bias2[index].copy_(reduced)
+                        del parts,reduced
+                    else:
+                        begin=0 if part=='w1' else intermediate_size
+                        self.w13[index,:,begin//8:(begin+outputs)//8].copy_(prepared)
+                        self.scale13_fp32[index,begin:begin+outputs].copy_(scale)
+                        self.scale13_encoded[index,0,begin:begin+outputs].copy_(encoded)
+                        self.bias13[index,begin:begin+outputs].copy_(bias[:,0])
+                    del packed,scale,bias,prepared,encoded
+        self.loaded_storage=tuple((name,value.data_ptr(),value.numel()*value.element_size()) for name,value in self.named_buffers())
+
+    def resident_tensors(self):
+        return tuple(self.named_buffers())
+
+    @torch.inference_mode()
+    def forward(self,codes,token_scale,counts,*,arithmetic_counts=None):
+        import torch_npu
+        if codes.dtype!=torch.int8 or codes.ndim!=2 or codes.shape[1]!=self.hidden_size:
+            raise ValueError('Expected grouped INT8 [capacity,hidden] codes')
+        if token_scale.dtype!=torch.float32 or token_scale.shape!=(codes.shape[0],):
+            raise ValueError('Expected original FP32 input scale per capacity row')
+        if counts.dtype!=torch.int64 or counts.shape!=(len(self.expert_ids),):
+            raise ValueError('Expected owning device INT64 expert counts')
+        if any(value.device!=self.w13.device for value in (codes,token_scale,counts)):
+            raise ValueError('Grouped inputs must stay on their owning NPU')
+        if arithmetic_counts is not None and (arithmetic_counts.shape!=counts.shape or arithmetic_counts.dtype!=counts.dtype or arithmetic_counts.device!=counts.device):
+            raise ValueError('Arithmetic expert counts must have the owner count contract')
+        # W4 native MSD uses its own rounding contract. The old W8 per-M
+        # dequantization-order selector must not alter these native results.
+        if codes.shape[0]==0:return codes.new_empty((0,self.hidden_size),dtype=torch.bfloat16)
+        active=torch.arange(codes.shape[0],device=codes.device,dtype=torch.int64)<counts.sum()
+        safe_scale=token_scale.masked_fill(~active,1)
+        # The ND A8W4 MSD preprocessor rewrites its INT8 input in place.
+        # Keep the caller's routing/quantization buffer immutable. The second
+        # GMM below consumes private down_codes produced inside this call.
+        gate_up=torch_npu.npu_grouped_matmul(x=[codes.clone()],weight=[self.w13],scale=[self.scale13_encoded],bias=[self.bias13],
+            per_token_scale=[safe_scale],group_list=counts,group_type=0,group_list_type=1,split_item=2,output_dtype=torch.bfloat16)[0]
+        gate_up.masked_fill_(~active[:,None],0)
+        gate,up=gate_up.split(self.intermediate_size,dim=-1)
+        hidden=torch_npu.npu_swiglu(torch.cat((gate.clamp(max=self.swiglu_limit),up.clamp(min=-self.swiglu_limit,max=self.swiglu_limit)),dim=-1))
+        down_codes,down_scale=torch_npu.npu_dynamic_quant(hidden,dst_type=torch.int8)
+        down_scale=down_scale.masked_fill(~active,1)
+        output=torch_npu.npu_grouped_matmul(x=[down_codes],weight=[self.w2],scale=[self.scale2_encoded],bias=[self.bias2],
+            per_token_scale=[down_scale],group_list=counts,group_type=0,group_list_type=1,split_item=2,output_dtype=torch.bfloat16)[0]
+        return output.masked_fill_(~active[:,None],0)
