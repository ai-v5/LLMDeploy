diff --git a/deepinfer/npu_ops/mc2_dispatch910b.py b/deepinfer/npu_ops/mc2_dispatch910b.py
new file mode 100644
--- /dev/null
+++ b/deepinfer/npu_ops/mc2_dispatch910b.py
@@ -0,0 +1,114 @@
+"""Unpromoted A2 EP16 MC2 candidate; no model consumer until actual gates pass.
+
+Use fixed equal capacity on every rank and a true-prefix token mask. Dispatch
+BF16 and quantize the sorted expert inputs using the resident MLP's existing
+dynamic-quant path. Native dispatch metadata is opaque to this wrapper.
+"""
+from __future__ import annotations
+
+from typing import NamedTuple
+
+import torch
+
+
+class MC2Metadata(NamedTuple):
+    sorted_ids: torch.Tensor
+    sorted_scores: torch.Tensor
+    active_mask: torch.Tensor
+    assist: torch.Tensor
+    ep_recv_counts: torch.Tensor
+    tp_recv_counts: torch.Tensor
+    expand_scales: torch.Tensor
+    original_tokens: int
+
+
+class MC2Dispatcher910B:
+    def __init__(self, group, *, num_experts, topk, capacity=12):
+        import torch.distributed as dist
+
+        if not dist.is_initialized():
+            raise ValueError('Initialize the owned HCCL group before MC2')
+        self.world = dist.get_world_size(group)
+        self.rank = dist.get_rank(group)
+        if self.world != 16 or (num_experts, topk) not in ((384, 6), (128, 3)):
+            raise ValueError('Only the checkpoint main384/K6 and MTP128/K3 EP16 contracts are admitted')
+        if capacity != 12:
+            raise ValueError('This decode candidate uses the same fixed capacity12 on all ranks')
+        self.num_experts, self.topk, self.capacity = num_experts, topk, capacity
+        self.local_experts = num_experts // self.world
+        self.start = self.rank * self.local_experts
+        self.group = group
+        self.comm_name = group._get_backend(torch.device('npu')).get_hccl_comm_name(self.rank)
+
+    def prepare_inputs(self, hidden, ids, scores):
+        """Pad before capture so every rank uses the same four tensor specs."""
+        n = hidden.shape[0]
+        if hidden.ndim != 2 or hidden.shape[1] != 5120 or not 0 <= n <= self.capacity:
+            raise ValueError('Expected zero to twelve decode tokens of hidden width5120')
+        if hidden.dtype != torch.bfloat16 or hidden.device.type != 'npu':
+            raise ValueError('BF16 activations must stay on NPU')
+        if ids.shape != (n, self.topk) or scores.shape != ids.shape:
+            raise ValueError('Routing width must match the checkpoint top-k')
+        if ids.dtype not in (torch.int32, torch.int64) or scores.dtype != torch.float32:
+            raise ValueError('Expected integer expert IDs and FP32 routing weights')
+        if ids.device != hidden.device or scores.device != hidden.device:
+            raise ValueError('Routing metadata must stay on the owning NPU')
+        # Padding stays outside capture; sorting real IDs and associated
+        # scores is in the fixed graph, preserving increasing-expert summation.
+        pad = self.capacity - n
+        padded_hidden = torch.cat((hidden, hidden.new_zeros((pad, 5120))))
+        padded_ids = torch.cat((ids.to(torch.int32), torch.arange(self.topk, device=hidden.device, dtype=torch.int32)[None].expand(pad, -1)))
+        padded_scores = torch.cat((scores, scores.new_zeros((pad, self.topk))))
+        active_mask = torch.arange(self.capacity, device=hidden.device) < n
+        return padded_hidden, padded_ids, padded_scores, active_mask
+
+    def dispatch(self, hidden, ids, scores):
+        n = hidden.shape[0]
+        expanded, counts, metadata = self.dispatch_prepared(*self.prepare_inputs(hidden, ids, scores))
+        return expanded, counts, metadata._replace(original_tokens=n)
+
+    def dispatch_prepared(self, padded_hidden, padded_ids, padded_scores, active_mask):
+        """Fixed-capacity tensor-only MC2 core; caller supplies a prefix mask."""
+        import torch_npu
+
+        device = padded_hidden.device
+        expected = (((self.capacity, 5120), torch.bfloat16),
+                    ((self.capacity, self.topk), torch.int32),
+                    ((self.capacity, self.topk), torch.float32),
+                    ((self.capacity,), torch.bool))
+        for value, (shape, dtype) in zip((padded_hidden, padded_ids, padded_scores, active_mask), expected):
+            if tuple(value.shape) != shape or value.dtype != dtype or value.device != device or device.type != 'npu':
+                raise ValueError('Prepared MC2 tensors must keep fixed capacity12, dtype and NPU')
+        order = padded_ids.float().argsort(dim=-1, stable=True)
+        padded_ids = padded_ids.gather(1, order)
+        padded_scores = padded_scores.gather(1, order)
+        expanded, dynamic_scale, assist, counts, ep_counts, tp_counts, expand_scales = torch_npu.npu_moe_distribute_dispatch_v2(
+            x=padded_hidden, expert_ids=padded_ids, group_ep=self.comm_name,
+            ep_world_size=self.world, ep_rank_id=self.rank,
+            moe_expert_num=self.num_experts, expert_shard_type=0,
+            shared_expert_rank_num=0, quant_mode=0, global_bs=0,
+            expert_token_nums_type=1, x_active_mask=active_mask,
+            comm_alg='fullmesh')
+        valid = torch.arange(expanded.shape[0], device=expanded.device) < counts.sum()
+        expanded = expanded.masked_fill(~valid[:, None], 0)
+        metadata = MC2Metadata(padded_ids, padded_scores, active_mask, assist,
+                               ep_counts, tp_counts, expand_scales, self.capacity)
+        return expanded, counts.to(torch.int64), metadata
+
+    def combine(self, expert_output, metadata):
+        import torch_npu
+
+        # Preserve all dispatch metadata byte-for-byte. A2 has no TP domain;
+        # don't invent tp_send_counts or an auxiliary TP communicator.
+        result = torch_npu.npu_moe_distribute_combine_v2(
+            expand_x=expert_output, expert_ids=metadata.sorted_ids,
+            assist_info_for_combine=metadata.assist,
+            ep_send_counts=metadata.ep_recv_counts,
+            expert_scales=metadata.sorted_scores, group_ep=self.comm_name,
+            ep_world_size=self.world, ep_rank_id=self.rank,
+            moe_expert_num=self.num_experts, expert_shard_type=0,
+            shared_expert_rank_num=0, global_bs=0,
+            x_active_mask=metadata.active_mask,
+            expand_scales=metadata.expand_scales,
+            comm_quant_mode=0, comm_alg='fullmesh')
+        return result[:metadata.original_tokens]
