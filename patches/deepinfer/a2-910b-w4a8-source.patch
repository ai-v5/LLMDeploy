--- /dev/null
+++ b/deepinfer/npu_ops/indexer_decode_graph910b.py
@@ -0,0 +1,155 @@
+"""Experimental model-only decode graph, pending consumer/model admission.
+
+The model's sorted unique candidate producer bounds runs to one cache page.
+General operator APIs retain their original implementation. The switch is
+task-local until correctness/HBM/performance gates decide enablement/removal.
+"""
+import os
+import torch
+from deepinfer.npu_ops.main_decode_graph910b import FixedTensorGraph
+from deepinfer.npu_ops.indexer_packed_scores910b import prepare,grouped_dots
+from deepinfer.npu_ops.indexer_run_reduce910b import reduce_runs
+from deepinfer.npu_ops.indexer_dense_scores910b import dense_scores
+from deepinfer.npu_ops.topk910b import topk
+from deepinfer.model_executor.layers.tilelang_ops.candidate_blocks import candidate_block_max,restore_candidate_indices_inplace
+from deepinfer.model_executor.layers.tilelang_ops.flash_mla_utils import convert_kv_index
+
+_POOLS={}
+# Target workload:16384 input+1024 output+2*draft5 metadata reserve.
+_MAX_POSITION_BOUND=17418
+_STATS={'captures':0,'replays':0,'metadata_checks':0,'fallbacks':{},'cache_layouts':{}}
+
+def enabled():
+    return os.environ.get('DEEPINFER_910B_INDEXER_DECODE_GRAPH')=='1'
+
+def begin_forward(metadata,sequences,draft_length,cp_size):
+    if not enabled():return
+    metadata._910b_indexer_error=None
+    metadata._910b_indexer_position_bound=None
+    if metadata.is_prompt or cp_size!=1 or not sequences:
+        return
+    # Native scheduler metadata only; never read device lengths here. Invalid
+    # metadata stays unadmitted for the existing coordinated whole-main check;
+    # this hook runs before the EP epoch and must not raise on one rank alone.
+    if type(draft_length) is not int or draft_length<0:
+        return
+    if any(type(seq.seqlen_k) is not int or type(seq.seqlen_q) is not int
+           or not 1<=seq.seqlen_q<=draft_length+1 or seq.seqlen_k<seq.seqlen_q
+           for seq in sequences):
+        return
+    # Same exclusive position_end as scheduler.hpp: main queries can grow to
+    # d+1 rows, then DFlash can append d rows after the accepted main position.
+    metadata._910b_indexer_position_bound=max(seq.seqlen_k-seq.seqlen_q for seq in sequences)+2*draft_length+1
+    metadata._910b_indexer_error=torch.zeros((),dtype=torch.bool,device=metadata.positions.device)
+
+def end_forward(metadata):
+    error=getattr(metadata,'_910b_indexer_error',None)
+    if error is not None:
+        _STATS['metadata_checks']+=1
+        # One bounded check outside the runner's forbidden-sync forward scope.
+        if bool(error.item()):
+            raise ValueError('910B indexer graph rejected invalid or unsupported metadata')
+
+def _fallback(reason):
+    from deepinfer.npu_ops.whole_main_context910b import active
+    if active():raise RuntimeError('Whole-main indexer cannot fall back: '+reason)
+    values=_STATS['fallbacks'];values[reason]=values.get(reason,0)+1
+    return None
+
+def _execute(owner,cache,bound,q,weights,lengths,tables,active,blocks):
+    # The real producer returns BF16; original decoders multiply in FP32.
+    weights=weights.float()
+    if owner.use_candidate_topk:
+        bs=owner._910b_candidate_block_size
+        invalid=active & ((lengths<0)|(lengths>bound)|(lengths>owner.max_kv_len))
+        prepared=prepare(q,cache,blocks,lengths,tables,bs,(bound+cache.shape[1]-1)//cache.shape[1],q.shape[0]*bound+19,active & ~invalid)
+        prepared=prepared._replace(metadata_error=prepared.metadata_error|invalid)
+        result=reduce_runs(grouped_dots(prepared),weights,prepared,blocks.shape[1]*bs)
+        ends=prepared.row_ends
+    else:
+        result=dense_scores(q,cache,weights,lengths,tables,active,bound,owner.max_kv_len)
+        ends=lengths.to(torch.int32)
+    ends=ends.masked_fill(~active|result.metadata_error,0)
+    source=torch.empty((q.shape[0],0),device=q.device,dtype=torch.int32)
+    if owner.is_candidate_topk_source:
+        block_scores,valid_blocks=candidate_block_max(result.bf16,ends,owner.candidate_topk_cfg.block_size)
+        source=topk(block_scores,owner.candidate_topk_cfg.topk_block,end=valid_blocks,sorted=False,
+                    sorted_index=True,indices_type=torch.int32,return_value=False)[1]
+    indices=topk(result.bf16,owner.topk_tokens,end=ends,sorted=False,sorted_index=True,
+                 indices_type=torch.int32,return_value=False)[1]
+    if owner.use_candidate_topk:
+        restore_candidate_indices_inplace(indices,blocks,owner._910b_candidate_block_size)
+    convert_kv_index(indices.unsqueeze(1),cache.shape[1],ends.unsqueeze(1),tables)
+    return indices,result.metadata_error,source
+
+def _execute_whole_q12(owner, cache, bound, inputs):
+    # All inputs are row-aligned. Each native invocation stays within the
+    # original r952 Q<=6 limit, including its fixed-size UB allocation.
+    rows = inputs[0].shape[0]
+    if not 1 <= rows <= 12 or any(value.shape[0] != rows for value in inputs):
+        raise ValueError('Whole-main indexer requires aligned Q1..12 inputs')
+    chunks = []
+    for start in range(0, rows, 6):
+        parts = (value[start:start + 6].contiguous().clone() for value in inputs)
+        chunks.append(_execute(owner, cache, bound, *parts))
+    if len(chunks) == 1:
+        return chunks[0]
+    return tuple(torch.cat(values, dim=0) for values in zip(*chunks))
+
+def maybe_decode(owner,q,weights,cache,metadata,runtime):
+    if not enabled():return None
+    from deepinfer.npu_ops.whole_main_context910b import active as whole_active
+    in_whole=whole_active()
+    if metadata.is_prompt or not 1<=q.shape[0]<=(12 if in_whole else 6):return _fallback('query_scope')
+    position_bound=getattr(metadata,'_910b_indexer_position_bound',None)
+    if position_bound is None:return _fallback('missing_host_bound')
+    required=min(owner.max_kv_len,(position_bound+owner.kv_compress_ratio-1)//owner.kv_compress_ratio)
+    # Host-only ratio-aware shape bound; no device scalar read.
+    bound=min(owner.max_kv_len,(_MAX_POSITION_BOUND+owner.kv_compress_ratio-1)//owner.kv_compress_ratio)
+    if required>bound:return _fallback('key_bound_not_admitted')
+    if cache.ndim==4 and cache.shape[-2]==1:cache=cache.squeeze(-2)
+    layout_key=str((tuple(cache.shape),tuple(cache.stride()),cache.storage_offset(),owner.kv_compress_ratio))
+    layout=_STATS['cache_layouts'].setdefault(layout_key,{'shape':list(cache.shape),'stride':list(cache.stride()),'storage_offset':cache.storage_offset(),'ratio':owner.kv_compress_ratio,'calls':0})
+    layout['calls']+=1
+    if cache.ndim!=3 or cache.shape[1] not in (64,128):return _fallback('cache_layout')
+    valid=getattr(metadata,'valid_token_mask',None)
+    active=torch.ones((q.shape[0],),device=q.device,dtype=torch.bool) if valid is None else valid.to(torch.bool)
+    lengths=metadata.klen[owner.ratio_key]
+    if owner.use_candidate_topk:
+        if runtime is None or runtime.block_candidate_idxs is None:raise ValueError('Missing model candidate producer')
+        size=runtime.candidate_block_size_before_compress
+        if size%owner.kv_compress_ratio:raise ValueError('Unaligned model candidate block')
+        bs=size//owner.kv_compress_ratio
+        if bs not in (8,16):return _fallback('candidate_block_size')
+        owner._910b_candidate_block_size=bs
+        blocks=runtime.block_candidate_idxs
+        if blocks.shape[1]<(bound+cache.shape[1]-1)//cache.shape[1]:return _fallback('candidate_capacity')
+    else:
+        blocks=torch.zeros((q.shape[0],1),device=q.device,dtype=torch.int32)
+    inputs=(q,weights,lengths,metadata.block_tables,active,blocks)
+    if in_whole:
+        indices,error,source=_execute_whole_q12(owner,cache,bound,inputs)
+    else:
+        key=(cache.data_ptr(),tuple(cache.shape),tuple(cache.stride()),cache.storage_offset(),bound,
+             getattr(owner,'_910b_candidate_block_size',0),tuple((tuple(x.shape),x.dtype,x.device) for x in inputs))
+        graphs=owner.__dict__.setdefault('_910b_indexer_decode_graphs',{})
+        graph=graphs.get(key)
+        if graph is None:
+            if len(graphs)>=8:return _fallback('graph_limit')
+            pool_key=(q.device,q.shape[0],bound)
+            if pool_key not in _POOLS:_POOLS[pool_key]=(torch.npu.graph_pool_handle(),torch.npu.Stream(device=q.device))
+            def function(*values):return _execute(owner,cache,bound,*values)
+            graph=FixedTensorGraph(function,inputs,_POOLS[pool_key])
+            graphs[key]=graph;_STATS['captures']+=1
+        indices,error,source=graph(*inputs)
+        _STATS['replays']+=1
+    metadata._910b_indexer_error.logical_or_(error.any())
+    if owner.is_candidate_topk_source:
+        output=runtime.block_candidate_idxs
+        if output.shape!=source.shape:raise ValueError('Candidate source output layout changed')
+        output.copy_(source)
+    return indices
+
+def decode_graph_stats():
+    return {**_STATS,'fallbacks':dict(_STATS['fallbacks']),'cache_layouts':{k:dict(v) for k,v in _STATS['cache_layouts'].items()},
+            'scope':'Experimental64/128-page model decode candidate through17418 host positions;not yet admitted,not full prefill/general/main graph/performance or HBM gain'}
diff --git a/deepinfer/npu_ops/indexer_dense_plan910b.py b/deepinfer/npu_ops/indexer_dense_plan910b.py
new file mode 100644
--- /dev/null
+++ b/deepinfer/npu_ops/indexer_dense_plan910b.py
@@ -0,0 +1,77 @@
+"""Task-local immutable CPU plans for exact dense prefill graph composition.
+
+Build before metadata transfer. A plan belongs to an explicit base/YoCo view
+and an exact query chunk; it cannot be reused for another active-row pattern.
+No component or model admission is implied by constructing a plan.
+"""
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class DensePlan:
+    starts: tuple
+    ends: tuple
+    active: tuple
+
+    def __post_init__(self):
+        if any(type(value) is not tuple for value in (self.starts, self.ends, self.active)):
+            raise ValueError("Immutable tuple metadata is required")
+        if not self.starts or not (len(self.starts) == len(self.ends) == len(self.active)):
+            raise ValueError("Nonempty query-aligned CPU metadata is required")
+        for start, end, active in zip(self.starts, self.ends, self.active):
+            if type(start) is not int or type(end) is not int or type(active) is not bool:
+                raise ValueError("Expected integer ranges and boolean validity")
+            if active and (start < 0 or end < start):
+                raise ValueError("Invalid active logical key range")
+
+    @property
+    def uniform_starts(self):
+        # Match the original dispatch, including inactive rows' starts.
+        return len(set(self.starts)) == 1
+
+    @property
+    def lengths(self):
+        return tuple(end - start if active else 0
+                     for start, end, active in zip(self.starts, self.ends, self.active))
+
+    def chunk(self, start, stop):
+        if not 0 <= start < stop <= len(self.starts):
+            raise ValueError("Invalid query chunk")
+        return DensePlan(self.starts[start:stop], self.ends[start:stop], self.active[start:stop])
+
+
+def _cpu_values(tensor):
+    if tensor.device.type != "cpu":
+        raise ValueError("Build the host plan before device transfer; never read NPU metadata")
+    return tuple(tensor.tolist())
+
+
+def prepare_cpu_views(metadata):
+    """Extract base and compact consumer plans once from original CPU tensors.
+
+    Caller must restrict this slice to CP=1, attach the returned object after
+    recursive_fn, and explicitly select the consumer view at the YoCo boundary.
+    Mask views retain the base plan. This helper does not modify metadata.
+    """
+    if not metadata.is_prompt:
+        return None
+    valid = getattr(metadata, "valid_token_mask", None)
+    active = None if valid is None else _cpu_values(valid)
+    result = {}
+    for view, starts, ends in (
+        ("base", getattr(metadata, "ks", None), getattr(metadata, "ke", None)),
+        ("consumer", getattr(metadata, "yoco_consumer_ks", None),
+         getattr(metadata, "yoco_consumer_ke", None)),
+    ):
+        if starts is None and ends is None:
+            continue
+        if starts is None or ends is None or set(starts) != set(ends):
+            raise ValueError("Mismatched ratio metadata")
+        plans = {}
+        for ratio in starts:
+            start, end = _cpu_values(starts[ratio]), _cpu_values(ends[ratio])
+            # CP=1 compact consumer metadata explicitly has no valid mask.
+            enabled = active if view == "base" and active is not None else (True,) * len(start)
+            plans[ratio] = DensePlan(start, end, enabled)
+        result[view] = plans
+    return result
diff --git a/deepinfer/npu_ops/indexer_dense_prefill_graph910b.py b/deepinfer/npu_ops/indexer_dense_prefill_graph910b.py
