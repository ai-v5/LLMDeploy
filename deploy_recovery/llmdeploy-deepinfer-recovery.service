[Unit]
Description=Recover the pinned DeepInfer container after sampled NPU idleness
After=docker.service
PartOf=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/llmdeploy-deepinfer-recovery
ExecStart=/usr/bin/python3 -B -m deploy_recovery.deepinfer --config /etc/llmdeploy-deepinfer-recovery.json
Restart=always
RestartSec=60
TimeoutStopSec=25

[Install]
WantedBy=multi-user.target docker.service
